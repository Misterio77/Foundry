@@ -0,0 +1,52 @@
+"""Minimal DAV directory, reachable only through the authenticated nginx gateway."""
+
+from collections import Counter
+from urllib.parse import unquote
+
+from django.http import HttpResponseForbidden, JsonResponse
+from django.views.decorators.cache import never_cache
+from django.views.decorators.http import require_GET
+
+from authentik.core.models import Application, User, UserTypes
+
+
+def principal_for(user):
+    principal = user.attributes.get("dav_principal", str(user.uuid))
+    if (not isinstance(principal, str) or not principal or principal in (".", "..")
+            or principal.startswith("@")
+            or any(c in principal for c in "/\\:{}")
+            or any(ord(c) < 32 or ord(c) == 127 for c in principal)):
+        return None
+    return principal
+
+
+@never_cache
+@require_GET
+def dav_users(request):
+    # Public Authentik ingress strips this marker and blocks this route entirely.
+    if request.META.get("HTTP_X_FOUNDRY_DAV_DIRECTORY") != "1":
+        return HttpResponseForbidden()
+    username = unquote(request.META.get("HTTP_X_FOUNDRY_DAV_USERNAME", ""))
+    principal = request.META.get("HTTP_X_FOUNDRY_DAV_PRINCIPAL", "")
+    if not username or not principal:
+        return HttpResponseForbidden()
+    people = User.objects.filter(
+        is_active=True, type__in=[UserTypes.INTERNAL, UserTypes.EXTERNAL]
+    )
+    caller = people.filter(username=username).first()
+    app = Application.objects.filter(slug="radicale").first()
+    if (not caller or not app or principal_for(caller) != principal
+            or not caller.app_entitlements(app).filter(name="access").exists()):
+        return HttpResponseForbidden()
+
+    # Fail rather than silently offering an incomplete directory.
+    candidates = list(people.order_by("username")[:501])
+    if len(candidates) > 500:
+        return JsonResponse({"error": "DAV directory is too large"}, status=503)
+    recipients = []
+    for user in candidates:
+        target = principal_for(user)
+        if target and user.app_entitlements(app).filter(name="access").exists():
+            recipients.append({"username": user.username, "principal": target})
+    counts = Counter(row["principal"] for row in recipients)
+    return JsonResponse({"users": [row for row in recipients if counts[row["principal"]] == 1]})
