diff --git a/pkg/services/user/avatar.go b/pkg/services/user/avatar.go
new file mode 100644
--- /dev/null
+++ b/pkg/services/user/avatar.go
@@ -0,0 +1,18 @@
+package user
+
+import (
+	"net/url"
+	"strings"
+)
+
+func NormalizeAvatarURL(picture string) string {
+	picture = strings.TrimSpace(picture)
+	if len(picture) > 2048 {
+		return ""
+	}
+	u, err := url.Parse(picture)
+	if err != nil || u.Scheme != "https" || u.Hostname() == "" || u.User != nil {
+		return ""
+	}
+	return u.String()
+}
