diff --git a/pkg/services/user/userimpl/oidc_picture_test.go b/pkg/services/user/userimpl/oidc_picture_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/services/user/userimpl/oidc_picture_test.go
@@ -0,0 +1,34 @@
+package userimpl
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/grafana/grafana/pkg/infra/db"
+	"github.com/grafana/grafana/pkg/services/user"
+	"github.com/grafana/grafana/pkg/setting"
+	"github.com/grafana/grafana/pkg/storage/legacysql"
+)
+
+func TestIntegrationOIDCPicturePersistence(t *testing.T) {
+	store := ProvideStore(legacysql.NewDatabaseProvider(db.InitTestDB(t)), setting.NewCfg())
+	ctx := context.Background()
+	usr := &user.User{Login: "picture", Email: "picture@example.com", AvatarURL: "https://images.example/first.png", Created: time.Now(), Updated: time.Now()}
+	id, err := store.Insert(ctx, usr)
+	require.NoError(t, err)
+	for _, picture := range []string{usr.AvatarURL, "https://images.example/second.png", ""} {
+		require.NoError(t, store.Update(ctx, &user.UpdateUserCommand{UserID: id, AvatarURL: &picture}))
+		stored, err := store.GetByID(ctx, id)
+		require.NoError(t, err)
+		require.Equal(t, picture, stored.AvatarURL)
+		profile, err := store.GetProfile(ctx, &user.GetUserProfileQuery{UserID: id})
+		require.NoError(t, err)
+		require.Equal(t, picture, profile.AvatarURL)
+		signedIn, err := store.GetSignedInUser(ctx, &user.GetSignedInUserQuery{UserID: id})
+		require.NoError(t, err)
+		require.Equal(t, picture, signedIn.AvatarURL)
+	}
+}
