new file mode 100644
--- /dev/null
+++ b/pkg/api/dtos/oidc_picture_test.go
@@ -0,0 +1,24 @@
+package dtos
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/grafana/grafana/pkg/setting"
+)
+
+func TestUserAvatarURL(t *testing.T) {
+	for _, disabled := range []bool{false, true} {
+		cfg := setting.NewCfg()
+		cfg.DisableGravatar = disabled
+		cfg.AppSubURL = "/grafana"
+		const email = "alice@example.com"
+		const picture = "https://images.example/alice.png?size=200"
+		require.Equal(t, picture, GetUserAvatarURL(cfg, email, " "+picture+" "))
+		for _, invalid := range []string{"", "http://example.com/a.png", "javascript:alert(1)", "//example.com/a.png", "https:///a.png", "https://user:secret@example.com/a.png", "https://example.com/" + strings.Repeat("a", 2048)} {
+			require.Equal(t, GetGravatarUrl(cfg, email), GetUserAvatarURL(cfg, email, invalid))
+		}
+	}
+}
