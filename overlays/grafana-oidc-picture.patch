@@ -0,0 +1,36 @@
+package connectors
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/grafana/grafana/pkg/infra/log"
+	"github.com/grafana/grafana/pkg/login/social"
+)
+
+func TestGenericOAuthPicture(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		claims []any
+		want   string
+	}{
+		{"id token preferred", []any{"https://images.example/id.png", "https://images.example/userinfo.png"}, "https://images.example/id.png"},
+		{"userinfo fallback", []any{nil, "https://images.example/userinfo.png"}, "https://images.example/userinfo.png"},
+		{"invalid claim ignored", []any{42, "https://images.example/userinfo.png"}, "https://images.example/userinfo.png"},
+		{"http rejected", []any{"http://images.example/a.png"}, ""},
+		{"relative rejected", []any{"/static/avatar.png"}, ""},
+		{"data rejected", []any{"data:image/png;base64,abc"}, ""},
+		{"credentials rejected", []any{"https://user:secret@images.example/a.png"}, ""},
+		{"missing", []any{nil}, ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			connector := &SocialGenericOAuth{}
+			info := &social.BasicUserInfo{Id: "alice", Name: "Alice", Email: "alice@example.com", Login: "alice"}
+			for _, picture := range tc.claims {
+				connector.extractBasicUserFields(log.NewNopLogger(), info, &UserInfoJson{Picture: picture})
+			}
+			require.Equal(t, tc.want, info.AvatarURL)
+		})
+	}
+}
