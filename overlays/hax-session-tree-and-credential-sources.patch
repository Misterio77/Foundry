+}
+
+static void test_tree_navigation_failure_leaves_history_unchanged(void)
+{
+    set_state_dir();
+    struct fixture f;
+    fixture_init(&f);
+    add_turn(&f.session, "first", "first reply");
+    struct navigation_call call = {.state = &f.state, .position = 0};
