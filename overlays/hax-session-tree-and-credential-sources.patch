+static void test_navigation_round_trip_and_append(void)
+{
+    setenv("XDG_STATE_HOME", t_tempdir(), 1);
+    struct session_log *log = session_log_open("pa", "ma", NULL, NULL, NULL);
+    struct item original[] = {
+        {.kind = ITEM_TURN_BOUNDARY},
+        {.kind = ITEM_USER_MESSAGE, .text = "first"},
+        {.kind = ITEM_ASSISTANT_MESSAGE, .text = "first reply"},
+        {.kind = ITEM_TURN_BOUNDARY},
+        {.kind = ITEM_USER_MESSAGE, .text = "original"},
+        {.kind = ITEM_ASSISTANT_MESSAGE, .text = "original reply"},
+    };
+    session_log_append(log, original, 6);
+    session_log_user_turn(log, 100);
+    char *path = xstrdup(session_log_path(log));
+    struct session_loaded loaded;
+    EXPECT(session_load_all(path, &loaded) == 0);
+    EXPECT(loaded.n_tree == 2);
+    size_t before_second = loaded.tree[1].position;
+    size_t original_tip = loaded.tree[1].after_position;
+    session_loaded_free(&loaded);
+
+    EXPECT(session_load_at(path, before_second, &loaded) == 0);
+    EXPECT(loaded.n_items == 3);
+    EXPECT(loaded.n_retired == 3);
+    EXPECT(session_log_navigate(log, before_second, loaded.n_items) == 0);
+    session_loaded_free(&loaded);
+
+    struct item alternative[] = {
+        original[0],
+        original[1],
+        original[2],
+        {.kind = ITEM_TURN_BOUNDARY},
+        {.kind = ITEM_USER_MESSAGE, .text = "alternative"},
+        {.kind = ITEM_ASSISTANT_MESSAGE, .text = "alternative reply"},
+    };
+    session_log_set_meta(log, "pb", "mb", NULL, "high", NULL);
+    session_log_append(log, alternative, 6);
+    session_log_user_turn(log, 30);
+    EXPECT(session_load_all(path, &loaded) == 0);
+    EXPECT(loaded.n_items == 6);
+    EXPECT(loaded.n_retired == 3);
+    EXPECT(loaded.n_tree == 3);
+    EXPECT_STR_EQ(loaded.items[4].text, "alternative");
+    EXPECT(loaded.worked_ms == 130);
+    session_loaded_free(&loaded);
+
+    EXPECT(session_load_at(path, original_tip, &loaded) == 0);
+    EXPECT_STR_EQ(loaded.items[4].text, "original");
+    EXPECT_STR_EQ(loaded.meta.model, "mb");
+    EXPECT(session_log_navigate(log, original_tip, loaded.n_items) == 0);
+    session_loaded_free(&loaded);
+    session_log_close(log);
+
+    EXPECT(session_load_all(path, &loaded) == 0);
+    EXPECT(loaded.n_items == 6);
+    EXPECT(loaded.n_retired == 3);
+    EXPECT_STR_EQ(loaded.items[4].text, "original");
+    EXPECT(loaded.worked_ms == 130);
+    log = session_log_resume(path, "pb", "mb", "high", NULL, loaded.n_items);
+    session_loaded_free(&loaded);
+    struct item continued[] = {
+        original[0],
+        original[1],
+        original[2],
+        original[3],
+        original[4],
+        original[5],
+        {.kind = ITEM_ASSISTANT_MESSAGE, .text = "continued original"},
+    };
+    session_log_append(log, continued, 7);
+    session_log_close(log);
+    EXPECT(session_load_all(path, &loaded) == 0);
+    EXPECT(loaded.n_items == 7);
+    EXPECT(loaded.n_retired == 3);
+    EXPECT_STR_EQ(loaded.items[6].text, "continued original");
+    session_loaded_free(&loaded);
+    EXPECT(session_load_at(path, 99999, &loaded) == -1);
+    EXPECT(loaded.items == NULL);
+    EXPECT(loaded.tree == NULL);
+    session_loaded_free(&loaded);
+    free(path);
+}
+
+static void test_navigation_uses_physical_records_and_repairs_tools(void)
+{
+    char *path = xasprintf("%s/session.jsonl", t_tempdir());
+    FILE *file = fopen(path, "w");
+    EXPECT(file != NULL);
+    if (!file) {
+        free(path);
+        return;
+    }
+    fputs("{\"type\":\"session\",\"version\":1}\n"
+          "{\"kind\":\"user\",\"text\":\"original\"}\n"
+          "torn record\n"
+          "\n"
+          "{\"kind\":\"tool_call\",\"call_id\":\"dangling\"}\n"
+          "{\"type\":\"navigate\",\"position\":0}\n"
+          "{\"kind\":\"user\",\"text\":\"alternative\"}\n"
+          "{\"kind\":\"assistant\",\"text\":\"alternative reply\"}\n"
+          "{\"type\":\"navigate\",\"position\":5}\n",
+          file);
+    fclose(file);
+    struct session_loaded loaded;
+    EXPECT(session_load_all(path, &loaded) == 0);
+    EXPECT(loaded.n_items == 1);
+    EXPECT_STR_EQ(loaded.items[0].text, "original");
+    EXPECT(loaded.n_retired == 2);
+    EXPECT(loaded.n_tree == 2);
+    session_loaded_free(&loaded);
+    free(path);
+}
+
+static void test_invalid_navigation_and_future_formats_fail_closed(void)
+{
+    const char *records[] = {
+        "{\"type\":\"session\",\"version\":999}\n",
+        "{\"type\":\"session\",\"version\":1}\n"
+        "{\"kind\":\"user\",\"text\":\"prompt\"}\n"
+        "{\"type\":\"navigate\",\"version\":999,\"position\":0}\n",
+        "{\"kind\":\"user\",\"text\":\"prompt\"}\n"
+        "{\"type\":\"navigate\",\"position\":999}\n",
+        "{\"kind\":\"user\",\"text\":\"prompt\"}\n"
+        "{\"type\":\"navigate\",\"position\":-1}\n",
+        "{\"kind\":\"user\",\"text\":\"prompt\"}\n"
+        "{\"type\":\"navigate\"}\n",
+    };
+    char *path = xasprintf("%s/session.jsonl", t_tempdir());
+    for (size_t i = 0; i < sizeof(records) / sizeof(records[0]); i++) {
+        FILE *file = fopen(path, "w");
+        EXPECT(file != NULL);
+        if (!file)
+            break;
+        fputs(records[i], file);
+        fclose(file);
+        struct session_loaded loaded;
+        EXPECT(session_load_all(path, &loaded) == -1);
+        EXPECT(loaded.items == NULL);
+        EXPECT(loaded.tree == NULL);
+        session_loaded_free(&loaded);
+        if (i < 2) {
+            struct session_meta meta;
+            EXPECT(session_read_meta(path, &meta) == -1);
+            EXPECT(meta.model == NULL);
+            session_meta_free(&meta);
+        }
+    }
+    free(path);
+}
+
 int main(void)
 {
     /* Outside any repository, so recorded sessions neither run git nor depend on the checkout. */
     EXPECT(chdir(t_tempdir()) == 0);
+    test_invalid_navigation_and_future_formats_fail_closed();
+    test_navigation_round_trip_and_append();
+    test_navigation_uses_physical_records_and_repairs_tools();
     test_item_codec_round_trip();
     test_recording_control();
     test_session_round_trip();
diff --git a/tests/test_session_tree.c b/tests/test_session_tree.c
new file mode 100644
index 0000000000..3ab673ba32
--- /dev/null
+++ b/tests/test_session_tree.c
@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: MIT */
+#include <stddef.h>
+#include <stdint.h>
+
+#include "harness.h"
+#include "provider.h"
+#include "session.h"
+#include "session_tree.h"
+#include "xalloc.h"
+
+static void append(struct session_tree *tree, size_t id, enum item_kind kind, const char *text)
+{
+    session_tree_append(tree, id, (struct item){.kind = kind, .text = xstrdup(text)});
+}
+
+static void add_exchange(struct session_tree *tree, size_t id, const char *prompt)
+{
+    append(tree, id, ITEM_TURN_BOUNDARY, NULL);
+    append(tree, id + 1, ITEM_USER_MESSAGE, prompt);
+    append(tree, id + 2, ITEM_ASSISTANT_MESSAGE, "reply");
+}
+
+static void test_linear_turn_boundaries(void)
+{
+    struct session_tree tree = {0};
+    add_exchange(&tree, 2, "first");
+    add_exchange(&tree, 7, "second");
+    struct session_loaded loaded = {0};
+    session_tree_export(&tree, &loaded);
+    EXPECT(loaded.n_items == 6);
+    EXPECT(loaded.n_retired == 0);
+    EXPECT(loaded.n_tree == 2);
+    EXPECT(loaded.tree[0].position == 0);
+    EXPECT(loaded.tree[0].parent == SIZE_MAX);
+    EXPECT(loaded.tree[1].position == 4);
+    EXPECT(loaded.tree[1].parent == 0);
+    EXPECT(loaded.tree[0].after_position == 4);
+    EXPECT(loaded.tree[1].after_position == 9);
+    EXPECT(!loaded.tree[0].current);
+    EXPECT(loaded.tree[1].current);
+    session_loaded_free(&loaded);
+    session_tree_free(&tree);
+}
+
+static void test_undo_preserves_sibling_and_can_restore_it(void)
+{
+    struct session_tree tree = {0};
+    add_exchange(&tree, 2, "first");
+    add_exchange(&tree, 5, "original");
+    session_tree_undo(&tree, 1);
+    EXPECT(tree.position == 4);
+    add_exchange(&tree, 11, "alternative");
+    EXPECT(session_tree_navigate(&tree, 7) == 0);
+    struct session_loaded loaded = {0};
+    session_tree_export(&tree, &loaded);
+    EXPECT(loaded.n_items == 6);
+    EXPECT(loaded.n_retired == 3);
+    EXPECT_STR_EQ(loaded.items[4].text, "original");
+    EXPECT_STR_EQ(loaded.retired[1].text, "alternative");
+    EXPECT(loaded.n_tree == 3);
+    EXPECT(loaded.tree[1].parent == 0);
+    EXPECT(loaded.tree[2].parent == 0);
+    EXPECT(loaded.tree[1].current);
+    EXPECT(!loaded.tree[2].current);
+    EXPECT(!loaded.tree[0].current);
+    EXPECT(loaded.tree[1].after_position == 7);
+    EXPECT(loaded.tree[2].after_position == 13);
+    session_loaded_free(&loaded);
+    session_tree_free(&tree);
+}
+
+static void test_root_branches_and_invalid_positions(void)
+{
+    struct session_tree tree = {0};
+    add_exchange(&tree, 3, "original root");
+    EXPECT(session_tree_navigate(&tree, 0) == 0);
+    add_exchange(&tree, 20, "alternative root");
+    EXPECT(session_tree_navigate(&tree, 999) == -1);
+    EXPECT(tree.position == 22);
+    EXPECT(session_tree_navigate(&tree, 4) == 0);
+    struct session_loaded loaded = {0};
+    session_tree_export(&tree, &loaded);
+    EXPECT(loaded.n_items == 2);
+    EXPECT(loaded.n_retired == 4);
+    EXPECT(loaded.tree[0].parent == SIZE_MAX);
+    EXPECT(loaded.tree[1].parent == SIZE_MAX);
+    EXPECT(loaded.tree[0].current);
+    EXPECT(!loaded.tree[1].current);
+    session_loaded_free(&loaded);
+    session_tree_free(&tree);
+}
+
+static void test_compaction_and_continuation_follow_ancestry(void)
+{
+    struct session_tree tree = {0};
+    add_exchange(&tree, 2, "first");
+    session_tree_append(&tree, 8,
+                        (struct item){.kind = ITEM_USER_MESSAGE,
+                                      .text = xstrdup("summary of first branch"),
+                                      .origin = ITEM_ORIGIN_COMPACT_SEED});
+    add_exchange(&tree, 9, "second");
+    session_tree_append(&tree, 12,
+                        (struct item){.kind = ITEM_USER_MESSAGE,
+                                      .text = xstrdup("continue"),
+                                      .origin = ITEM_ORIGIN_CONTINUATION});
+    session_tree_undo(&tree, 1);
+    EXPECT(tree.position == 8);
+    EXPECT(session_tree_navigate(&tree, 4) == 0);
+    add_exchange(&tree, 20, "without summary");
+    struct session_loaded loaded = {0};
+    session_tree_export(&tree, &loaded);
+    EXPECT(loaded.n_items == 6);
+    EXPECT(items_context_floor(loaded.items, loaded.n_items) == 0);
+    EXPECT(loaded.n_tree == 3);
+    EXPECT_STR_EQ(loaded.tree[1].prompt, "second");
+    EXPECT(loaded.tree[1].position == 8);
+    EXPECT(loaded.tree[0].after_position == 4);
+    EXPECT(loaded.tree[1].after_position == 12);
+    EXPECT_STR_EQ(loaded.tree[2].prompt, "without summary");
+    session_loaded_free(&loaded);
+    session_tree_free(&tree);
+}
+
+static void test_repeated_navigation_does_not_duplicate_items(void)
+{
+    struct session_tree tree = {0};
+    add_exchange(&tree, 2, "first");
+    add_exchange(&tree, 5, "second");
+    for (size_t i = 0; i < 100; i++) {
+        EXPECT(session_tree_navigate(&tree, 4) == 0);
+        EXPECT(session_tree_navigate(&tree, 7) == 0);
+    }
+    session_tree_undo(&tree, 0);
+    EXPECT(tree.position == 0);
+    session_tree_undo(&tree, 99);
+    EXPECT(tree.position == 0);
+    struct session_loaded loaded = {0};
+    session_tree_export(&tree, &loaded);
+    EXPECT(loaded.n_items == 0);
+    EXPECT(loaded.n_retired == 6);
+    session_loaded_free(&loaded);
+    session_tree_free(&tree);
+}
+
+static void test_empty_tree(void)
+{
+    struct session_tree tree = {0};
+    struct session_loaded loaded = {0};
+    EXPECT(session_tree_navigate(&tree, 0) == 0);
+    EXPECT(session_tree_navigate(&tree, 1) == -1);
+    session_tree_export(&tree, &loaded);
+    EXPECT(loaded.n_items == 0);
+    EXPECT(loaded.n_tree == 0);
+    session_loaded_free(&loaded);
+    session_tree_free(&tree);
+}
+
+int main(void)
+{
+    test_linear_turn_boundaries();
+    test_undo_preserves_sibling_and_can_restore_it();
+    test_root_branches_and_invalid_positions();
+    test_compaction_and_continuation_follow_ancestry();
+    test_repeated_navigation_does_not_duplicate_items();
+    test_empty_tree();
+    T_REPORT();
+}
