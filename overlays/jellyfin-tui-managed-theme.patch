+#[cfg(test)]
+mod config_watcher_tests {
+    use super::*;
+    use std::fs;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    struct TestDir(PathBuf);
+
+    impl TestDir {
+        fn new() -> Self {
+            static NEXT: AtomicUsize = AtomicUsize::new(0);
+            let path = std::env::temp_dir().join(format!(
+                "jellyfin-theme-{}-{}",
+                std::process::id(),
+                NEXT.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&path).unwrap();
+            Self(path)
+        }
+    }
+
+    impl Drop for TestDir {
+        fn drop(&mut self) {
+            fs::remove_dir_all(&self.0).unwrap();
+        }
+    }
+
+    #[test]
+    fn detects_edits_before_first_poll_and_preserves_state_when_missing() {
+        let dir = TestDir::new();
+        let path = dir.0.join("config.yaml");
+        fs::write(&path, "theme: Dark").unwrap();
+        let mut watcher = ConfigWatcher::new(&path, Duration::ZERO);
+        assert!(!watcher.poll());
+        fs::write(&path, "theme: Light").unwrap();
+        assert!(watcher.poll());
+        assert!(!watcher.poll());
+        fs::remove_file(&path).unwrap();
+        assert!(!watcher.poll());
+        fs::write(&path, "theme: Light").unwrap();
+        assert!(!watcher.poll());
+        fs::write(&path, "theme: Dark").unwrap();
+        assert!(watcher.poll());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn detects_symlink_switch_with_identical_mtimes() {
+        use std::os::unix::fs::symlink;
+
+        let dir = TestDir::new();
+        let dark = dir.0.join("dark.yaml");
+        let light = dir.0.join("light.yaml");
+        let path = dir.0.join("config.yaml");
+        for (file, contents) in [(&dark, "theme: Dark"), (&light, "theme: Light")] {
+            fs::write(file, contents).unwrap();
+            fs::File::options().write(true).open(file).unwrap()
+                .set_times(fs::FileTimes::new().set_modified(std::time::UNIX_EPOCH))
+                .unwrap();
+        }
+        symlink(&dark, &path).unwrap();
+        let mut watcher = ConfigWatcher::new(&path, Duration::ZERO);
+        assert!(!watcher.poll());
+        let replacement = dir.0.join("replacement");
+        symlink(&light, &replacement).unwrap();
+        fs::rename(&replacement, &path).unwrap();
+        assert!(watcher.poll());
+        assert!(!watcher.poll());
+    }
