+    def test_avatars_custom_shared_email(self):
+        """Users with blank or shared emails must not share username-based avatars."""
+        from authentik.lib.avatars import avatar_mode_url
+
+        mode = "https://example.com/avatar/%(username)s"
+        for email in ("", "shared@example.com"):
+            with self.subTest(email=email):
+                cache.clear()
+                self.admin.email = email
+                self.user.email = email
+                with Mocker() as mocker:
+                    for user in (self.admin, self.user):
+                        mocker.head(
+                            f"https://example.com/avatar/{user.username}",
+                            headers={"Content-Type": "image/png"},
+                        )
+                    for _ in range(2):
+                        for user in (self.admin, self.user):
+                            self.assertEqual(
+                                avatar_mode_url(user, mode),
+                                f"https://example.com/avatar/{user.username}",
+                            )
+                    self.assertEqual(mocker.call_count, 2)
+
+    def test_avatars_custom_url_change(self):
+        """Different URLs on the same hostname have independent cache entries."""
+        from authentik.lib.avatars import avatar_mode_url
+
+        cache.clear()
+        with Mocker() as mocker:
+            for suffix in ("old", "new"):
+                url = f"https://example.com/{suffix}/%(username)s"
+                expected = url.replace("%(username)s", self.user.username)
+                mocker.head(expected, headers={"Content-Type": "image/png"})
+                self.assertEqual(avatar_mode_url(self.user, url), expected)
+            self.assertEqual(mocker.call_count, 2)
+
