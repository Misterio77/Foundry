diff --git a/tests/khalendar/test_cached_events.py b/tests/khalendar/test_cached_events.py
new file mode 100644
--- /dev/null
+++ b/tests/khalendar/test_cached_events.py
@@ -0,0 +1,36 @@
+import pytz
+
+from khal.khalendar.event import Event, _parsed_events
+
+
+ICS = "\r\n".join([
+    "BEGIN:VCALENDAR",
+    "VERSION:2.0",
+    "BEGIN:VEVENT",
+    "UID:cached-event",
+    "DTSTART:20260101T100000Z",
+    "DTEND:20260101T110000Z",
+    "SUMMARY:Original",
+    "END:VEVENT",
+    "END:VCALENDAR",
+])
+
+
+def test_cached_components_are_isolated_and_keyed_by_content():
+    _parsed_events.cache_clear()
+    locale = {"local_timezone": pytz.UTC, "default_timezone": pytz.UTC}
+    first = Event.fromString(ICS, locale=locale)
+    second = Event.fromString(ICS, locale=locale)
+    first.update_summary("Edited")
+    assert second.summary == "Original"
+    assert Event.fromString(ICS, locale=locale).summary == "Original"
+    changed = ICS.replace("SUMMARY:Original", "SUMMARY:Remote edit")
+    assert Event.fromString(changed, locale=locale).summary == "Remote edit"
+    assert _parsed_events.cache_info().hits == 2
+
+
+def test_parsed_event_cache_is_bounded():
+    _parsed_events.cache_clear()
+    for number in range(150):
+        _parsed_events(ICS.replace("cached-event", f"event-{number}"))
+    assert _parsed_events.cache_info().currsize == 128
