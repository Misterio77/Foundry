+++ b/radicale/tests/test_foundry_username.py
@@ -0,0 +1,76 @@
+"""Trusted presentation names must never replace DAV storage principals."""
+
+import plistlib
+from urllib.parse import quote
+from xml.etree import ElementTree as ET
+
+import pytest
+
+from radicale.tests import BaseTest
+
+
+class TestFoundryUsername(BaseTest):
+    def setup_method(self):
+        super().setup_method()
+        self.configure({"auth": {"type": "http_x_remote_user"},
+                        "rights": {"type": "owner_only"}})
+
+    @pytest.mark.parametrize("principal", [
+        "4950638e-0534-41bd-b509-a44abb0477a8", "owner@example.invalid"])
+    @pytest.mark.parametrize("username", ["gabriel", "josé & <friends> %"])
+    def test_profile_and_discovery(self, principal, username):
+        headers = {"HTTP_X_REMOTE_USER": principal,
+                   "HTTP_X_FOUNDRY_DAV_USERNAME": quote(username, safe=""),
+                   "HTTP_X_FORWARDED_HOST": "dav.m7.rs",
+                   "HTTP_X_FORWARDED_PROTO": "https",
+                   "HTTP_X_FORWARDED_PORT": "443"}
+        _, _, body = self.request("GET", "/.mobileconfig", check=200, **headers)
+        profile = plistlib.loads(body.encode() if isinstance(body, str) else body)
+        assert profile["PayloadIdentifier"] == "org.radicale.mobileconfig." + principal
+        for payload, prefix in zip(profile["PayloadContent"], ["CalDAV", "CardDAV"]):
+            assert payload[prefix + "Username"] == username
+            assert payload[prefix + "HostName"] == "dav.m7.rs"
+            assert payload[prefix + "Port"] == 443
+            assert payload[prefix + "UseSSL"] is True
+            assert payload[prefix + "PrincipalURL"] == "/"
+            assert prefix + "Password" not in payload
+
+        query = ('<propfind xmlns="DAV:"><prop><displayname/>'
+                 '<current-user-principal/></prop></propfind>')
+        for path in ["/", "/" + principal + "/"]:
+            _, _, body = self.request("PROPFIND", path, query, check=207,
+                                      HTTP_DEPTH="0", **headers)
+            xml = ET.fromstring(body)
+            assert xml.findtext(".//{DAV:}displayname") == username
+            assert xml.findtext(".//{DAV:}current-user-principal/{DAV:}href") == "/" + quote(principal, safe="/") + "/"
+        self.request("PROPFIND", "/" + principal + "/", check=403,
+                     HTTP_X_REMOTE_USER="unrelated-user",
+                     HTTP_X_FOUNDRY_DAV_USERNAME=quote(username, safe=""))
+
+        collection = "/" + principal + "/calendar/"
+        self.request("MKCALENDAR", collection, check=201, **headers)
+        self.request("PROPPATCH", collection,
+                     '<propertyupdate xmlns="DAV:"><set><prop><displayname>'
+                     'Keep calendar title</displayname></prop></set></propertyupdate>',
+                     check=207, **headers)
+        _, _, body = self.request("PROPFIND", collection, query, check=207,
+                                  HTTP_DEPTH="0", **headers)
+        assert ET.fromstring(body).findtext(".//{DAV:}displayname") == "Keep calendar title"
+
+    def test_header_is_not_authentication(self):
+        self.request("GET", "/.mobileconfig", check=403,
+                     HTTP_X_FOUNDRY_DAV_USERNAME="gabriel")
+
+    def test_missing_header_falls_back_to_principal(self):
+        _, _, body = self.request("GET", "/.mobileconfig", check=200,
+                                  HTTP_X_REMOTE_USER="principal")
+        profile = plistlib.loads(body.encode() if isinstance(body, str) else body)
+        assert profile["PayloadContent"][0]["CalDAVUsername"] == "principal"
+
+    def test_header_ignored_without_trusted_proxy_auth(self):
+        self.configure({"auth": {"type": "none"}})
+        _, _, body = self.request("GET", "/.mobileconfig", check=200,
+                                  login="realuser:",
+                                  HTTP_X_FOUNDRY_DAV_USERNAME="forged")
+        profile = plistlib.loads(body.encode() if isinstance(body, str) else body)
+        assert profile["PayloadContent"][0]["CalDAVUsername"] == "realuser"
