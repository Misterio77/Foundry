+function renew_browser_session(status) {
+    if (status === 401) {
+        window.location.replace('/outpost.goauthentik.io/start?rd=' +
+            encodeURIComponent(window.location.origin + '/.web/'));
+    }
+}
+
+export async function browser_fetch(url, options = {}) {
+    const headers = new Headers(options.headers);
+    headers.set('X-Radicale-Web', '1');
+    const response = await fetch(url, { ...options, headers });
+    renew_browser_session(response.status);
+    return response;
+}
