+    # Signs & Songs tracks are usually tagged zxx ("no linguistic content"), but plenty of
+    # release groups tag them with a real language and only say so in the title.
+    NON_DIALOGUE_TITLE = re.compile(r'\b(signs?|songs?)\b', re.IGNORECASE)
+
+    @classmethod
+    def _first_dialogue_stream(cls, video_path, ffprobe_exe):
+        """Return the relative index of the first embedded subtitles stream carrying dialogue.
+
+        ffsubsync, given no --reference-stream, keeps whichever embedded subtitles track ends
+        last. On releases carrying both a "Signs & Songs" track and a full subtitles track,
+        both end on the same shared title card, and the tie resolves to the first stream --
+        the signs one, which holds no dialogue to align against. Forced tracks are too sparse
+        to align against either, so skip both kinds.
+        """
+        try:
+            output = subprocess.check_output(
+                [ffprobe_exe, '-v', 'error', '-select_streams', 's', '-show_entries',
+                 'stream_tags=language,title:stream_disposition=forced', '-of', 'json',
+                 video_path], stderr=subprocess.DEVNULL)
+            streams = json.loads(output).get('streams', [])
+        except Exception:
+            logging.exception('BAZARR unable to probe subtitles streams of %s', video_path)
+            return None
+
+        for relative_index, stream in enumerate(streams):
+            tags = stream.get('tags') or {}
+            if tags.get('language') == 'zxx':
+                continue
+            if (stream.get('disposition') or {}).get('forced'):
+                continue
+            if cls.NON_DIALOGUE_TITLE.search(tags.get('title') or ''):
+                continue
+            return relative_index
+
+        logging.debug('BAZARR no embedded subtitles stream of %s carries dialogue', video_path)
+        return None
+
