+"""Read-only Authentik API adapter; directory data never authorizes DAV writes."""
+
+import json
+import time
+from collections import Counter
+from urllib.parse import urlencode, urlsplit
+from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener
+
+
+class Unavailable(Exception):
+    pass
+
+
+class Forbidden(Exception):
+    pass
+
+
+class NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def principal_for(user):
+    attributes = user.get("attributes")
+    if not isinstance(attributes, dict):
+        return None
+    principal = attributes.get("dav_principal", user.get("uuid"))
+    if (not isinstance(principal, str) or not principal or principal in (".", "..")
+            or principal.startswith("@") or any(c in principal for c in "/\\:{}")
+            or any(ord(c) < 32 or ord(c) == 127 for c in principal)):
+        return None
+    return principal
+
+
+class Directory:
+    def __init__(self, api_url, token):
+        parsed = urlsplit(api_url)
+        if (parsed.scheme != "https" or not parsed.netloc or parsed.username
+                or parsed.password or parsed.query or parsed.fragment
+                or not api_url.endswith("/") or not token
+                or any(c.isspace() or not 33 <= ord(c) <= 126 for c in token)):
+            raise Unavailable()
+        self.api_url = api_url
+        self.token = token
+        self.deadline = time.monotonic() + 8
+        self.opener = build_opener(ProxyHandler({}), NoRedirect())
+
+    def get(self, path, **params):
+        remaining = self.deadline - time.monotonic()
+        if remaining <= 0:
+            raise Unavailable()
+        request = Request(self.api_url + path + "?" + urlencode(params, doseq=True),
+                          headers={"Authorization": "Bearer " + self.token,
+                                   "Accept": "application/json"})
+        try:
+            with self.opener.open(request, timeout=min(3, remaining)) as response:
+                chunks = []
+                size = 0
+                while chunk := response.read(65536):
+                    size += len(chunk)
+                    if size > 2 * 1024 * 1024 or time.monotonic() > self.deadline:
+                        raise Unavailable()
+                    chunks.append(chunk)
+                data = json.loads(b"".join(chunks))
+            if not isinstance(data, dict):
+                raise Unavailable()
+            return data
+        except (OSError, ValueError):
+            # Neither upstream bodies nor credentials belong in errors or logs.
+            raise Unavailable() from None
+
+    def listing(self, path, **params):
+        rows = []
+        page = 1
+        while page:
+            data = self.get(path, page=page, page_size=100, **params)
+            batch = data.get("results")
+            pagination = data.get("pagination")
+            if not isinstance(batch, list) or not isinstance(pagination, dict):
+                raise Unavailable()
+            following = pagination.get("next")
+            if (type(following) is not int or following < 0
+                    or (following and (following != page + 1 or not batch))):
+                raise Unavailable()
+            rows.extend(batch)
+            if len(rows) > 500:
+                raise Unavailable()
+            page = following
+        return rows
+
+    def allowed(self, user):
+        apps = self.listing("core/applications/", slug="radicale",
+                            for_user=user["pk"], only_with_launch_url="false")
+        if any(not isinstance(app, dict) or app.get("slug") != "radicale" for app in apps):
+            raise Unavailable()
+        return bool(apps)
+
+    def users(self, username, principal):
+        if not username or not principal:
+            raise Forbidden()
+        candidates = self.listing("core/users/", is_active="true",
+                                  type=["internal", "external"],
+                                  include_groups="false", include_roles="false",
+                                  ordering="username")
+        people = []
+        for user in candidates:
+            if not isinstance(user, dict):
+                raise Unavailable()
+            if user.get("is_active") is not True or user.get("type") not in ("internal", "external"):
+                continue
+            if type(user.get("pk")) is not int or not isinstance(user.get("username"), str) or not user["username"]:
+                raise Unavailable()
+            people.append(user)
+        callers = [user for user in people if user["username"] == username]
+        if (len(callers) != 1 or principal_for(callers[0]) != principal
+                or not self.allowed(callers[0])):
+            raise Forbidden()
+        recipients = []
+        for user in people:
+            target = principal_for(user)
+            if target and (user is callers[0] or self.allowed(user)):
+                recipients.append({"username": user["username"], "principal": target})
+        principals = Counter(row["principal"] for row in recipients)
+        usernames = Counter(row["username"] for row in recipients)
+        return {"users": [row for row in recipients if principals[row["principal"]] == 1
+                          and usernames[row["username"]] == 1]}
