+// Directory results are presentation data, never a replacement for DAV authorization.
+export function parseRecipients(data) {
+    if (!data || !Array.isArray(data.users) || data.users.length > 500) {
+        throw new Error("Invalid DAV directory");
+    }
+    const recipients = new Map();
+    const principals = new Set();
+    for (const row of data.users) {
+        if (!row || typeof row.username !== "string" || !row.username ||
+            typeof row.principal !== "string" || !row.principal ||
+            row.principal === "." || row.principal === ".." ||
+            /[\/\\:{}\x00-\x1f\x7f]/.test(row.principal) || row.principal.startsWith("@") ||
+            recipients.has(row.username) || principals.has(row.principal)) {
+            throw new Error("Invalid DAV directory entry");
+        }
+        recipients.set(row.username, row.principal);
+        principals.add(row.principal);
+    }
+    return recipients;
+}
