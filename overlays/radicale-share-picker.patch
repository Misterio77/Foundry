@@ -0,0 +1,53 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRecipients } from '../web/internal_data/js/utils/share_recipients.js';
+import { ErrorHandler } from '../web/internal_data/js/utils/error.js';
+globalThis.location = new URL('https://fixture.invalid/.web/');
+const { FormValidator } = await import('../web/internal_data/js/utils/form_validator.js');
+
+test('resolve exact usernames to UUIDs and overridden principals', () => {
+    const directory = parseRecipients({users: [
+        {username: 'alice', principal: '4950638e-0534-41bd-b509-a44abb0477a8'},
+        {username: 'josé & <friends>', principal: 'legacy@example.invalid'},
+        {username: '__proto__', principal: 'another-uuid'},
+    ]});
+    assert.equal(directory.get('alice'), '4950638e-0534-41bd-b509-a44abb0477a8');
+    assert.equal(directory.get('josé & <friends>'), 'legacy@example.invalid');
+    assert.equal(directory.get('__proto__'), 'another-uuid');
+    assert.equal(directory.get('ali'), undefined);
+    assert.equal(directory.get('ALICE'), undefined);
+    assert.equal(directory.get('legacy@example.invalid'), undefined);
+});
+
+test('only the current dialog validates; returning to a scene restores its error', () => {
+    let current = 'first';
+    const field = new EventTarget();
+    const element = {innerHTML: '', classList: {add() {}, remove() {}}};
+    const first = new FormValidator(new ErrorHandler(element), () => current === 'first');
+    first.addValidator(field, () => 'Directory unavailable');
+    const second = new FormValidator(new ErrorHandler(element), () => current === 'second');
+    second.addValidator(field, () => null);
+    current = 'second';
+    second.validate();
+    assert.equal(element.innerHTML, '');
+    current = 'first';
+    first.validate();
+    assert.equal(element.innerHTML, 'Directory unavailable');
+    field.dispatchEvent(new Event('input'));
+    assert.equal(element.innerHTML, 'Directory unavailable');
+    assert.equal(first.validate(), false);
+});
+
+test('empty directory is valid but offers no implicit raw-principal fallback', () => {
+    assert.equal(parseRecipients({users: []}).get('some-principal'), undefined);
+});
+
+test('malformed, duplicate and group/realm identities fail closed', () => {
+    for (const data of [null, {}, {users: {}}, {users: [null]}, {users: [{username: 'a'}]},
+        {users: [{username: 'a', principal: 'x'}, {username: 'a', principal: 'y'}]},
+        {users: [{username: 'a', principal: 'x'}, {username: 'b', principal: 'x'}]},
+        ...['', '..', '.', 'a/b', 'a\\b', ':group', '@realm', 'a:b', '{user}', 'a\nb'].map(principal => ({users: [{username: 'a', principal}]})),
+        {users: Array.from({length: 501}, (_, i) => ({username: String(i), principal: String(i)}))}]) {
+        assert.throws(() => parseRecipients(data));
+    }
+});
