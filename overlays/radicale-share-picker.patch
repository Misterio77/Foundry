+"""Supported API permissions, bounded lookup, and trusted-identity boundaries."""
+
+import io
+import json
+from urllib.error import HTTPError
+from urllib.parse import quote
+
+import pytest
+
+from radicale import dav_directory as directory
+from radicale.tests import BaseTest
+
+
+def user(pk, name, principal=None, **extra):
+    return {"pk": pk, "username": name, "uuid": "uuid-" + name,
+            "attributes": {} if principal is None else {"dav_principal": principal},
+            "is_active": True, "type": "internal", **extra}
+
+
+def page(rows, following=0):
+    return {"results": rows, "pagination": {"next": following}}
+
+
+def fake_api(monkeypatch, people=None, allowed=None):
+    people = people if people is not None else [user(1, "caller"), user(2, "josé", "peer@example.invalid")]
+    allowed = {1, 2} if allowed is None else allowed
+    calls = []
+
+    def get(self, path, **params):
+        calls.append((path, params))
+        if path == "core/users/":
+            assert params["is_active"] == "true"
+            assert params["type"] == ["internal", "external"]
+            return page(people)
+        assert path == "core/applications/" and params["slug"] == "radicale"
+        return page([{"slug": "radicale"}] if params["for_user"] in allowed else [])
+
+    monkeypatch.setattr(directory.Directory, "get", get)
+    return calls
+
+
+def client():
+    return directory.Directory("https://auth.example.invalid/api/v3/", "fixture-token")
+
+
+def test_minimal_identity_and_supported_access_checks(monkeypatch):
+    calls = fake_api(monkeypatch)
+    assert client().users("caller", "uuid-caller") == {"users": [
+        {"username": "caller", "principal": "uuid-caller"},
+        {"username": "josé", "principal": "peer@example.invalid"}]}
+    assert [params["for_user"] for path, params in calls if path == "core/applications/"] == [1, 2]
+
+
+@pytest.mark.parametrize("username,principal", [("", "uuid-caller"), ("caller", ""),
+                                                  ("caller", "uuid-other"), ("missing", "uuid-caller")])
+def test_caller_pairing(monkeypatch, username, principal):
+    fake_api(monkeypatch)
+    with pytest.raises(directory.Forbidden):
+        client().users(username, principal)
+
+
+def test_no_access_and_nonhuman_or_inactive_users(monkeypatch):
+    people = [user(1, "caller"), user(2, "denied"), user(3, "inactive", is_active=False),
+              user(4, "service", type="service_account"), user(5, "outpost", type="internal_service_account")]
+    fake_api(monkeypatch, people, {1, 3, 4, 5})
+    assert client().users("caller", "uuid-caller")["users"] == [{"username": "caller", "principal": "uuid-caller"}]
+    for name in ["denied", "inactive", "service", "outpost"]:
+        with pytest.raises(directory.Forbidden):
+            client().users(name, "uuid-" + name)
+
+
+@pytest.mark.parametrize("principal", ["", ".", "..", "@token", "a/b", "a\\b", "a:b", "{user}", "a\n", "a\x7f", 42])
+def test_invalid_principals(principal):
+    assert directory.principal_for(user(1, "test", principal)) is None
+
+
+def test_ambiguous_principals_omitted(monkeypatch):
+    fake_api(monkeypatch, [user(1, "caller"), user(2, "alice", "duplicate"), user(3, "bob", "duplicate")], {1, 2, 3})
+    assert len(client().users("caller", "uuid-caller")["users"]) == 1
+
+
+def test_complete_pagination(monkeypatch):
+    def get(self, path, **params):
+        return page([params["page"]], 2 if params["page"] == 1 else 0)
+    monkeypatch.setattr(directory.Directory, "get", get)
+    assert client().listing("core/users/") == [1, 2]
+
+
+@pytest.mark.parametrize("response", [page([{}] * 501), page([], 2), page([{}], 1),
+                                      page([{}], True), page([{}], -1), {}, {"results": []}])
+def test_partial_or_malformed_directory_rejected(monkeypatch, response):
+    monkeypatch.setattr(directory.Directory, "get", lambda *a, **kw: response)
+    with pytest.raises(directory.Unavailable):
+        client().listing("core/users/")
+
+
+@pytest.mark.parametrize("url", ["http://auth.invalid/", "https://user:password@auth.invalid/",
+                                "https://auth.invalid/?x=1", "https://auth.invalid/#fragment", "https://auth.invalid"])
+def test_unsafe_api_configuration(url):
+    with pytest.raises(directory.Unavailable):
+        directory.Directory(url, "token")
+
+
+def test_transport_keeps_credentials_server_side(monkeypatch):
+    instance = client()
+    def open_request(request, timeout):
+        assert request.headers["Authorization"] == "Bearer fixture-token"
+        assert request.full_url.startswith(instance.api_url + "core/users/?")
+        assert "fixture-token" not in request.full_url
+        return io.BytesIO(json.dumps(page([])).encode())
+    monkeypatch.setattr(instance.opener, "open", open_request)
+    assert instance.listing("core/users/") == []
+    assert directory.NoRedirect().redirect_request(None, None, 302, "", {}, "https://evil.invalid/") is None
+
+
+@pytest.mark.parametrize("body", [b"not json", b"[]", b"x" * (2 * 1024 * 1024 + 1)])
+def test_bad_upstream_bodies(monkeypatch, body):
+    instance = client()
+    monkeypatch.setattr(instance.opener, "open", lambda *a, **kw: io.BytesIO(body))
+    with pytest.raises(directory.Unavailable):
+        instance.get("core/users/")
+
+
+def test_upstream_error_and_deadline(monkeypatch):
+    instance = client()
+    def fail(*args, **kwargs):
+        raise HTTPError("https://auth.invalid/", 403, "private body", {}, None)
+    monkeypatch.setattr(instance.opener, "open", fail)
+    with pytest.raises(directory.Unavailable) as error:
+        instance.get("core/users/")
+    assert not str(error.value)
+    instance.deadline = 0
+    with pytest.raises(directory.Unavailable):
+        instance.get("core/users/")
+
+
+class TestDirectoryRoute(BaseTest):
+    def setup_method(self):
+        super().setup_method()
+        self.configure({"auth": {"type": "http_x_remote_user"}, "rights": {"type": "owner_only"}})
+
+    def test_route(self, monkeypatch, tmp_path):
+        token = tmp_path / "credential"
+        token.write_text("fixture-token")
+        self.configure({"web": {"authentik_api_url": "https://auth.example.invalid/api/v3/",
+                                "authentik_token_file": str(token)}})
+        fake_api(monkeypatch)
+        headers = {"HTTP_X_REMOTE_USER": "peer@example.invalid", "HTTP_X_FOUNDRY_DAV_USERNAME": quote("josé")}
+        _, response_headers, body = self.request("GET", "/.sharing-users", check=200, **headers)
+        assert response_headers["Cache-Control"] == "no-store"
+        assert len(json.loads(body)["users"]) == 2
+        assert "fixture-token" not in body and "attributes" not in body
+        self.request("GET", "/.sharing-users", check=403, HTTP_X_FOUNDRY_DAV_USERNAME="caller")
+        self.request("GET", "/.sharing-users", check=403, HTTP_X_REMOTE_USER="uuid-caller")
+        self.request("GET", "/.sharing-users", check=403, HTTP_X_REMOTE_USER="uuid-caller", HTTP_X_FOUNDRY_DAV_USERNAME="jos%C3%A9")
+        fake_api(monkeypatch, allowed={1})
+        self.request("GET", "/.sharing-users", check=403, **headers)
+        token.unlink()
+        self.request("GET", "/.sharing-users", check=503, **headers)
+        self.configure({"auth": {"type": "none"}})
+        self.request("GET", "/.sharing-users", check=403, login="caller:", HTTP_X_FOUNDRY_DAV_USERNAME="caller")
