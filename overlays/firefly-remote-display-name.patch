+    public function getRemoteDisplayNameAttribute(): string
+    {
+        if ('remote_user_guard' === config('auth.defaults.guard')) {
+            foreach (['remote_guard_display_name', 'remote_guard_alt_email'] as $key) {
+                $value = Preferences::getForUser($this, $key)?->data;
+                if (is_string($value) && '' !== trim($value)) {
+                    return $value;
+                }
+            }
+        }
+
+        return $this->email;
+    }
