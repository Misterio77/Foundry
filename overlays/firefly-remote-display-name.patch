+        // CGI-only and URL-encoded: display labels never participate in account lookup.
+        $displayHeader = config('auth.guard_display_name');
+        if (is_string($displayHeader) && '' !== $displayHeader) {
+            $encoded = request()->server($displayHeader);
+            if (is_string($encoded)) {
+                $displayName = rawurldecode($encoded);
+                if ('' !== trim($displayName) && strlen($displayName) <= 255
+                    && 1 === preg_match('//u', $displayName)
+                    && 0 === preg_match('/[\x00-\x1f\x7f]/', $displayName)) {
+                    $preference = Preferences::getForUser($retrievedUser, 'remote_guard_display_name');
+                    if (null === $preference || $displayName !== $preference->data) {
+                        Preferences::setForUser($retrievedUser, 'remote_guard_display_name', $displayName);
+                    }
+                }
+            }
+        }
+
         Log::debug(sprintf('Result of getting user from provider: %s', $retrievedUser->email));
         $this->user    = $retrievedUser;
