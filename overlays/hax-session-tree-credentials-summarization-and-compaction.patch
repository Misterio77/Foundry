diff --git a/tests/commands/test_tree.c b/tests/commands/test_tree.c
new file mode 100644
index 0000000000..685ddb4468
--- /dev/null
+++ b/tests/commands/test_tree.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: MIT */
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "harness.h"
+#include "session.h"
+#include "xalloc.h"
+#include "commands/tree.h"
+#include "terminal/picker.h"
+
+static void test_tree_connectors_and_current_position(void)
+{
+    struct session_tree_entry entries[] = {
+        {.parent = SIZE_MAX, .prompt = "repo"},    {.parent = 0, .prompt = "favorite"},
+        {.parent = 0, .prompt = "least favorite"}, {.parent = 1, .prompt = "second"},
+        {.parent = 3, .prompt = "third"},          {.parent = 2, .prompt = "worst", .current = 1},
+    };
+    struct session_loaded loaded = {.tree = entries, .n_tree = 6};
+    struct tree_view view;
+    tree_view_build(&loaded, 1, &view);
+    EXPECT(view.count == 6);
+    EXPECT_STR_EQ(view.items[0].label, "repo");
+    EXPECT_STR_EQ(view.items[1].label, "├─ favorite");
+    EXPECT_STR_EQ(view.items[2].label, "│  └─ second");
+    EXPECT_STR_EQ(view.items[3].label, "│     └─ third");
+    EXPECT_STR_EQ(view.items[4].label, "└─ least favorite");
+    EXPECT_STR_EQ(view.items[5].label, "   └─ worst");
+    EXPECT(view.initial == 5);
+    EXPECT(view.entries[2] == 3);
+    for (size_t i = 0; i < view.count; i++) {
+        EXPECT(view.items[i].detail == NULL);
+        EXPECT(view.items[i].current == (i == 5));
+    }
+    tree_view_free(&view);
+}
+
+static void test_multiple_roots_and_ascii_fallback(void)
+{
+    struct session_tree_entry entries[] = {
+        {.parent = SIZE_MAX, .prompt = "root A"},
+        {.parent = 0, .prompt = "child"},
+        {.parent = SIZE_MAX, .prompt = "root B", .current = 1},
+    };
+    struct session_loaded loaded = {.tree = entries, .n_tree = 3};
+    struct tree_view view;
+    tree_view_build(&loaded, 0, &view);
+    EXPECT_STR_EQ(view.items[0].label, "|- root A");
+    EXPECT_STR_EQ(view.items[1].label, "|  `- child");
+    EXPECT_STR_EQ(view.items[2].label, "`- root B");
+    EXPECT(view.initial == 2);
+    tree_view_free(&view);
+}
+
+static void test_empty_and_unsafe_prompt_labels(void)
+{
+    struct session_tree_entry entries[] = {
+        {.parent = SIZE_MAX, .prompt = ""},
+        {.parent = 0, .prompt = "one\ntwo\x1b[2J"},
+    };
+    struct session_loaded loaded = {.tree = entries, .n_tree = 2};
+    struct tree_view view;
+    tree_view_build(&loaded, 1, &view);
+    EXPECT_STR_EQ(view.items[0].label, "(empty prompt)");
+    EXPECT(strchr(view.items[1].label, '\n') == NULL);
+    EXPECT(strchr(view.items[1].label, '\x1b') == NULL);
+    tree_view_free(&view);
+    loaded = (struct session_loaded){0};
+    tree_view_build(&loaded, 1, &view);
+    EXPECT(view.count == 0);
+    tree_view_free(&view);
+}
+
+static void test_deep_histories_bound_indentation(void)
+{
+    size_t count = 1000;
+    struct session_tree_entry *entries = xcalloc(count, sizeof(*entries));
+    for (size_t i = 0; i < count; i++) {
+        entries[i].parent = i == 0 ? SIZE_MAX : i - 1;
+        entries[i].prompt = "turn";
+    }
+    entries[count - 1].current = 1;
+    struct session_loaded loaded = {.tree = entries, .n_tree = count};
+    struct tree_view view;
+    tree_view_build(&loaded, 0, &view);
+    EXPECT(view.count == count);
+    EXPECT(view.initial == count - 1);
+    EXPECT(strlen(view.items[count - 1].label) < 85);
+    EXPECT(strncmp(view.items[count - 1].label, "... ", 4) == 0);
+    tree_view_free(&view);
+    free(entries);
+}
+
+int main(void)
+{
+    test_tree_connectors_and_current_position();
+    test_multiple_roots_and_ascii_fallback();
+    test_empty_and_unsafe_prompt_labels();
+    test_deep_histories_bound_indentation();
+    T_REPORT();
+}
diff --git a/tests/e2e/test_repl_tree.py b/tests/e2e/test_repl_tree.py
new file mode 100644
index 0000000000..a469ddef3b
--- /dev/null
+++ b/tests/e2e/test_repl_tree.py
@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""Tree navigation edits prompts, preserves sibling branches, and changes pager context without
+replaying old output into native scrollback. A cursor-only switch survives restart."""
+
+import os
+import shlex
+
+import harness
+
+
+def test_tree_edit_return_and_resume():
+    home, workdir = harness.make_home()
+    pager = home / "pager.txt"
+    env = {"HAX_NO_SESSION": "0", "PAGER": f"cat > {shlex.quote(str(pager))}"}
+    term = harness.Terminal(
+        """
+        text FIRST_REPLY
+        end-turn
+        text ORIGINAL_REPLY
+        end-turn
+        text ALTERNATE_REPLY
+        end-turn
+        """,
+        home=home,
+        workdir=workdir,
+        extra_env=env,
+        size=(110, 44),
+    )
+    term.wait_for("❯")
+    term.type("first prompt")
+    term.send("Enter")
+    term.wait_for("FIRST_REPLY")
+    term.type("original prompt")
+    term.send("Enter")
+    term.wait_for("ORIGINAL_REPLY")
+
+    term.type("/tree")
+    term.send("Enter")
+    term.wait_for("session tree · enter")
+    term.type("original prompt")
+    term.send("M-e")
+    term.wait_for("❯ original prompt")
+    harness.expect(
+        term.screen().count("ORIGINAL_REPLY") == 1,
+        "branch switching does not replay the abandoned reply into scrollback",
+    )
+    term.send("C-u")
+    term.type("alternate prompt")
+    term.send("Enter")
+    term.wait_for("ALTERNATE_REPLY")
+
+    term.type("/tree")
+    term.send("Enter")
+    term.wait_for("session tree · enter")
+    harness.expect("original prompt" in term.screen(), "the original branch remains selectable")
+    harness.expect("alternate prompt" in term.screen(), "the new branch appears in the tree")
+    term.send("Up", "Enter")
+    term.wait_for("switched to after: original prompt")
+    term.send("C-t")
+    term.wait_for("❯")
+    context = pager.read_text()
+    harness.expect("ORIGINAL_REPLY" in context, "the restored branch is model-visible")
+    harness.expect("ALTERNATE_REPLY" not in context, "the sibling branch is not model-visible")
+
+    term.send("C-d")
+    harness.expect(term.wait_exit() == 0, "exit after switching without sending another prompt")
+    resumed = harness.Terminal(
+        "end-turn", args=["-c"], home=home, workdir=workdir, extra_env=env, size=(110, 44)
+    )
+    resumed.wait_for("ORIGINAL_REPLY")
+    resumed.send("C-o")
+    resumed.wait_for("❯")
+    history = pager.read_text()
+    harness.expect("ORIGINAL_REPLY" in history, "resume keeps the selected branch")
+    harness.expect("ALTERNATE_REPLY" not in history, "history pager shows only the active branch")
+
+    resumed.type("/tree")
+    resumed.send("Enter")
+    resumed.wait_for("session tree · enter")
+    screen = resumed.screen()
+    harness.expect("continue at branch tip" not in screen, "no synthetic tip rows")
+    harness.expect(screen.count("✓ current") == 1, "only the current turn is marked")
+    harness.expect("├─ original prompt" in screen, "the earlier sibling uses a fork connector")
+    harness.expect("└─ alternate prompt" in screen, "the last sibling closes the fork")
+    resumed.send("e")
+    resumed.wait_for("❯ original prompt")
+
+    resumed.send("C-u")
+    resumed.type("/tree")
+    resumed.send("Enter")
+    resumed.wait_for("session tree · enter")
+    resumed.type("/e")
+    resumed.wait_for("alternate prompt")
+    harness.expect("session tree · enter" in resumed.screen(), "search can start with e")
+    resumed.send("M-e")
+    resumed.wait_for("❯ alternate prompt")
+
+
+def test_tree_summarize_carries_the_abandoned_branch():
+    home, workdir = harness.make_home()
+    pager = home / "pager.txt"
+    env = {"HAX_NO_SESSION": "0", "PAGER": f"cat > {shlex.quote(str(pager))}"}
+    term = harness.Terminal(
+        """
+        text FIRST_REPLY
+        end-turn
+        text SECOND_REPLY
+        end-turn
+        text SUMMARY_BODY
+        end-turn
+        """,
+        home=home,
+        workdir=workdir,
+        extra_env=env,
+        size=(110, 44),
+    )
+    term.wait_for("❯")
+    term.type("first prompt")
+    term.send("Enter")
+    term.wait_for("FIRST_REPLY")
+    term.type("second prompt")
+    term.send("Enter")
+    term.wait_for("SECOND_REPLY")
+
+    term.type("/tree")
+    term.send("Enter")
+    term.wait_for("session tree · enter")
+    harness.expect("s summarize" in term.screen(), "the tree offers summarize and switch")
+    term.send("Up", "s")
+    term.wait_for("summarized branch left behind")
+    harness.expect("SUMMARY_BODY" not in term.screen(), "the summary itself is not echoed")
+
+    term.send("C-o")
+    term.wait_for("❯")
+    history = pager.read_text()
+    harness.expect("FIRST_REPLY" in history, "the destination keeps its own turn")
+    harness.expect("SECOND_REPLY" not in history, "the abandoned branch is not model-visible")
+    harness.expect("summarized branch left behind" in history, "the summary is carried as context")
+
+    term.send("C-d")
+    harness.expect(term.wait_exit() == 0, "exit after summarizing a branch")
+
+
+def test_escape_empty_prompt_and_escape_sequences():
+    term = harness.Terminal(
+        "text READY_REPLY\nend-turn", extra_env={"HAX_NO_SESSION": "0"}, size=(110, 32)
+    )
+    term.wait_for("❯")
+    term.type("seed prompt")
+    term.send("Enter")
+    term.wait_for("READY_REPLY")
+    term.wait_for("❯")
+    term.type("alpha beta")
+    # A harmless control key terminates any still-buffered escape sequence. The visible edit
+    # confirms processing without relying on timing sleeps before the next sequence.
+    term.send("Escape", "C-e")
+    term.type("!")
+    term.wait_for("❯ alpha beta!")
+    harness.expect("session tree · enter" not in term.screen(), "drafts block the shortcut")
+    term.send("BSpace", "Escape", "Left")
+    term.type("X")
+    term.wait_for("❯ alpha Xbeta")
+    term.send("C-e", "C-u")
+    term.send("Escape", "Up")
+    term.wait_for("❯ seed prompt")
+    harness.expect("session tree · enter" not in term.screen(), "prefixed arrow keys are preserved")
+    term.send("C-e", "C-u")
+    term.send("Escape")
+    term.wait_for("session tree · enter")
+    harness.expect("/tree" not in term.screen(), "Escape does not submit a synthetic command")
+    term.send("C-g")
+    term.type("cancelled draft")
+    term.wait_for("❯ cancelled draft")
+    harness.expect("session tree · enter" not in term.screen(), "cancelling returns to the editor")
+    term.send("C-u", "Escape")
+    term.wait_for("session tree · enter")
+    term.send("e")
+    term.wait_for("❯ seed prompt")
+
+
+def test_tree_requires_recording():
+    term = harness.Terminal("text hello\nend-turn")
+    term.wait_for("❯")
+    term.type("/tree")
+    term.send("Enter")
+    term.wait_for("/tree needs a recorded conversation")
+
+
+def test_tree_blocks_background_tasks():
+    home, workdir = harness.make_home()
+    os.mkfifo(workdir / "wait.fifo")
+    term = harness.Terminal(
+        '\n'.join([
+            'tool bash {"command":"cat wait.fifo","background":true,"name":"hold"}',
+            'end-turn',
+            'text TASK_RUNNING',
+            'end-turn',
+        ]),
+        home=home,
+        workdir=workdir,
+        extra_env={"HAX_NO_SESSION": "0"},
+    )
+    term.wait_for("❯")
+    term.type("start background work")
+    term.send("Enter")
+    term.wait_for("TASK_RUNNING")
+    term.type("/tree")
+    term.send("Enter")
+    term.wait_for("collect or stop background tasks before switching branches")
+
+
+harness.main(globals())
