diff --git a/pkg/services/auth/authimpl/oidc_logout.go b/pkg/services/auth/authimpl/oidc_logout.go
new file mode 100644
--- /dev/null
+++ b/pkg/services/auth/authimpl/oidc_logout.go
@@ -0,0 +1,80 @@
+package authimpl
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+
+	"github.com/grafana/grafana/pkg/infra/db"
+	"github.com/grafana/grafana/pkg/login/oidcbackchannel"
+	"github.com/grafana/grafana/pkg/services/auth"
+)
+
+type oidcLogout struct {
+	ID       string `xorm:"pk 'id'"`
+	Scope    string `xorm:"scope"`
+	Subject  string `xorm:"subject"`
+	Session  string `xorm:"session"`
+	IssuedAt int64  `xorm:"issued_at"`
+}
+
+func (oidcLogout) TableName() string { return "oidc_session_logout" }
+
+// RecordOIDCLogout is idempotent and monotonic: replay cannot revive a session.
+func (s *UserAuthTokenService) RecordOIDCLogout(ctx context.Context, event oidcbackchannel.Binding) error {
+	encoded, _ := json.Marshal([]string{event.Scope, event.Subject, event.Session})
+	sum := sha256.Sum256(encoded)
+	marker := oidcLogout{ID: hex.EncodeToString(sum[:]), Scope: event.Scope, Subject: event.Subject, Session: event.Session, IssuedAt: event.IssuedAt}
+	helper, err := s.sql(ctx)
+	if err != nil {
+		return err
+	}
+	return helper.DB.InTransaction(ctx, func(ctx context.Context) error {
+		return helper.DB.WithDbSession(ctx, func(sess *db.Session) error {
+			var previous oidcLogout
+			found, err := sess.Table(helper.Table(marker.TableName())).Where("id = ?", marker.ID).Get(&previous)
+			if err != nil {
+				return err
+			}
+			if found {
+				_, err = sess.Table(helper.Table(marker.TableName())).Where("id = ? AND issued_at < ?", marker.ID, marker.IssuedAt).Cols("issued_at").Update(&marker)
+			} else {
+				_, err = sess.Table(helper.Table(marker.TableName())).Insert(&marker)
+			}
+			return err
+		})
+	})
+}
+
+func (s *UserAuthTokenService) oidcSessionRevoked(ctx context.Context, externalID int64) (bool, error) {
+	if externalID == 0 {
+		return false, nil
+	}
+	helper, err := s.sql(ctx)
+	if err != nil {
+		return false, err
+	}
+	var external auth.ExternalSession
+	var revoked bool
+	err = helper.DB.WithDbSession(ctx, func(sess *db.Session) error {
+		found, err := sess.Table(helper.Table(external.TableName())).Where("id = ?", externalID).
+			Cols("oidc_scope", "oidc_subject", "oidc_session", "oidc_issued_at").Get(&external)
+		if err != nil {
+			return err
+		}
+		if !found {
+			return auth.ErrExternalSessionNotFound
+		}
+		if external.OIDCScope == "" {
+			return nil
+		}
+		var marker oidcLogout
+		revoked, err = sess.Table(helper.Table(marker.TableName())).
+			Where("scope = ? AND issued_at >= ?", external.OIDCScope, external.OIDCIssuedAt).
+			And("((session = '' AND subject = ?) OR (session <> '' AND session = ? AND (subject = '' OR subject = ?)))", external.OIDCSubject, external.OIDCSession, external.OIDCSubject).
+			Exist(&marker)
+		return err
+	})
+	return revoked, err
+}
diff --git a/pkg/services/auth/authimpl/oidc_logout_test.go b/pkg/services/auth/authimpl/oidc_logout_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/services/auth/authimpl/oidc_logout_test.go
@@ -0,0 +1,125 @@
+package authimpl
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/grafana/grafana/pkg/infra/db"
+	"github.com/grafana/grafana/pkg/login/oidcbackchannel"
+	"github.com/grafana/grafana/pkg/services/auth"
+	"github.com/grafana/grafana/pkg/services/user"
+	"github.com/grafana/grafana/pkg/util/testutil"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+)
+
+func TestIntegrationOIDCRotationAndRefresh(t *testing.T) {
+	testutil.SkipIntegrationTestInShortMode(t)
+	test := createTestContext(t)
+	ctx := context.Background()
+	service := test.tokenService
+	originalTime := getTime
+	now := time.Now()
+	getTime = func() time.Time { return now }
+	defer func() { getTime = originalTime }()
+	token, err := service.CreateToken(ctx, &auth.CreateTokenCommand{User: &user.User{ID: 10}, ExternalSession: &auth.ExternalSession{UserID: 10, AuthModule: "oauth_generic_oauth", OIDCScope: "provider", OIDCSubject: "alice", OIDCSession: "sid", OIDCIssuedAt: 100}})
+	require.NoError(t, err)
+	now = now.Add(time.Hour)
+	rotated, err := service.RotateToken(ctx, auth.RotateCommand{UnHashedToken: token.UnhashedToken})
+	require.NoError(t, err)
+	require.NotEqual(t, token.UnhashedToken, rotated.UnhashedToken)
+	require.Equal(t, token.ExternalSessionId, rotated.ExternalSessionId)
+	refreshed := (&oauth2.Token{AccessToken: "new-access", RefreshToken: "new-refresh", Expiry: now.Add(time.Hour)}).WithExtra(map[string]any{"id_token": "new-id-token"})
+	require.NoError(t, service.UpdateExternalSession(ctx, rotated.ExternalSessionId, &auth.UpdateExternalSessionCommand{Token: refreshed}))
+	ext, err := service.GetExternalSession(ctx, rotated.ExternalSessionId)
+	require.NoError(t, err)
+	require.EqualValues(t, 100, ext.OIDCIssuedAt)
+	require.Equal(t, "sid", ext.OIDCSession)
+	require.NoError(t, service.RecordOIDCLogout(ctx, oidcbackchannel.Binding{Scope: "provider", Subject: "alice", Session: "sid", IssuedAt: 110}))
+	for _, raw := range []string{token.UnhashedToken, rotated.UnhashedToken} {
+		_, err = service.LookupToken(ctx, raw)
+		require.Error(t, err)
+		_, err = service.RotateToken(ctx, auth.RotateCommand{UnHashedToken: raw})
+		require.Error(t, err)
+	}
+	// A refresh already in flight may update secrets but cannot erase revocation.
+	require.NoError(t, service.UpdateExternalSession(ctx, rotated.ExternalSessionId, &auth.UpdateExternalSessionCommand{Token: refreshed}))
+	_, err = service.LookupToken(ctx, rotated.UnhashedToken)
+	require.Error(t, err)
+}
+
+func TestIntegrationOIDCLogout(t *testing.T) {
+	testutil.SkipIntegrationTestInShortMode(t)
+	test := createTestContext(t)
+	ctx := context.Background()
+	service := test.tokenService
+	create := func(scope, subject, sid string, iat int64) (*auth.UserToken, error) {
+		return service.CreateToken(ctx, &auth.CreateTokenCommand{User: &user.User{ID: 10}, ExternalSession: &auth.ExternalSession{UserID: 10, AuthModule: "oauth_generic_oauth", OIDCScope: scope, OIDCSubject: subject, OIDCSession: sid, OIDCIssuedAt: iat}})
+	}
+	alice, err := create("provider-a", "alice", "sid-a", 100)
+	require.NoError(t, err)
+	otherSession, err := create("provider-a", "alice", "sid-b", 100)
+	require.NoError(t, err)
+	otherSubject, err := create("provider-a", "bob", "sid-a", 100)
+	require.NoError(t, err)
+	otherProvider, err := create("provider-b", "alice", "sid-a", 100)
+	require.NoError(t, err)
+	local, err := service.CreateToken(ctx, &auth.CreateTokenCommand{User: &user.User{ID: 10}})
+	require.NoError(t, err)
+	_, err = service.LookupToken(ctx, alice.UnhashedToken)
+	require.NoError(t, err)
+	event := oidcbackchannel.Binding{Scope: "provider-a", Subject: "alice", Session: "sid-a", IssuedAt: 110}
+	require.NoError(t, service.RecordOIDCLogout(ctx, event))
+	require.NoError(t, service.RecordOIDCLogout(ctx, event))
+	event.IssuedAt = 105
+	require.NoError(t, service.RecordOIDCLogout(ctx, event))
+	_, err = service.LookupToken(ctx, alice.UnhashedToken)
+	require.Error(t, err)
+	for _, token := range []*auth.UserToken{otherSession, otherSubject, otherProvider, local} {
+		_, err = service.LookupToken(ctx, token.UnhashedToken)
+		require.NoError(t, err)
+	}
+	// An in-flight callback cannot create a usable session after the event.
+	_, err = create("provider-a", "alice", "sid-a", 109)
+	require.Error(t, err)
+	_, err = create("provider-a", "alice", "sid-a", 110)
+	require.Error(t, err)
+	fresh, err := create("provider-a", "alice", "sid-a", 111)
+	require.NoError(t, err)
+	_, err = service.LookupToken(ctx, fresh.UnhashedToken)
+	require.NoError(t, err)
+	// The marker is stored in the database, not in the service instance.
+	restarted := *service
+	_, err = restarted.LookupToken(ctx, alice.UnhashedToken)
+	require.Error(t, err)
+	require.NoError(t, service.RecordOIDCLogout(ctx, oidcbackchannel.Binding{Scope: "provider-a", Session: "sid-a", IssuedAt: 120}))
+	_, err = service.LookupToken(ctx, otherSubject.UnhashedToken)
+	require.Error(t, err)
+	_, err = service.LookupToken(ctx, fresh.UnhashedToken)
+	require.Error(t, err)
+	require.NoError(t, service.RecordOIDCLogout(ctx, oidcbackchannel.Binding{Scope: "provider-a", Subject: "alice", IssuedAt: 120}))
+	_, err = service.LookupToken(ctx, otherSession.UnhashedToken)
+	require.Error(t, err)
+	_, err = service.LookupToken(ctx, otherProvider.UnhashedToken)
+	require.NoError(t, err)
+	_, err = service.LookupToken(ctx, local.UnhashedToken)
+	require.NoError(t, err)
+	helper, err := service.sql(ctx)
+	require.NoError(t, err)
+	// Hide revocation storage without poisoning the shared database for other tests.
+	require.NoError(t, helper.DB.WithDbSession(ctx, func(sess *db.Session) error {
+		_, err := sess.Exec("ALTER TABLE oidc_session_logout RENAME TO oidc_session_logout_unavailable")
+		return err
+	}))
+	t.Cleanup(func() {
+		require.NoError(t, helper.DB.WithDbSession(ctx, func(sess *db.Session) error {
+			_, err := sess.Exec("ALTER TABLE oidc_session_logout_unavailable RENAME TO oidc_session_logout")
+			return err
+		}))
+	})
+	_, err = service.LookupToken(ctx, otherProvider.UnhashedToken)
+	require.Error(t, err)
+	_, err = service.LookupToken(ctx, local.UnhashedToken)
+	require.NoError(t, err)
+}
