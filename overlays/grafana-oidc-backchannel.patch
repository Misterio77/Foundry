+package api
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+	"github.com/grafana/grafana/pkg/infra/log"
+	"github.com/grafana/grafana/pkg/login/oidcbackchannel"
+	"github.com/grafana/grafana/pkg/login/social"
+	"github.com/grafana/grafana/pkg/login/social/socialtest"
+	"github.com/grafana/grafana/pkg/services/auth"
+	"github.com/stretchr/testify/require"
+)
+
+type testLogoutRecorder struct {
+	auth.UserTokenService
+	events []oidcbackchannel.Binding
+	err    error
+}
+
+func (r *testLogoutRecorder) RecordOIDCLogout(_ context.Context, b oidcbackchannel.Binding) error {
+	r.events = append(r.events, b)
+	return r.err
+}
+
+func TestOIDCBackchannelLogout(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	provider := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.NoError(t, json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: public}}}))
+	}))
+	defer provider.Close()
+	previous := http.DefaultTransport
+	http.DefaultTransport = provider.Client().Transport
+	defer func() { http.DefaultTransport = previous }()
+	info := &social.OAuthInfo{Enabled: true, ClientId: "grafana", JwkSetURL: provider.URL + "/keys", Extra: map[string]string{"backchannel_logout": "true", "oidc_issuer": provider.URL}}
+	recorder := &testLogoutRecorder{}
+	server := SetupAPITestServer(t, func(hs *HTTPServer) {
+		hs.SocialService = &socialtest.FakeSocialService{GetOAuthInfoProviderFunc: func(context.Context, string) (*social.OAuthInfo, error) { return info, nil }}
+		hs.AuthTokenService = recorder
+		hs.log = log.New("oidc-test")
+	})
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.EdDSA, Key: private}, nil)
+	require.NoError(t, err)
+	now := time.Now()
+	raw, err := jwt.Signed(signer).Claims(map[string]any{"iss": provider.URL, "aud": "grafana", "sub": "alice", "sid": "session-a", "iat": now.Unix(), "exp": now.Add(time.Minute).Unix(), "jti": "event-a", "events": map[string]any{oidcbackchannel.Event: map[string]any{}}}).Serialize()
+	require.NoError(t, err)
+	send := func(body string) int {
+		request := server.NewPostRequest("/login/generic_oauth/backchannel-logout", strings.NewReader(body))
+		request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		// A signed server-to-server event must work without browser cookies or a CSRF origin.
+		request.Header.Set("Origin", "https://auth.example")
+		res, err := server.Send(request)
+		require.NoError(t, err)
+		defer res.Body.Close()
+		require.Equal(t, "no-store", res.Header.Get("Cache-Control"))
+		return res.StatusCode
+	}
+	require.Equal(t, http.StatusBadRequest, send(""))
+	require.Equal(t, http.StatusBadRequest, send("logout_token=invalid"))
+	require.Empty(t, recorder.events)
+	body := url.Values{"logout_token": {raw}}.Encode()
+	require.Equal(t, http.StatusOK, send(body))
+	require.Len(t, recorder.events, 1)
+	require.Equal(t, http.StatusOK, send(body))
+	require.Len(t, recorder.events, 2)
+	require.Equal(t, http.StatusBadRequest, send(body+"&"+body))
+	require.Len(t, recorder.events, 2)
+	require.Equal(t, http.StatusBadRequest, send("logout_token="+strings.Repeat("x", 65<<10)))
+	recorder.err = errors.New("database unavailable")
+	require.Equal(t, http.StatusServiceUnavailable, send(body))
+	info.Extra["backchannel_logout"] = "false"
+	require.Equal(t, http.StatusNotFound, send(body))
+}
