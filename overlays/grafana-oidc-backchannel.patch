diff --git a/pkg/api/oidc_backchannel.go b/pkg/api/oidc_backchannel.go
new file mode 100644
--- /dev/null
+++ b/pkg/api/oidc_backchannel.go
@@ -0,0 +1,63 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"net/http"
+
+	"github.com/grafana/grafana/pkg/login/oidcbackchannel"
+	"github.com/grafana/grafana/pkg/login/social"
+	contextmodel "github.com/grafana/grafana/pkg/services/contexthandler/model"
+)
+
+type oidcLogoutRecorder interface {
+	RecordOIDCLogout(context.Context, oidcbackchannel.Binding) error
+}
+
+func (hs *HTTPServer) OIDCBackchannelLogout(c *contextmodel.ReqContext) {
+	c.Resp.Header().Set("Cache-Control", "no-store")
+	info, err := hs.SocialService.GetOAuthInfoProvider(c.Req.Context(), social.GenericOAuthProviderName)
+	if err != nil {
+		c.Resp.WriteHeader(http.StatusServiceUnavailable)
+		return
+	}
+	if info == nil || !info.Enabled || info.Extra["backchannel_logout"] != "true" {
+		c.Resp.WriteHeader(http.StatusNotFound)
+		return
+	}
+	cfg := oidcbackchannel.Config{Issuer: info.Extra["oidc_issuer"], ClientID: info.ClientId, JWKSURL: info.JwkSetURL}
+	if cfg.Check() != nil {
+		c.Resp.WriteHeader(http.StatusServiceUnavailable)
+		return
+	}
+	c.Req.Body = http.MaxBytesReader(c.Resp, c.Req.Body, 64<<10)
+	if err := c.Req.ParseForm(); err != nil {
+		c.Resp.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	values := c.Req.PostForm["logout_token"]
+	if len(values) != 1 {
+		c.Resp.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	event, err := oidcbackchannel.Validate(c.Req.Context(), values[0], cfg, true)
+	if err != nil {
+		if errors.Is(err, oidcbackchannel.ErrKeysUnavailable) {
+			c.Resp.WriteHeader(http.StatusServiceUnavailable)
+		} else {
+			c.Resp.WriteHeader(http.StatusBadRequest)
+		}
+		return
+	}
+	recorder, ok := hs.AuthTokenService.(oidcLogoutRecorder)
+	if !ok {
+		c.Resp.WriteHeader(http.StatusServiceUnavailable)
+		return
+	}
+	if err := recorder.RecordOIDCLogout(c.Req.Context(), event); err != nil {
+		hs.log.Error("Failed to persist OIDC logout", "error", err)
+		c.Resp.WriteHeader(http.StatusServiceUnavailable)
+		return
+	}
+	c.Resp.WriteHeader(http.StatusOK)
+}
