+++ b/pkg/login/oidcbackchannel/remote_test.go
@@ -0,0 +1,112 @@
+package oidcbackchannel
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCachedKeysSurviveProviderOutage(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	var requests atomic.Int32
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		require.NoError(t, json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: public}}}))
+	}))
+	defer server.Close()
+	previous := http.DefaultTransport
+	http.DefaultTransport = server.Client().Transport
+	defer func() { http.DefaultTransport = previous }()
+	cfg := Config{Issuer: server.URL, ClientID: "grafana", JWKSURL: server.URL + "/jwks"}
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.EdDSA, Key: private}, nil)
+	require.NoError(t, err)
+	now := time.Now()
+	raw, err := jwt.Signed(signer).Claims(map[string]any{"iss": cfg.Issuer, "aud": cfg.ClientID, "sub": "alice", "sid": "sid-a", "iat": now.Unix(), "exp": now.Add(time.Minute).Unix()}).Serialize()
+	require.NoError(t, err)
+	_, err = Validate(context.Background(), raw, cfg, false)
+	require.NoError(t, err)
+	require.EqualValues(t, 1, requests.Load())
+	server.Close()
+	raw, err = jwt.Signed(signer).Claims(map[string]any{"iss": cfg.Issuer, "aud": cfg.ClientID, "sub": "alice", "sid": "sid-a", "iat": now.Unix(), "exp": now.Add(time.Minute).Unix(), "jti": "logout", "events": map[string]any{Event: map[string]any{}}}).Serialize()
+	require.NoError(t, err)
+	_, err = Validate(context.Background(), raw, cfg, true)
+	require.NoError(t, err)
+	require.EqualValues(t, 1, requests.Load())
+	keyCache.Lock()
+	delete(keyCache.entries, cfg.JWKSURL)
+	keyCache.Unlock()
+	_, err = Validate(context.Background(), raw, cfg, true)
+	require.ErrorIs(t, err, ErrKeysUnavailable)
+}
+
+func TestKeyRotationAndFetchBackoff(t *testing.T) {
+	var current atomic.Value
+	var requests atomic.Int32
+	var unavailable atomic.Bool
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if unavailable.Load() {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		require.NoError(t, json.NewEncoder(w).Encode(current.Load()))
+	}))
+	defer server.Close()
+	previous := http.DefaultTransport
+	http.DefaultTransport = server.Client().Transport
+	defer func() { http.DefaultTransport = previous }()
+	cfg := Config{Issuer: server.URL, ClientID: "grafana", JWKSURL: server.URL + "/keys"}
+	mint := func() (string, jose.JSONWebKeySet) {
+		public, private, err := ed25519.GenerateKey(rand.Reader)
+		require.NoError(t, err)
+		signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.EdDSA, Key: private}, nil)
+		require.NoError(t, err)
+		now := time.Now()
+		raw, err := jwt.Signed(signer).Claims(map[string]any{"iss": cfg.Issuer, "aud": cfg.ClientID, "sub": "alice", "iat": now.Unix(), "exp": now.Add(time.Minute).Unix()}).Serialize()
+		require.NoError(t, err)
+		return raw, jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: public}}}
+	}
+	allowFetch := func() {
+		keyCache.Lock()
+		cached := keyCache.entries[cfg.JWKSURL]
+		cached.attempted = time.Now().Add(-6 * time.Second)
+		keyCache.entries[cfg.JWKSURL] = cached
+		keyCache.Unlock()
+	}
+	first, keys := mint()
+	current.Store(keys)
+	_, err := Validate(context.Background(), first, cfg, false)
+	require.NoError(t, err)
+	second, keys := mint()
+	current.Store(keys)
+	_, err = Validate(context.Background(), second, cfg, false)
+	require.Error(t, err)
+	require.EqualValues(t, 1, requests.Load())
+	allowFetch()
+	_, err = Validate(context.Background(), second, cfg, false)
+	require.NoError(t, err)
+	require.EqualValues(t, 2, requests.Load())
+	_, err = Validate(context.Background(), first, cfg, false)
+	require.Error(t, err)
+	unavailable.Store(true)
+	third, _ := mint()
+	allowFetch()
+	_, err = Validate(context.Background(), third, cfg, false)
+	require.ErrorIs(t, err, ErrKeysUnavailable)
+	_, err = Validate(context.Background(), third, cfg, false)
+	require.ErrorIs(t, err, ErrKeysUnavailable)
+	require.EqualValues(t, 3, requests.Load())
+	_, err = Validate(context.Background(), second, cfg, false)
+	require.NoError(t, err)
+}
diff --git a/pkg/login/oidcbackchannel/token.go b/pkg/login/oidcbackchannel/token.go
new file mode 100644
--- /dev/null
+++ b/pkg/login/oidcbackchannel/token.go
@@ -0,0 +1,211 @@
+package oidcbackchannel
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sync"
+	"time"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+)
+
+const Event = "http://schemas.openid.net/event/backchannel-logout"
+
+var ErrKeysUnavailable = errors.New("OIDC signing keys unavailable")
+
+// Binding contains only hashes of provider/client-scoped identity, never bearer tokens.
+type Binding struct {
+	Scope    string
+	Subject  string
+	Session  string
+	IssuedAt int64
+}
+
+func (b Binding) MatchesSubject(subject string) bool {
+	return subject != "" && b.Subject == digest(subject)
+}
+
+type Config struct {
+	Issuer   string
+	ClientID string
+	JWKSURL  string
+}
+
+func (c Config) Check() error {
+	for _, raw := range []string{c.Issuer, c.JWKSURL} {
+		u, err := url.Parse(raw)
+		if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.Fragment != "" {
+			return errors.New("OIDC issuer and JWKS URL must be configured HTTPS URLs")
+		}
+	}
+	if c.ClientID == "" {
+		return errors.New("OIDC client ID is required")
+	}
+	return nil
+}
+
+func digest(values ...string) string {
+	b, _ := json.Marshal(values)
+	h := sha256.Sum256(b)
+	return hex.EncodeToString(h[:])
+}
+
+func (c Config) binding(claims tokenClaims) Binding {
+	b := Binding{Scope: digest("oauth_generic_oauth", c.Issuer, c.ClientID), IssuedAt: int64(*claims.IssuedAt)}
+	if claims.Subject != "" {
+		b.Subject = digest(claims.Subject)
+	}
+	if claims.Session != "" {
+		b.Session = digest(claims.Session)
+	}
+	return b
+}
+
+type tokenClaims struct {
+	jwt.Claims
+	Session         string                     `json:"sid"`
+	Events          map[string]json.RawMessage `json:"events"`
+	Nonce           json.RawMessage            `json:"nonce"`
+	AuthorizedParty string                     `json:"azp"`
+}
+
+var algorithms = []jose.SignatureAlgorithm{jose.RS256, jose.RS384, jose.RS512, jose.PS256, jose.PS384, jose.PS512, jose.ES256, jose.ES384, jose.ES512, jose.EdDSA}
+
+// Verify accepts only asymmetric signatures from explicitly configured keys.
+func Verify(raw string, keys jose.JSONWebKeySet, cfg Config, logout bool, now time.Time) (Binding, error) {
+	token, err := jwt.ParseSigned(raw, algorithms)
+	if err != nil {
+		return Binding{}, err
+	}
+	if len(token.Headers) != 1 {
+		return Binding{}, errors.New("expected one JWT signature")
+	}
+	var claims tokenClaims
+	verified := false
+	for _, key := range keys.Keys {
+		if !key.IsPublic() || (key.Use != "" && key.Use != "sig") || (key.Algorithm != "" && key.Algorithm != token.Headers[0].Algorithm) {
+			continue
+		}
+		if token.Headers[0].KeyID != "" && key.KeyID != token.Headers[0].KeyID {
+			continue
+		}
+		if err = token.Claims(key.Key, &claims); err == nil {
+			verified = true
+			break
+		}
+	}
+	if !verified {
+		return Binding{}, errors.New("JWT signature verification failed")
+	}
+	if claims.IssuedAt == nil || claims.Issuer != cfg.Issuer || !claims.Audience.Contains(cfg.ClientID) {
+		return Binding{}, errors.New("invalid OIDC issuer, audience or issuance time")
+	}
+	if err = claims.ValidateWithLeeway(jwt.Expected{Issuer: cfg.Issuer, AnyAudience: jwt.Audience{cfg.ClientID}, Time: now}, 10*time.Second); err != nil {
+		return Binding{}, err
+	}
+	if logout {
+		event, ok := claims.Events[Event]
+		var obj map[string]json.RawMessage
+		if !ok || json.Unmarshal(event, &obj) != nil || obj == nil || len(obj) != 0 || len(claims.Nonce) != 0 || claims.ID == "" || (claims.Session == "" && claims.Subject == "") {
+			return Binding{}, errors.New("invalid back-channel logout claims")
+		}
+		if claims.IssuedAt.Time().Before(now.Add(-5 * time.Minute)) {
+			return Binding{}, errors.New("logout token is too old")
+		}
+	} else {
+		if claims.Expiry == nil || claims.Subject == "" || claims.Events != nil {
+			return Binding{}, errors.New("invalid ID token")
+		}
+		if (len(claims.Audience) > 1 && claims.AuthorizedParty == "") || (claims.AuthorizedParty != "" && claims.AuthorizedParty != cfg.ClientID) {
+			return Binding{}, errors.New("invalid authorized party")
+		}
+	}
+	return cfg.binding(claims), nil
+}
+
+type cachedKeys struct {
+	keys      jose.JSONWebKeySet
+	fetched   time.Time
+	attempted time.Time
+	fetchErr  error
+}
+
+var keyCache = struct {
+	sync.Mutex
+	entries map[string]cachedKeys
+}{entries: make(map[string]cachedKeys)}
+
+// Cached keys keep logout delivery independent of discovery, including during short outages.
+func Validate(ctx context.Context, raw string, cfg Config, logout bool) (Binding, error) {
+	if err := cfg.Check(); err != nil {
+		return Binding{}, err
+	}
+	if len(raw) == 0 || len(raw) > 64<<10 {
+		return Binding{}, errors.New("invalid JWT length")
+	}
+	keyCache.Lock()
+	defer keyCache.Unlock()
+	cached, ok := keyCache.entries[cfg.JWKSURL]
+	now := time.Now()
+	var binding Binding
+	var verifyErr error
+	if ok && now.Sub(cached.fetched) < time.Hour {
+		binding, verifyErr = Verify(raw, cached.keys, cfg, logout, now)
+		if verifyErr == nil {
+			return binding, nil
+		}
+	}
+	if ok && now.Sub(cached.attempted) < 5*time.Second {
+		if cached.fetchErr != nil {
+			return Binding{}, cached.fetchErr
+		}
+		return binding, verifyErr
+	}
+	keys, err := fetchKeys(ctx, cfg.JWKSURL)
+	cached.attempted = now
+	cached.fetchErr = err
+	if err == nil {
+		cached.keys = keys
+		cached.fetched = now
+	}
+	if len(keyCache.entries) >= 16 {
+		clear(keyCache.entries)
+	}
+	keyCache.entries[cfg.JWKSURL] = cached
+	if err != nil {
+		return Binding{}, err
+	}
+	return Verify(raw, keys, cfg, logout, now)
+}
+
+func fetchKeys(ctx context.Context, endpoint string) (jose.JSONWebKeySet, error) {
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return jose.JSONWebKeySet{}, fmt.Errorf("%w: %w", ErrKeysUnavailable, err)
+	}
+	client := &http.Client{Timeout: 3 * time.Second, CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }}
+	response, err := client.Do(request)
+	if err != nil {
+		return jose.JSONWebKeySet{}, fmt.Errorf("%w: %w", ErrKeysUnavailable, err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return jose.JSONWebKeySet{}, ErrKeysUnavailable
+	}
+	var keys jose.JSONWebKeySet
+	if err := json.NewDecoder(io.LimitReader(response.Body, 1<<20)).Decode(&keys); err != nil {
+		return jose.JSONWebKeySet{}, fmt.Errorf("%w: %w", ErrKeysUnavailable, err)
+	}
+	if len(keys.Keys) == 0 || len(keys.Keys) > 100 {
+		return jose.JSONWebKeySet{}, ErrKeysUnavailable
+	}
+	return keys, nil
+}
diff --git a/pkg/login/oidcbackchannel/token_test.go b/pkg/login/oidcbackchannel/token_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/login/oidcbackchannel/token_test.go
@@ -0,0 +1,95 @@
+package oidcbackchannel
+
+import (
+	"crypto/ed25519"
+	"crypto/rand"
+	"testing"
+	"time"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+	"github.com/stretchr/testify/require"
+)
+
+func TestVerify(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.EdDSA, Key: private}, (&jose.SignerOptions{}).WithType("logout+jwt"))
+	require.NoError(t, err)
+	keys := jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: public, Use: "sig", Algorithm: "EdDSA"}}}
+	now := time.Now().Truncate(time.Second)
+	cfg := Config{Issuer: "https://auth.example/application/o/grafana/", ClientID: "grafana", JWKSURL: "https://auth.example/keys"}
+	base := func() map[string]any {
+		return map[string]any{"iss": cfg.Issuer, "aud": cfg.ClientID, "sub": "alice", "sid": "session-a", "iat": now.Unix(), "exp": now.Add(time.Minute).Unix(), "jti": "event-a", "events": map[string]any{Event: map[string]any{}}}
+	}
+	sign := func(c map[string]any) string {
+		raw, err := jwt.Signed(signer).Claims(c).Serialize()
+		require.NoError(t, err)
+		return raw
+	}
+	for _, tc := range []struct {
+		name   string
+		change func(map[string]any)
+		valid  bool
+	}{
+		{"valid", func(map[string]any) {}, true},
+		{"sid only", func(c map[string]any) { delete(c, "sub") }, true},
+		{"subject only", func(c map[string]any) { delete(c, "sid") }, true},
+		{"no exp is permitted by logout spec", func(c map[string]any) { delete(c, "exp") }, true},
+		{"wrong issuer", func(c map[string]any) { c["iss"] = "https://evil.example" }, false},
+		{"wrong client", func(c map[string]any) { c["aud"] = "another-app" }, false},
+		{"expired", func(c map[string]any) { c["exp"] = now.Add(-time.Minute).Unix() }, false},
+		{"old", func(c map[string]any) { c["iat"] = now.Add(-6 * time.Minute).Unix() }, false},
+		{"future", func(c map[string]any) { c["iat"] = now.Add(time.Minute).Unix() }, false},
+		{"no issuance", func(c map[string]any) { delete(c, "iat") }, false},
+		{"no identifier", func(c map[string]any) { delete(c, "jti") }, false},
+		{"no target", func(c map[string]any) { delete(c, "sub"); delete(c, "sid") }, false},
+		{"nonce", func(c map[string]any) { c["nonce"] = "nonce" }, false},
+		{"null nonce", func(c map[string]any) { c["nonce"] = nil }, false},
+		{"wrong event", func(c map[string]any) { c["events"] = map[string]any{"other": map[string]any{}} }, false},
+		{"null event", func(c map[string]any) { c["events"] = map[string]any{Event: nil} }, false},
+		{"ID token is not logout", func(c map[string]any) { delete(c, "events") }, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := base()
+			tc.change(c)
+			_, err := Verify(sign(c), keys, cfg, true, now)
+			if tc.valid {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+	claims := base()
+	raw := sign(claims)
+	other, _, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	_, err = Verify(raw, jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: other}}}, cfg, true, now)
+	require.Error(t, err)
+	_, err = Verify("garbage", keys, cfg, true, now)
+	require.Error(t, err)
+	delete(claims, "events")
+	delete(claims, "jti")
+	b, err := Verify(sign(claims), keys, cfg, false, now)
+	require.NoError(t, err)
+	require.True(t, b.MatchesSubject("alice"))
+	require.False(t, b.MatchesSubject("bob"))
+	require.NotEqual(t, "alice", b.Subject)
+	claims["aud"] = []string{"grafana", "other"}
+	_, err = Verify(sign(claims), keys, cfg, false, now)
+	require.Error(t, err)
+	claims["azp"] = "grafana"
+	_, err = Verify(sign(claims), keys, cfg, false, now)
+	require.NoError(t, err)
+	claims["azp"] = "other"
+	_, err = Verify(sign(claims), keys, cfg, false, now)
+	require.Error(t, err)
+}
+
+func TestConfig(t *testing.T) {
+	require.NoError(t, (Config{Issuer: "https://auth.example/", ClientID: "grafana", JWKSURL: "https://auth.example/keys"}).Check())
+	for _, raw := range []string{"", "http://auth.example/", "https://user:pass@auth.example/", "https:///keys", "https://auth.example/#fragment"} {
+		require.Error(t, (Config{Issuer: raw, ClientID: "grafana", JWKSURL: "https://auth.example/keys"}).Check())
+	}
+}
