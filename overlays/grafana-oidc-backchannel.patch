@@ -0,0 +1,67 @@
+package clients
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+	"github.com/grafana/grafana/pkg/infra/tracing"
+	"github.com/grafana/grafana/pkg/login/social"
+	"github.com/grafana/grafana/pkg/login/social/socialtest"
+	"github.com/grafana/grafana/pkg/services/authn"
+	"github.com/grafana/grafana/pkg/services/featuremgmt"
+	"github.com/grafana/grafana/pkg/setting"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+)
+
+func TestOAuthBackchannelSessionIdentity(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	provider := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.NoError(t, json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{{Key: public}}}))
+	}))
+	defer provider.Close()
+	previous := http.DefaultTransport
+	http.DefaultTransport = provider.Client().Transport
+	defer func() { http.DefaultTransport = previous }()
+	cfg := setting.NewCfg()
+	info := &social.OAuthInfo{Enabled: true, ClientId: "grafana", JwkSetURL: provider.URL + "/keys", Extra: map[string]string{"backchannel_logout": "true", "oidc_issuer": provider.URL}}
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.EdDSA, Key: private}, nil)
+	require.NoError(t, err)
+	now := time.Now()
+	raw, err := jwt.Signed(signer).Claims(map[string]any{"iss": provider.URL, "aud": "grafana", "sub": "alice", "sid": "session-a", "iat": now.Unix(), "exp": now.Add(time.Minute).Unix()}).Serialize()
+	require.NoError(t, err)
+	for _, tc := range []struct {
+		name, subject, token string
+		valid                bool
+	}{
+		{"verified binding", "alice", raw, true},
+		{"mismatching userinfo subject", "bob", raw, false},
+		{"missing ID token", "alice", "", false},
+		{"invalid ID token", "alice", "invalid", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			socialService := &socialtest.FakeSocialService{ExpectedAuthInfoProvider: info, ExpectedConnector: fakeConnector{ExpectedToken: (&oauth2.Token{}).WithExtra(map[string]any{"id_token": tc.token}), ExpectedUserInfo: &social.BasicUserInfo{Id: tc.subject, Email: "alice@example.com"}, ExpectedIsEmailAllowed: true}}
+			client := ProvideOAuth(authn.ClientWithPrefix("generic_oauth"), testConfigProvider(t, cfg), nil, socialService, nil, featuremgmt.WithFeatures(), tracing.InitializeTracerForTest())
+			request := httptest.NewRequest(http.MethodGet, "https://grafana.example/login/generic_oauth?state=state&code=code", nil)
+			request.AddCookie(&http.Cookie{Name: oauthStateCookieName, Value: hashOAuthState("state", cfg.SecretKey, info.ClientSecret)})
+			identity, err := client.Authenticate(context.Background(), &authn.Request{HTTPRequest: request})
+			if tc.valid {
+				require.NoError(t, err)
+				require.NotNil(t, identity.OIDCSession)
+				require.True(t, identity.OIDCSession.MatchesSubject("alice"))
+				require.NotEmpty(t, identity.OIDCSession.Session)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
+}
