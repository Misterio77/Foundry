@@ -0,0 +1,356 @@
+"""Loopback-only smoke test. Requires cryptography; pass the Grafana binary and source root."""
+
+import base64
+import datetime
+import hashlib
+import http.cookiejar
+import http.server
+import json
+import os
+import socket
+import ssl
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ed25519, rsa
+from cryptography.x509.oid import NameOID
+
+
+def b64(value):
+    return base64.urlsafe_b64encode(value).rstrip(b"=").decode()
+
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, *args):
+        return None
+
+
+def request(opener, url, data=None):
+    try:
+        response = opener.open(url, data=data, timeout=5)
+    except urllib.error.HTTPError as error:
+        response = error
+    with response:
+        return response.code, response.headers, response.read()
+
+
+def main(binary, source):
+    with tempfile.TemporaryDirectory(prefix="grafana-oidc-smoke-") as directory:
+        root = Path(directory)
+        tls_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
+        name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "localhost")])
+        now = datetime.datetime.now(datetime.UTC)
+        cert = (
+            x509.CertificateBuilder()
+            .subject_name(name)
+            .issuer_name(name)
+            .public_key(tls_key.public_key())
+            .serial_number(x509.random_serial_number())
+            .not_valid_before(now - datetime.timedelta(minutes=1))
+            .not_valid_after(now + datetime.timedelta(days=1))
+            .add_extension(
+                x509.SubjectAlternativeName([x509.DNSName("localhost")]), False
+            )
+            .add_extension(x509.BasicConstraints(ca=True, path_length=None), True)
+            .sign(tls_key, hashes.SHA256())
+        )
+        ca = root / "ca.pem"
+        ca.write_bytes(cert.public_bytes(serialization.Encoding.PEM))
+        key_path = root / "tls.key"
+        key_path.write_bytes(
+            tls_key.private_bytes(
+                serialization.Encoding.PEM,
+                serialization.PrivateFormat.PKCS8,
+                serialization.NoEncryption(),
+            )
+        )
+        jwt_key = ed25519.Ed25519PrivateKey.generate()
+
+        def sign(claims):
+            header = b64(json.dumps({"alg": "EdDSA", "kid": "test-key"}).encode())
+            payload = b64(json.dumps(claims).encode())
+            message = f"{header}.{payload}".encode()
+            return message.decode() + "." + b64(jwt_key.sign(message))
+
+        with socket.socket() as reservation:
+            reservation.bind(("127.0.0.1", 0))
+            port = reservation.getsockname()[1]
+        grafana = f"http://127.0.0.1:{port}"
+        codes = {}
+        sessions = []
+
+        class Provider(http.server.BaseHTTPRequestHandler):
+            def log_message(self, *args):
+                pass
+
+            def reply(self, value):
+                body = json.dumps(value).encode()
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def do_GET(self):
+                parsed = urllib.parse.urlparse(self.path)
+                if parsed.path == "/keys":
+                    self.reply(
+                        {
+                            "keys": [
+                                {
+                                    "kty": "OKP",
+                                    "crv": "Ed25519",
+                                    "kid": "test-key",
+                                    "alg": "EdDSA",
+                                    "use": "sig",
+                                    "x": b64(
+                                        jwt_key.public_key().public_bytes(
+                                            serialization.Encoding.Raw,
+                                            serialization.PublicFormat.Raw,
+                                        )
+                                    ),
+                                }
+                            ]
+                        }
+                    )
+                elif parsed.path == "/userinfo":
+                    self.reply(
+                        {
+                            "sub": "alice",
+                            "preferred_username": "alice",
+                            "email": "alice@example.com",
+                            "grafana_role": "Viewer",
+                        }
+                    )
+                elif parsed.path == "/authorize":
+                    query = urllib.parse.parse_qs(parsed.query)
+                    sid = "session-" + str(len(sessions) + 1)
+                    sessions.append(sid)
+                    codes[sid] = query
+                    target = (
+                        query["redirect_uri"][0]
+                        + "?"
+                        + urllib.parse.urlencode(
+                            {"state": query["state"][0], "code": sid}
+                        )
+                    )
+                    self.send_response(302)
+                    self.send_header("Location", target)
+                    self.end_headers()
+                else:
+                    self.send_error(404)
+
+            def do_POST(self):
+                if self.path != "/token":
+                    self.send_error(404)
+                    return
+                data = urllib.parse.parse_qs(
+                    self.rfile.read(int(self.headers["Content-Length"])).decode()
+                )
+                sid = data["code"][0]
+                query = codes.pop(sid)
+                assert (
+                    b64(hashlib.sha256(data["code_verifier"][0].encode()).digest())
+                    == query["code_challenge"][0]
+                )
+                issued = int(time.time())
+                claims = {
+                    "iss": issuer,
+                    "aud": "grafana",
+                    "sub": "alice",
+                    "sid": sid,
+                    "iat": issued,
+                    "exp": issued + 1,
+                    "preferred_username": "alice",
+                    "email": "alice@example.com",
+                    "grafana_role": "Viewer",
+                }
+                self.reply(
+                    {
+                        "access_token": sign(claims),
+                        "id_token": sign(claims),
+                        "token_type": "Bearer",
+                        "expires_in": 1,
+                    }
+                )
+
+        provider = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Provider)
+        issuer = f"https://localhost:{provider.server_port}/"
+        tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        tls.load_cert_chain(ca, key_path)
+        provider.socket = tls.wrap_socket(provider.socket, server_side=True)
+        thread = threading.Thread(target=provider.serve_forever, daemon=True)
+        thread.start()
+        config = root / "grafana.ini"
+        for path in ("data", "logs", "plugins", "provisioning"):
+            (root / path).mkdir()
+        config.write_text(f"""[paths]
+data = {root / "data"}
+logs = {root / "logs"}
+plugins = {root / "plugins"}
+provisioning = {root / "provisioning"}
+[server]
+http_addr = 127.0.0.1
+http_port = {port}
+root_url = {grafana}/
+[security]
+disable_initial_admin_creation = true
+secret_key = disposable-loopback-test-key
+[analytics]
+reporting_enabled = false
+check_for_updates = false
+check_for_plugin_updates = false
+[plugins]
+preinstall_disabled = true
+[unified_alerting]
+enabled = false
+[auth.basic]
+enabled = false
+[auth.generic_oauth]
+enabled = true
+allow_sign_up = true
+client_id = grafana
+client_secret = disposable-test-client
+scopes = openid email profile
+use_pkce = true
+use_refresh_token = false
+backchannel_logout = true
+oidc_issuer = {issuer}
+jwk_set_url = {issuer}keys
+validate_id_token = true
+auth_url = {issuer}authorize
+token_url = {issuer}token
+api_url = {issuer}userinfo
+role_attribute_path = grafana_role
+role_attribute_strict = true
+""")
+        # Do not inherit an operator's Grafana overrides or credentials into this instance.
+        env = {
+            key: value for key, value in os.environ.items() if not key.startswith("GF_")
+        }
+        env["SSL_CERT_FILE"] = str(ca)
+        log = (root / "server.log").open("w+")
+        process = None
+        provider_running = True
+
+        def start():
+            nonlocal process
+            process = subprocess.Popen(
+                [binary, "server", "--homepath", source, "--config", str(config)],
+                env=env,
+                stdout=log,
+                stderr=subprocess.STDOUT,
+            )
+            for _ in range(100):
+                if process.poll() is not None:
+                    raise RuntimeError("Grafana exited during startup")
+                try:
+                    if (
+                        request(urllib.request.build_opener(), grafana + "/api/health")[
+                            0
+                        ]
+                        == 200
+                    ):
+                        return
+                except OSError:
+                    pass
+                time.sleep(0.1)
+            raise RuntimeError("Grafana did not become healthy")
+
+        def stop():
+            if process is not None and process.poll() is None:
+                process.terminate()
+                process.wait(timeout=20)
+
+        def browser():
+            return urllib.request.build_opener(
+                NoRedirect(),
+                urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()),
+                urllib.request.HTTPSHandler(
+                    context=ssl.create_default_context(cafile=ca)
+                ),
+            )
+
+        def login(client):
+            status, headers, _ = request(client, grafana + "/login/generic_oauth")
+            assert status == 302, status
+            status, headers, _ = request(client, headers["Location"])
+            assert status == 302, status
+            status, headers, _ = request(client, headers["Location"])
+            assert status == 302, status
+            status, _, body = request(client, grafana + "/api/user")
+            assert status == 200, (status, body)
+
+        try:
+            start()
+            alice, other = browser(), browser()
+            login(alice)
+            login(other)
+            time.sleep(2)
+            assert request(alice, grafana + "/api/user")[0] == 200
+            assert request(other, grafana + "/api/user")[0] == 200
+            print("PASS: local sessions survive OIDC token expiry", flush=True)
+            issued = int(time.time())
+            event = sign(
+                {
+                    "iss": issuer,
+                    "aud": "grafana",
+                    "sub": "alice",
+                    "sid": sessions[0],
+                    "iat": issued,
+                    "exp": issued + 60,
+                    "jti": "logout-1",
+                    "events": {
+                        "http://schemas.openid.net/event/backchannel-logout": {}
+                    },
+                }
+            )
+            body = urllib.parse.urlencode({"logout_token": event}).encode()
+            assert (
+                request(
+                    urllib.request.build_opener(),
+                    grafana + "/login/generic_oauth/backchannel-logout",
+                    body,
+                )[0]
+                == 200
+            )
+            assert request(alice, grafana + "/api/user")[0] == 401
+            assert request(other, grafana + "/api/user")[0] == 200
+            print("PASS: signed logout revokes only the targeted session", flush=True)
+            stop()
+            start()
+            assert request(alice, grafana + "/api/user")[0] == 401
+            assert request(other, grafana + "/api/user")[0] == 200
+            print(
+                "PASS: revocation and unaffected sessions survive Grafana restart",
+                flush=True,
+            )
+            provider.shutdown()
+            provider.server_close()
+            provider_running = False
+            assert request(other, grafana + "/api/user")[0] == 200
+            print("PASS: existing session works with the IdP offline", flush=True)
+        except BaseException:
+            log.flush()
+            log.seek(0)
+            print(log.read()[-16000:], file=sys.stderr)
+            raise
+        finally:
+            stop()
+            if provider_running:
+                provider.shutdown()
+                provider.server_close()
+            log.close()
+
+
+if __name__ == "__main__":
+    main(*sys.argv[1:])
