      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "group": "",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (instance, uuid) (node_btrfs_used_bytes{instance=\"$hosts\"}) * on(instance, uuid) group_left(label) node_btrfs_info{instance=\"$hosts\"}",
                        "range": false,
                        "legendFormat": "device={{label}},type=used",
                        "instant": true
