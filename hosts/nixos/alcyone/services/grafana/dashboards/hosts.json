{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "hosts"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "elements": {
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "group": "",
                      "kind": "DataQuery",
                      "spec": {
                        "exemplar": false,
                        "expr": "sum((node_time_seconds{instance=\"$hosts\",job=\"hosts\"} - node_boot_time_seconds{instance=\"$hosts\",job=\"hosts\"}) OR vector(0))",
                        "instant": false,
                        "legendFormat": "Uptime",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "id": 2,
          "links": [],
          "title": "Uptime",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 1,
                  "mappings": [
                    {
                      "options": {
                        "0": {
                          "color": "red",
                          "index": 0,
                          "text": "Down"
                        }
                      },
                      "type": "value"
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": 0
                      },
                      {
                        "color": "green",
                        "value": 1
                      }
                    ]
                  },
                  "unit": "s"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "last"
                  ],
                  "fields": "",
                  "limit": 1,
                  "values": false
                },
                "showPercentChange": false,
                "text": {},
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.0.2"
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "group": "",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(nix_registry{name=\"self\",instance=\"$hosts\"} > 1)*1000",
                        "format": "table",
                        "instant": false,
                        "interval": "",
                        "legendFormat": "Version",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "Version"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "group": "",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "max(nix_registry{name=\"self\"})*1000",
                        "format": "time_series",
                        "instant": false,
                        "interval": "",
                        "legendFormat": "Newest",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "Newest"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "configFromData",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "applyTo": {
                        "id": "byName",
                        "options": "Value"
                      },
                      "configRefId": "Newest",
                      "mappings": [
                        {
                          "fieldName": "Newest",
                          "handlerArguments": {
                            "threshold": {
                              "color": "green"
                            }
                          },
                          "handlerKey": "threshold1"
                        }
                      ]
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "instance": true,
                        "job": true,
                        "name": true
                      },
                      "includeByName": {},
                      "indexByName": {},
                      "renameByName": {
                        "Time": "",
                        "Value": "Commited at",
                        "rev": "Revision"
                      }
                    }
                  }
                },
                {
                  "group": "formatString",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "outputFormat": "Substring",
                      "stringField": "rev",
                      "substringEnd": 8
                    }
                  }
                }
              ]
            }
          },
          "id": 6,
          "links": [],
          "title": "Flake",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "fieldMinMax": true,
                  "mappings": [
                    {
                      "options": {
                        "0": {
                          "color": "red",
                          "index": 0,
                          "text": "Off"
                        }
                      },
                      "type": "value"
                    }
                  ],
                  "noValue": "Unknown",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": 0
                      }
                    ]
                  },
                  "unit": "dateTimeFromNow"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "rev"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "string"
                      },
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "blue",
                          "mode": "fixed"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "options": {
                              "dirty": {
                                "color": "yellow",
                                "index": 0
                              }
                            },
                            "type": "value"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "percentChangeColorMode": "same_as_value",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "/.*/",
                  "values": false
                },
                "showPercentChange": false,
                "text": {},
                "textMode": "auto",
                "wideLayout": false
              }
            },
            "version": "13.0.2"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "group": "",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(node_memory_MemTotal_bytes{instance=\"$hosts\"} - node_memory_MemAvailable_bytes{instance=\"$hosts\"})",
                        "instant": false,
                        "legendFormat": "Memory",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "Used Memory"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "group": "",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "node_memory_MemTotal_bytes{instance=\"$hosts\"}",
                        "legendFormat": "Total Memory"
                      },
                      "version": "v0"
                    },
                    "refId": "Total Memory"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "group": "",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "node_memory_SwapTotal_bytes{instance=\"$hosts\"} - node_memory_SwapFree_bytes{instance=\"$hosts\"}",
                        "instant": false,
                        "legendFormat": "Swap",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "Used Swap"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "configFromData",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "applyTo": {
                        "id": "byType",
                        "options": "number"
                      },
                      "configRefId": "Total Memory",
                      "mappings": [
                        {
                          "fieldName": "Total Memory",
                          "handlerKey": "max"
                        },
                        {
                          "fieldName": "Time",
                          "handlerKey": "__ignore"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
