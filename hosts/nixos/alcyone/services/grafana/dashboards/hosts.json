                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "type\\device": true
                      },
                      "includeByName": {},
                      "indexByName": {},
                      "orderByMode": "manual",
                      "renameByName": {}
