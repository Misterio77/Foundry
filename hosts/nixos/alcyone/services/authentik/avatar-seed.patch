+    def test_avatars_seed(self):
+        """Seed changes invalidate URL caching; profile changes do not alter the seed."""
+        from hashlib import sha256
+
+        self.set_avatar_mode("https://example.com/avatar/%(avatar_seed_hash)s.png")
+        self.admin.attributes["avatar_seed"] = "kitten-1"
+        self.admin.save()
+        self.client.force_login(self.admin)
+        endpoint = reverse("authentik_api:user-me")
+        first = f"https://example.com/avatar/{sha256(b'kitten-1').hexdigest()}.png"
+        second = f"https://example.com/avatar/{sha256(b'kitten-2').hexdigest()}.png"
+        with Mocker() as mocker:
+            mocker.head(first, headers={"Content-Type": "image/png"})
+            mocker.head(second, headers={"Content-Type": "image/png"})
+            self.assertEqual(self.client.get(endpoint).json()["user"]["avatar"], first)
+            self.admin.name = "Different Name"
+            self.admin.email = "different@example.com"
+            self.admin.username = "different-username"
+            self.admin.save()
+            self.assertEqual(self.client.get(endpoint).json()["user"]["avatar"], first)
+            self.admin.attributes["avatar_seed"] = "kitten-2"
+            self.admin.save()
+            self.assertEqual(self.client.get(endpoint).json()["user"]["avatar"], second)
+            self.assertEqual(len(mocker.request_history), 2)
+
+    def test_avatars_seed_default_and_encoding(self):
