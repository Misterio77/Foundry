<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Gabriel Fontes | {{ page.title }}</title>
    <meta name="description" content="
      {%- if page.description -%}
        {{ page.description }}
      {%- else -%}
        {{ site.description }}
      {%- endif -%}"
    />
    {% if page.noindex == true -%}
      <meta name="robots" content="noindex">
    {%- endif %}
    {% if page.doi -%}
      <meta name="citation_title" content="{{ page.citation_title | default: page.title }}">
      {% for author in page.citation_authors -%}
        <meta name="citation_author" content="{{ author }}">
      {% endfor -%}
      <meta name="citation_publication_date" content="{{ page.published_date }}">
      <meta name="citation_conference_title" content="{{ page.venue }}">
      <meta name="citation_doi" content="{{ page.doi }}">
      <meta name="citation_pdf_url" content="{{ site.url }}{{ page.pdf }}">
    {%- endif %}

    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    {% include head.html.liquid %}
  </head>
  <body>
    {{ content | extlinks }}
  </body>
</html>
