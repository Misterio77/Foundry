---
layout: root.html
---
<header>
  {% include header.html.liquid %}
</header>

<main>
  <article aria-labelledby="page-title" class="{% if page.citation %}publication {% endif %}{% if page.listing %}listing{% else %}document{% endif %}">
    <header aria-label="Header">
      <h1 id="page-title">{{ page.title }}</h1>
      {% if page.subtitle %}
          <p><em>{{ page.subtitle }}</em></p>
      {% endif %}
      {% if page.date %}
        <p aria-label="Publication date">
          <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date_to_long_string: "ordinal" }}</time>
        </p>
      {% endif %}
      {% if page.citation %}
        <ul class="inline-list">
          {% if page.citation.pdf_url %}
            <li aria-label="PDF link"><a href="{{ page.citation.pdf_url }}">PDF</a></li>
          {% endif %}
          {% if page.citation.doi %}
            <li aria-label="DOI link"><a href="https://doi.org/{{ page.citation.doi }}">{{ page.citation.doi }}</a></li>
          {% endif %}
          <li aria-label="Bibtex citation">
            <details class="link-details">
              <summary>Cite</summary>
              {% highlight bibtex %}{% include bibtex.liquid publication=page %}{% endhighlight %}
            </details>
          </li>
        </ul>
        {% if page.citation.author %}
          <ul aria-label="Authors" class="inline-list">
            {% for author in page.citation.author %}<li>{{ author }}</li>{% endfor %}
          </ul>
        {% endif %}
        {% if page.citation.conference_title %}
          <p aria-label="Conference title">{{ page.citation.conference_title }}</p>
        {% endif %}
      {% endif %}
    </header>

    <section aria-label="Content">
      {%- if page.collection == "posts" or page.collection == "publications" -%}
        {%- unless page.toc == false -%}
          {% include toc.html.liquid %}
        {%- endunless -%}
      {%- endif -%}
      {{ content }}
    </section>
  </article>
</main>

<footer>
  {% include footer.html.liquid %}
</footer>
