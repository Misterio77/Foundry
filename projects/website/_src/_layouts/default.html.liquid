---
layout: root.html
---
<header>
  {% include header.html.liquid %}
</header>

<main>
  <article class="{% if page.doi %}publication {% endif %}{% if page.listing %}listing{% else %}document{% endif %}">
    <header>
      <h1>{{ page.title }}</h1>
      {% if page.description %}
          <p><em>{{ page.description }}</em></p>
      {% endif %}
      {% if page.date %}
        <p>
          Date: <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date_to_long_string: "ordinal" }}</time>
        </p>
      {% endif %}
    </header>

    <section>
      {{ content }}
    </section>
  </article>
</main>

<footer>
  {% include footer.html.liquid %}
</footer>
