<a href="/" title="Gabriel Fontes" rel="home"><span aria-hidden="true">✦</span> Gabriel Fontes <span aria-hidden="true">✦</span></a>
<nav aria-label="Site navigation">
    {% assign groups = site.data.navigation | group_by: "group" %}
    {% for group in groups %}
    <ul>
      {% for item in group.items %}
      <li>
        <a
          {% if page.nav_current == item.link or page.url == item.link %}
            aria-current="page"
          {% endif %}
          {% if item.class %}
            class="{{ item.class }}"
          {% endif %}
          href="{{ item.link }}"
        >
          {% if item.text %}
            {{ item.text | downcase }}
          {% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
    {% endfor %}
</nav>
