<section class="theme-constellation" aria-label="Choose a color scheme" hidden>
  <div class="stars">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <!-- bowl: Alcyone-Merope-Electra-Maia-Alcyone; handle: Alcyone-Atlas-Pleione -->
      <path d="M40.2 69.3 L63.4 90 L92.6 68.2 L73.5 34.6 Z M40.2 69.3 L6.5 76.1 L6 65.1" />
      <!-- spurs: Electra-Celaeno and Maia-Taygeta-Asterope -->
      <path class="spurs" d="M92.6 68.2 L94 45 M73.5 34.6 L85.9 21.5 L71.8 10" />
    </svg>

    <button type="button" data-scheme="atlas" data-label="Atlas" style="--x: 6.5%; --y: 76.1%; --star-dark: {{ site.data.colorscheme.atlas.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.atlas.colors.light.primary }}" aria-label="Use Atlas theme" aria-pressed="false"><span></span></button>
    <button type="button" data-scheme="pleione" data-label="Pleione" style="--x: 6%; --y: 65.1%; --star-dark: {{ site.data.colorscheme.pleione.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.pleione.colors.light.primary }}" aria-label="Use Pleione theme" aria-pressed="false"><span></span></button>
    <button type="button" data-scheme="alcyone" data-label="Alcyone" style="--x: 40.2%; --y: 69.3%; --star-dark: {{ site.data.colorscheme.alcyone.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.alcyone.colors.light.primary }}" aria-label="Use Alcyone theme" aria-pressed="false"><span></span></button>
    <button type="button" data-scheme="merope" data-label="Merope" style="--x: 63.4%; --y: 90%; --star-dark: {{ site.data.colorscheme.merope.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.merope.colors.light.primary }}" aria-label="Use Merope theme" aria-pressed="false"><span></span></button>
    <button type="button" data-scheme="maia" data-label="Maia" style="--x: 73.5%; --y: 34.6%; --star-dark: {{ site.data.colorscheme.maia.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.maia.colors.light.primary }}" aria-label="Use Maia theme" aria-pressed="false"><span></span></button>
    <button type="button" data-scheme="celaeno" data-label="Celaeno" style="--x: 94%; --y: 45%; --star-dark: {{ site.data.colorscheme.celaeno.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.celaeno.colors.light.primary }}" aria-label="Use Celaeno theme" aria-pressed="false"><span></span></button>
    <button type="button" data-scheme="taygeta" data-label="Taygeta" style="--x: 85.9%; --y: 21.5%; --star-dark: {{ site.data.colorscheme.taygeta.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.taygeta.colors.light.primary }}" aria-label="Use Taygeta theme" aria-pressed="false"><span></span></button>
    <button type="button" data-scheme="electra" data-label="Electra" style="--x: 92.6%; --y: 68.2%; --star-dark: {{ site.data.colorscheme.electra.colors.dark.primary }}; --star-light: {{ site.data.colorscheme.electra.colors.light.primary }}" aria-label="Use Electra theme" aria-pressed="false"><span></span></button>
    <span class="placeholder-star" style="--x: 71.8%; --y: 10%" aria-hidden="true"></span>
