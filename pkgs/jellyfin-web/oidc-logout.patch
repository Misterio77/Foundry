+import assert from 'node:assert/strict';
+import { webcrypto } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import vm from 'node:vm';
+
+const helper = readFileSync('src/utils/oidcLogout.js', 'utf8').replace('export ', '');
+const dashboard = readFileSync('src/utils/dashboard.js', 'utf8');
+// Exercise the actual logout functions without booting the dashboard's unrelated UI imports.
+const logout = dashboard.slice(dashboard.indexOf('let logoutPromise;'), dashboard.indexOf('export function getPluginUrl'))
+    .replaceAll('export ', '');
+const hash = async token => Buffer.from(await webcrypto.subtle.digest('SHA-256', new TextEncoder().encode(token))).toString('hex');
+
+function client({ token = 'qc-token', marker, storageFails = false, crypto = webcrypto } = {}) {
+    const calls = [];
+    const context = vm.createContext({
+        crypto, TextEncoder, URL, Uint8Array,
+        localStorage: { getItem: () => { if (storageFails) throw new Error('Storage blocked'); return marker; } },
+        ServerConnections: { logout: async () => { calls.push('logout'); } },
+        queryClient: { clear: () => calls.push('cache') },
+        viewContainer: { reset: () => calls.push('views') },
+        window: {
+            ApiClient: { accessToken: () => token },
+            history: { replaceState: (_state, _title, url) => calls.push(url) },
+            location: {
+                href: 'https://media.example/base/web/#/home',
+                reload: () => calls.push('reload'),
+                assign: url => calls.push(url)
+            }
+        }
+    });
+    vm.runInContext(helper + '\n' + logout, context);
+    return { context, calls, run: expression => vm.runInContext(expression, context) };
+}
+
+test('OIDC logout clears local state before opening provider choices', async () => {
+    const c = client({ token: 'oidc-token', marker: await hash('oidc-token') });
+    await c.run('logout()');
+    assert.deepEqual(c.calls, ['logout', 'cache', 'views', 'https://auth.m7.rs/application/o/jellyfin/end-session/']);
+});
+
+for (const [name, options] of [
+    ['Quick Connect-only login', {}],
+    ['Quick Connect after a previous OIDC login', { marker: await hash('old-oidc-token') }],
+    ['missing bearer', { token: null }],
+    ['blocked storage', { storageFails: true }],
+    ['unavailable Web Crypto', { marker: 'old', crypto: {} }]
+]) {
+    test(`${name} completes logout locally`, async () => {
+        const c = client(options);
+        await c.run('logout()');
+        assert.deepEqual(c.calls, ['logout', 'cache', 'views', 'https://media.example/base/web/#/login', 'reload']);
+    });
+}
+
+test('expired OIDC sessions never open provider logout', async () => {
+    const c = client({ token: 'oidc-token', marker: await hash('oidc-token') });
+    await c.run('logoutOnSessionExpired()');
+    assert.equal(c.calls.at(-1), 'reload');
+    assert.ok(!c.calls.some(value => value.includes('auth.m7.rs')));
+});
+
+test('concurrent logout and expired-session callbacks share local cleanup', async () => {
+    const c = client();
+    const first = c.run('logout()');
+    assert.equal(c.run('logoutOnSessionExpired()'), first);
+    await first;
+    assert.equal(c.calls.filter(value => value === 'logout').length, 1);
+    assert.equal(c.calls.filter(value => value === 'reload').length, 1);
+});
