@@ -0,0 +1,15 @@
+export async function isOidcLogin(token) {
+    if (!token) return false;
+
+    // A prior OIDC login must not send a later Quick Connect login to the IdP.
+    try {
+        const expected = localStorage.getItem('gablogin-oidc-token-hash');
+        if (!expected) return false;
+        const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(token));
+        const actual = Array.from(new Uint8Array(digest), b => b.toString(16).padStart(2, '0')).join('');
+        return actual === expected;
+    } catch {
+        // Missing storage/Web Crypto must never prevent local sign-out.
+        return false;
+    }
+}
