+import Events from 'utils/events';
+
+export function watchSessionExpiry(apiClient, isCurrent, onExpired) {
+    let expired = false;
+
+    const onFailure = status => {
+        if (status !== 401 || expired || !isCurrent()
+            || !apiClient.accessToken() || !apiClient.getCurrentUserId()) {
+            return;
+        }
+
+        expired = true;
+        onExpired();
+    };
+
+    Events.on(apiClient, 'requestfail', (_event, response) => {
+        onFailure(response.status);
+    });
+
+    apiClient._sdk.axiosInstance.interceptors.response.use(
+        response => response,
+        error => {
+            onFailure(error.response?.status);
+            return Promise.reject(error);
+        }
+    );
+}
