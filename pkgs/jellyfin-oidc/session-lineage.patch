+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Jellyfin.Data.Queries;
+using MediaBrowser.Controller.Devices;
+using MediaBrowser.Common.Configuration;
+using Microsoft.Extensions.Logging;
+
+namespace Jellyfin.Plugin.OIDC.Services;
+
+public sealed partial class StateManager
+{
+    private readonly object _trackingSync = new();
+    private readonly List<LogoutMarker> _logoutMarkers = [];
+    private string? _trackingPath;
+    private readonly IDeviceManager? _lineageDevices;
+
+    // Serializes token minting with logout, including Quick Connect's otherwise-public polling.
+    public SemaphoreSlim SessionMutation { get; } = new(1, 1);
+
+    public StateManager(ILogger<StateManager> logger, IApplicationPaths paths, IDeviceManager devices)
+        : this(logger, Path.Combine(paths.PluginConfigurationsPath, "Jellyfin.Plugin.OIDC.SessionLineage.json"))
+    {
+        _lineageDevices = devices;
+    }
+
+    internal StateManager(ILogger<StateManager> logger, string trackingPath) : this(logger)
+    {
+        _trackingPath = trackingPath;
+        if (File.Exists(trackingPath))
+        {
+            // Corrupt lineage must stop startup, not silently become an empty revocation table.
+            var snapshot = JsonSerializer.Deserialize<TrackingSnapshot>(File.ReadAllText(trackingPath))
+                ?? throw new InvalidDataException("Empty OIDC session lineage");
+            if (snapshot.Version != 1) throw new InvalidDataException("Unsupported OIDC session lineage version");
+            foreach (var session in snapshot.Sessions) _trackedSessions[TrackingKey(session)] = session;
+            _logoutMarkers.AddRange(snapshot.Logouts);
+        }
+    }
+
+    public static string HashToken(string token)
+        => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(token)));
+
+    public TrackedSession? FindForToken(Guid userId, string token)
+    {
+        return _trackedSessions.TryGetValue(HashToken(token), out var session) && session.UserId == userId
+            ? session : null;
+    }
+
+    private static string TrackingKey(TrackedSession session)
+        => session.TokenHash.Length > 0 ? session.TokenHash : session.SessionId;
+
+    public void UntrackSession(TrackedSession session) => UntrackBySessionId(TrackingKey(session));
+
+    private void PruneInactiveTokens()
+    {
+        if (_lineageDevices == null) return;
+        foreach (var session in _trackedSessions.Values.Where(s => s.TokenHash.Length > 0))
+        {
+            try
+            {
+                var devices = _lineageDevices.GetDevices(new DeviceQuery { UserId = session.UserId, DeviceId = session.DeviceId });
+                if (!devices.Items.Any(d => HashToken(d.AccessToken) == session.TokenHash))
+                    UntrackSession(session);
+            }
+            catch (Exception ex)
+            {
+                _logger.LogWarning(ex, "Could not check OIDC token liveness; retaining its lineage");
+            }
+        }
+    }
+
+    public bool IsRevoked(string issuer, string subject, string? sid, DateTimeOffset createdAt)
+    {
+        lock (_trackingSync)
+        {
+            return _logoutMarkers.Any(m => m.Issuer == issuer && createdAt <= m.CreatedAt &&
+                (!string.IsNullOrEmpty(m.Sid) ? m.Sid == sid : m.Subject == subject));
+        }
+    }
+
+    public DateTimeOffset RecordLogout(string issuer, string? subject, string? sid, string? eventId = null)
+    {
+        lock (_trackingSync)
+        {
+            if (string.IsNullOrEmpty(subject) && string.IsNullOrEmpty(sid))
+                throw new ArgumentException("Logout must identify a subject or session");
+            // Deduplicate the event, not the sid: a later logout must revoke later authorizations too.
+            var existing = _logoutMarkers.FirstOrDefault(m => m.Issuer == issuer &&
+                eventId != null && m.EventId == eventId);
+            if (existing != null) return existing.CreatedAt;
+            var marker = new LogoutMarker(issuer, subject, sid, DateTimeOffset.UtcNow, eventId);
+            _logoutMarkers.Add(marker);
+            try { SaveTracking(); }
+            catch { _logoutMarkers.Remove(marker); throw; }
+            return marker.CreatedAt;
+        }
+    }
+
+    private void SaveTracking()
+    {
+        if (_trackingPath == null) return;
+        Directory.CreateDirectory(Path.GetDirectoryName(_trackingPath)!);
+        var temporaryPath = _trackingPath + ".tmp";
+        var data = JsonSerializer.SerializeToUtf8Bytes(new TrackingSnapshot
+        {
+            Sessions = _trackedSessions.Values.ToList(),
+            Logouts = _logoutMarkers.ToList()
+        });
+        using (var file = new FileStream(temporaryPath, FileMode.Create, FileAccess.Write, FileShare.None))
+        {
+            if (!OperatingSystem.IsWindows())
+                File.SetUnixFileMode(temporaryPath, UnixFileMode.UserRead | UnixFileMode.UserWrite);
+            file.Write(data);
+            file.Flush(flushToDisk: true);
+        }
+        File.Move(temporaryPath, _trackingPath, overwrite: true);
+    }
+
+    private sealed class TrackingSnapshot
+    {
+        [JsonRequired]
+        public int Version { get; init; } = 1;
+        [JsonRequired]
+        public List<TrackedSession> Sessions { get; init; } = [];
+        [JsonRequired]
+        public List<LogoutMarker> Logouts { get; init; } = [];
+    }
+
+    private sealed record LogoutMarker(string Issuer, string? Subject, string? Sid, DateTimeOffset CreatedAt, string? EventId);
+}
