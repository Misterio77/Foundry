+
+namespace Jellyfin.Plugin.OIDC.Tests.Api;
+
+public partial class OidcControllerTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task Authenticate_AfterAppLogout_RequiresFreshAuthorizationNotFreshCallback(bool fresh)
+    {
+        ConfigureForSyncableUser("alice", "keycloak");
+        var (users, user) = MakeSyncableUser("alice", "keycloak");
+        using var state = new StateManager(NullLogger<StateManager>.Instance);
+        var cutoff = state.RecordLogout("https://idp.example/", "test-subject", "same-sid", "logout-a");
+        var startedAt = fresh ? cutoff.AddTicks(1) : cutoff.AddSeconds(-1);
+        var token = state.StoreAuthorizedSession(new AuthorizedSession
+        {
+            ProviderId = "keycloak",
+            Username = "alice",
+            Subject = "test-subject",
+            Issuer = "https://idp.example/",
+            Sid = "same-sid",
+            Roles = [],
+            AuthorizationStartedAt = startedAt
+        });
+        var sessions = Substitute.For<ISessionManager>();
+        sessions.AuthenticateDirect(Arg.Any<AuthenticationRequest>())
+            .Returns(Task.FromResult(new AuthenticationResult { AccessToken = "fresh-token" }));
+        var controller = MakeController(stateManager: state, userManager: users, sessionManager: sessions);
+        var result = await controller.Authenticate("keycloak", new AuthenticateRequest { Token = token! });
+        if (fresh)
+        {
+            Assert.IsType<OkObjectResult>(result);
+            Assert.Equal(startedAt, state.FindForToken(user.Id, "fresh-token")!.CreatedAt);
+        }
+        else
+        {
+            Assert.IsType<UnauthorizedObjectResult>(result);
+            await sessions.DidNotReceive().AuthenticateDirect(Arg.Any<AuthenticationRequest>());
+        }
+    }
+
+    [Theory]
+    [InlineData(false, false)]
+    [InlineData(true, false)]
+    [InlineData(true, true)]
+    public async Task BackchannelLogout_RevokesRootAndDescendantsOnly_PersistsAndRetries(bool restart, bool partialFailure)
+    {
+        const string authority = "https://203.0.113.10";
+        var directory = Path.Combine(Path.GetTempPath(), "oidc-revoke-" + Guid.NewGuid());
+        var path = Path.Combine(directory, "lineage.json");
+        try
+        {
+            var user = Guid.NewGuid();
+            var devices = new List<Device>();
+            var startedAt = DateTimeOffset.UtcNow.AddMinutes(-1);
+            var state = new StateManager(NullLogger<StateManager>.Instance, path);
+            foreach (var (device, sid) in new[] { ("parent", "sid-a"), ("child", "sid-a"), ("grandchild", "sid-a"), ("independent", "sid-b") })
+            {
+                var token = device + "-token";
+                devices.Add(new Device(user, "test", "1", "test", device) { AccessToken = token });
+                state.TrackSession(new TrackedSession
+                {
+                    ProviderId = "keycloak",
+                    Issuer = authority,
+                    Subject = "test",
+                    Sid = sid,
+                    UserId = user,
+                    DeviceId = device,
+                    SessionId = device,
+                    TokenHash = StateManager.HashToken(token),
+                    CreatedAt = startedAt
+                });
+            }
+            // A different token on the same device must not be swept up by DeviceId alone.
+            devices.Add(new Device(user, "test", "1", "test", "parent") { AccessToken = "unrelated-token" });
+            if (restart)
+            {
+                state.Dispose();
+                state = new StateManager(NullLogger<StateManager>.Instance, path);
+            }
+            using var ownedState = state;
+            var manager = Substitute.For<IDeviceManager>();
+            manager.GetDevices(Arg.Any<DeviceQuery>()).Returns(c =>
+            {
+                var q = c.Arg<DeviceQuery>();
+                return new QueryResult<Device> { Items = devices.Where(d => d.UserId == q.UserId && d.DeviceId == q.DeviceId).ToArray() };
+            });
+            var failOnce = partialFailure;
+            manager.DeleteDevice(Arg.Any<Device>()).Returns(c =>
+            {
+                var device = c.Arg<Device>();
+                if (failOnce && device.DeviceId == "child")
+                {
+                    failOnce = false;
+                    return Task.FromException(new IOException("transient deletion failure"));
+                }
+                devices.Remove(device);
+                return Task.CompletedTask;
+            });
+            var key = OidcTestTokens.CreateSigningKey();
+            var provider = new OidcProviderConfig
+            {
+                ProviderId = "keycloak",
+                Authority = authority,
+                ClientId = "test-client",
+                Enabled = true,
+                PinnedAuthority = authority,
+                PinnedIssuer = authority,
+                PinnedTokenEndpoint = authority + "/token",
+                PinnedJwksUri = authority + "/jwks",
+                PinnedAuthorizeEndpoint = authority + "/authorize",
+                PinnedUserInfoEndpoint = string.Empty
+            };
+            _fixture.SetConfiguration(new PluginConfiguration { Providers = [provider] });
+            var handler = RoutingHttpMessageHandler.ForFlow(
+                discovery: () => OidcTestTokens.DiscoveryJson(authority), token: () => "{}",
+                jwks: () => OidcTestTokens.JwksJson(key));
+            var sessions = Substitute.For<ISessionManager>();
+            var controller = MakeController(stateManager: state, deviceManager: manager,
+                sessionManager: sessions, httpHandler: handler);
+            var logout = OidcTestTokens.SignRs256(key, authority, provider.ClientId,
+                [EventsClaim, new Claim("sub", "test"), new Claim("sid", "sid-a"), new Claim("jti", "logout-a")]);
+            var result = await controller.BackchannelLogout("keycloak", logout);
+            if (partialFailure)
+            {
+                Assert.Equal(503, Assert.IsType<ObjectResult>(result).StatusCode);
+                Assert.Single(state.FindTracked(authority, "test", "sid-a"));
+                // A new verified authorization may reuse the sid while the old logout awaits retry.
+                devices.Add(new Device(user, "test", "1", "test", "fresh") { AccessToken = "fresh-token" });
+                state.TrackSession(new TrackedSession
+                {
+                    ProviderId = "keycloak",
+                    Issuer = authority,
+                    Subject = "test",
+                    Sid = "sid-a",
+                    UserId = user,
+                    DeviceId = "fresh",
+                    SessionId = "fresh",
+                    TokenHash = StateManager.HashToken("fresh-token")
+                });
+                result = await controller.BackchannelLogout("keycloak", logout);
+            }
+            Assert.IsType<OkResult>(result);
+            var expected = partialFailure
+                ? new[] { "fresh-token", "independent-token", "unrelated-token" }
+                : new[] { "independent-token", "unrelated-token" };
+            Assert.Equal(expected, devices.Select(d => d.AccessToken).Order().ToArray());
+            Assert.Equal(partialFailure ? 1 : 0, state.FindTracked(authority, "test", "sid-a").Count);
+            Assert.Single(state.FindTracked(authority, "test", "sid-b"));
+            using (var finalRestart = new StateManager(NullLogger<StateManager>.Instance, path))
+            {
+                Assert.True(finalRestart.IsRevoked(authority, "test", "sid-a", startedAt));
+                Assert.Single(finalRestart.FindTracked(authority, "test", "sid-b"));
+                if (partialFailure)
+                {
+                    var fresh = Assert.Single(finalRestart.FindTracked(authority, "test", "sid-a"));
+                    Assert.False(finalRestart.IsRevoked(authority, "test", "sid-a", fresh.CreatedAt));
+                }
+            }
+            if (partialFailure)
+            {
+                var secondLogout = OidcTestTokens.SignRs256(key, authority, provider.ClientId,
+                    [EventsClaim, new Claim("sub", "test"), new Claim("sid", "sid-a"), new Claim("jti", "logout-b")]);
+                Assert.IsType<OkResult>(await controller.BackchannelLogout("keycloak", secondLogout));
+                Assert.Empty(state.FindTracked(authority, "test", "sid-a"));
+                Assert.DoesNotContain(devices, d => d.AccessToken == "fresh-token");
+            }
+            await sessions.DidNotReceive().RevokeUserTokens(Arg.Any<Guid>(), Arg.Any<string>());
+        }
+        finally
+        {
+            if (Directory.Exists(directory)) Directory.Delete(directory, recursive: true);
+        }
+    }
+}
