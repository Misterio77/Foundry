+using System.Collections.Concurrent;
+using Jellyfin.Data.Queries;
+using MediaBrowser.Controller.Authentication;
+using MediaBrowser.Controller.Devices;
+using MediaBrowser.Controller.Net;
+using MediaBrowser.Controller.QuickConnect;
+using MediaBrowser.Controller.Session;
+using MediaBrowser.Model.QuickConnect;
+using Microsoft.AspNetCore.Http;
+using Microsoft.Extensions.DependencyInjection;
+
+namespace Jellyfin.Plugin.OIDC.Services;
+
+public sealed class LinkedQuickConnect(
+    IQuickConnect inner,
+    StateManager state,
+    IDeviceManager devices,
+    IHttpContextAccessor context) : IQuickConnect
+{
+    private readonly ConcurrentDictionary<string, QuickConnectResult> _pending = new();
+
+    public bool IsEnabled => inner.IsEnabled;
+
+    public QuickConnectResult TryConnect(AuthorizationInfo authorizationInfo)
+    {
+        foreach (var entry in _pending)
+        {
+            if (entry.Value.DateAdded < DateTime.UtcNow.AddMinutes(-10))
+                _pending.TryRemove(entry.Key, out _);
+        }
+        if (_pending.Count >= 500) throw new AuthenticationException("Too many pending Quick Connect requests");
+        var result = inner.TryConnect(authorizationInfo);
+        _pending[result.Code] = result;
+        return result;
+    }
+
+    public QuickConnectResult CheckRequestStatus(string secret) => inner.CheckRequestStatus(secret);
+
+    public AuthenticationResult GetAuthorizedRequest(string secret)
+    {
+        var result = inner.GetAuthorizedRequest(secret);
+        state.SessionMutation.Wait();
+        try
+        {
+            var userId = result.SessionInfo?.UserId ?? Guid.Empty;
+            var tracked = state.FindForToken(userId, result.AccessToken);
+            if (tracked == null || state.IsRevoked(tracked.Issuer, tracked.Subject, tracked.Sid, tracked.CreatedAt))
+                throw new AuthenticationException("Quick Connect authorization is no longer valid");
+            return result;
+        }
+        finally { state.SessionMutation.Release(); }
+    }
+
+    public Task<bool> AuthorizeRequest(Guid userId, string code)
+        => AuthorizeAsync(userId, code, null);
+
+    public Task<bool> AuthorizeOidcRequest(Guid userId, string code, AuthorizedSession session)
+    {
+        if (string.IsNullOrEmpty(session.Subject) || string.IsNullOrEmpty(session.Issuer))
+            throw new AuthenticationException("OIDC identity is required for Quick Connect");
+        return AuthorizeAsync(userId, code, new TrackedSession
+        {
+            ProviderId = session.ProviderId,
+            Issuer = session.Issuer,
+            Subject = session.Subject,
+            Sid = session.Sid,
+            UserId = userId,
+            DeviceId = string.Empty,
+            SessionId = string.Empty,
+            CreatedAt = session.AuthorizationStartedAt
+        });
+    }
+
+    private async Task<bool> AuthorizeAsync(Guid userId, string code, TrackedSession? parent)
+    {
+        await state.SessionMutation.WaitAsync().ConfigureAwait(false);
+        try
+        {
+            if (parent == null)
+            {
+                var http = context.HttpContext ?? throw new AuthenticationException("An approving session is required");
+                var auth = await http.RequestServices.GetRequiredService<IAuthorizationContext>()
+                    .GetAuthorizationInfo(http).ConfigureAwait(false);
+                if (!auth.IsAuthenticated || auth.IsApiKey || string.IsNullOrEmpty(auth.Token))
+                    throw new AuthenticationException("An approving user token is required");
+
+                // DeviceId in a request header is caller-controlled; resolve the actual token instead.
+                var device = devices.GetDevices(new DeviceQuery { AccessToken = auth.Token }).Items.FirstOrDefault();
+                if (device == null || device.UserId != userId)
+                    throw new AuthenticationException("The approving session is no longer valid");
+                parent = state.FindForToken(userId, auth.Token)
+                    ?? throw new AuthenticationException("Sign in with OIDC again before authorizing devices");
+            }
+
+            if (parent.UserId != userId || state.IsRevoked(parent.Issuer, parent.Subject, parent.Sid, parent.CreatedAt))
+                throw new AuthenticationException("The authorizing OIDC session has been revoked");
+            if (!_pending.TryGetValue(code, out var pending))
+                throw new AuthenticationException("Unknown or expired Quick Connect code");
+            if (!await inner.AuthorizeRequest(userId, code).ConfigureAwait(false)) return false;
+
+            var result = inner.GetAuthorizedRequest(pending.Secret);
+            try
+            {
+                state.TrackSession(new TrackedSession
+                {
+                    ProviderId = parent.ProviderId,
+                    Issuer = parent.Issuer,
+                    Subject = parent.Subject,
+                    Sid = parent.Sid,
+                    UserId = userId,
+                    DeviceId = pending.DeviceId,
+                    SessionId = result.SessionInfo?.Id ?? pending.DeviceId,
+                    TokenHash = StateManager.HashToken(result.AccessToken),
+                    CreatedAt = parent.CreatedAt
+                });
+            }
+            catch
+            {
+                // Never expose a token whose lineage could not be durably recorded.
+                foreach (var device in devices.GetDevices(new DeviceQuery { AccessToken = result.AccessToken }).Items)
+                    await devices.DeleteDevice(device).ConfigureAwait(false);
+                throw;
+            }
+            _pending.TryRemove(code, out _);
+            return true;
+        }
+        finally { state.SessionMutation.Release(); }
+    }
+}
