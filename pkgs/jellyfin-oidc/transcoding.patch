+    public void Transcoding_LegacyXmlAndExplicitOverridesRoundTrip(bool legacy)
+    {
+        var serializer = new System.Xml.Serialization.XmlSerializer(typeof(RoleMapping));
+        using var reader = new StringReader(
+            $"<RoleMapping><EnableTranscoding>{legacy.ToString().ToLowerInvariant()}</EnableTranscoding></RoleMapping>");
+        var mapping = Assert.IsType<RoleMapping>(serializer.Deserialize(reader));
+        Assert.Equal(legacy, mapping.EnableTranscoding);
+        Assert.Null(mapping.EnableAudioTranscoding);
+        Assert.Null(mapping.EnableVideoTranscoding);
+        mapping.EnableAudioTranscoding = true;
+        mapping.EnableVideoTranscoding = false;
+        using var writer = new StringWriter();
+        serializer.Serialize(writer, mapping);
+        using var roundTripReader = new StringReader(writer.ToString());
+        var roundTrip = Assert.IsType<RoleMapping>(serializer.Deserialize(roundTripReader));
+        Assert.Equal(legacy, roundTrip.EnableTranscoding);
+        Assert.True(roundTrip.EnableAudioTranscoding);
+        Assert.False(roundTrip.EnableVideoTranscoding);
