@@ -0,0 +1,100 @@
+import assert from 'node:assert/strict';
+import { webcrypto } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import vm from 'node:vm';
+
+function page(name, { status = 200, body = '', language = 'en', token = 'oidc-token' } = {}) {
+    const html = readFileSync(`Jellyfin.Plugin.OIDC/Configuration/${name}.html`, 'utf8');
+    const elements = new Map();
+    for (const [, id] of html.matchAll(/\bid="([^"]+)"/g)) {
+        elements.set(id, { textContent: '', value: '', hidden: id === 'signin', disabled: false,
+            focus() {}, select() {}, setAttribute() {}, addEventListener(event, callback) { this[event] = callback; } });
+    }
+    elements.get('oidc-data').textContent = JSON.stringify({
+        token: 'approval-token', providerId: 'authentik', credentialsKey: 'credentials', deviceIdKey: 'device-id'
+    });
+    elements.get('oidc-messages').textContent = html.match(/id="oidc-messages">([\s\S]*?)<\/script>/)[1];
+    const requests = [];
+    const storage = new Map();
+    const location = { href: 'https://media.example/base/sso/OIDC/Callback/authentik' };
+    const context = vm.createContext({
+        URL, TextEncoder, Uint8Array, crypto: webcrypto,
+        navigator: { languages: [language], userAgent: 'Test' },
+        document: { documentElement: {}, getElementById: id => elements.get(id), querySelectorAll: () => [] },
+        localStorage: { getItem: key => storage.get(key), setItem: (key, value) => storage.set(key, value) },
+        window: { location },
+        fetch: async (url, options) => {
+            requests.push({ url: String(url), options });
+            return { status, ok: status >= 200 && status < 300, text: async () => body,
+                json: async () => ({ AccessToken: token, ServerId: 'server', User: { Id: 'user' } }) };
+        }
+    });
+    const script = [...html.matchAll(/<script nonce="__CSP_NONCE__">([\s\S]*?)<\/script>/g)][0][1];
+    vm.runInContext(script, context);
+    return { elements, requests, storage, location };
+}
+
+const settled = () => new Promise(resolve => setImmediate(resolve));
+
+for (const code of ['123', '', 'abcdef', '1234567', '１２３４５６']) {
+    test(`malformed code ${JSON.stringify(code)} is rejected before fetching`, () => {
+        const p = page('QuickConnectPage');
+        p.elements.get('code').value = code;
+        p.elements.get('submit').click();
+        assert.equal(p.requests.length, 0);
+        assert.match(p.elements.get('msg').textContent, /six digits/);
+    });
+}
+
+for (const status of [401, 403]) {
+    test(`${status} offers reauthentication with the entered code and base path`, async () => {
+        const p = page('QuickConnectPage', { status, body: '"Quick Connect is not active on this server."' });
+        p.elements.get('code').value = '012345';
+        p.elements.get('submit').click();
+        await settled();
+        assert.match(p.elements.get('msg').textContent, /authorization has expired/);
+        assert.equal(p.elements.get('signin').hidden, false);
+        assert.equal(p.elements.get('signin').href, 'https://media.example/base/sso/OIDC/QuickConnect/authentik?user_code=012345');
+        assert.equal(p.elements.get('submit').disabled, false);
+    });
+}
+
+for (const body of ['"That code wasn\'t recognized."', 'That code wasn\'t recognized.']) {
+    test(`API error is displayed without JSON quotation marks: ${body}`, async () => {
+        const p = page('QuickConnectPage', { status: 400, body });
+        p.elements.get('code').value = '123456';
+        p.elements.get('submit').click();
+        await settled();
+        assert.equal(p.elements.get('msg').textContent, "That code wasn't recognized.");
+        assert.equal(p.elements.get('submit').disabled, false);
+    });
+}
+
+test('valid approval disables the form after success', async () => {
+    const p = page('QuickConnectPage');
+    p.elements.get('code').value = '012345';
+    p.elements.get('submit').click();
+    await settled();
+    assert.equal(p.requests.length, 1);
+    assert.equal(JSON.parse(p.requests[0].options.body).Code, '012345');
+    assert.equal(p.elements.get('code').disabled, true);
+    assert.equal(p.elements.get('submit').disabled, true);
+    assert.match(p.elements.get('msg').textContent, /Approved!/);
+});
+
+test('Portuguese validation is localized', () => {
+    const p = page('QuickConnectPage', { language: 'pt-BR' });
+    p.elements.get('submit').click();
+    assert.equal(p.elements.get('msg').textContent, 'Digite os seis dígitos exibidos no dispositivo.');
+});
+
+test('OIDC callback stores the matching bearer hash before redirecting', async () => {
+    const p = page('CallbackPage', { token: 'new-oidc-token' });
+    // Web Crypto runs asynchronously outside the VM's promise queue.
+    for (let i = 0; i < 100 && !p.storage.has('gablogin-oidc-token-hash'); i++) await settled();
+    const expected = Buffer.from(await webcrypto.subtle.digest('SHA-256', new TextEncoder().encode('new-oidc-token'))).toString('hex');
+    assert.equal(p.storage.get('gablogin-oidc-token-hash'), expected);
+    assert.equal(JSON.parse(p.storage.get('credentials')).Servers[0].AccessToken, 'new-oidc-token');
+    assert.equal(p.location.href, 'https://media.example/base/');
+});
