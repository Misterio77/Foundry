+    {
+        var key = OidcTestTokens.CreateSigningKey();
+        var nonce = "";
+        var handler = RoutingHttpMessageHandler.ForFlow(
+            () => OidcTestTokens.DiscoveryJson(Authority),
+            () => OidcTestTokens.TokenResponseJson(
+                OidcTestTokens.IdToken(key, Authority, ClientId, nonce, groups: ["staff"])),
+            () => OidcTestTokens.JwksJson(key));
+        var (controller, stateManager) = Build(handler, Provider());
+        controller.Request.QueryString = userCode == null
+            ? QueryString.Empty
+            : new QueryString("?user_code=" + userCode);
+
+        var redirect = Assert.IsType<RedirectResult>(await controller.QuickConnectStart(ProviderId));
+        Assert.DoesNotContain("user_code", redirect.Url);
+        var query = System.Web.HttpUtility.ParseQueryString(new Uri(redirect.Url).Query);
+        nonce = query["nonce"]!;
+        var state = query["state"]!;
+        controller.Request.Headers["Cookie"] = controller.Response.Headers["Set-Cookie"].ToString().Split(';')[0];
+        controller.Request.QueryString = new QueryString("?user_code=654321");
+
+        var content = Assert.IsType<ContentResult>(await controller.Callback(ProviderId, "auth-code", state));
