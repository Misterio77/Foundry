+++ b/Jellyfin.Plugin.OIDC.Tests/Services/EmbeddedPageTests.cs
@@ -1,5 +1,7 @@
 using System;
 using System.Collections.Generic;
+using System.Text.Json;
+using System.Text.RegularExpressions;
 using Jellyfin.Plugin.OIDC.Services;
 using Xunit;
 
@@ -80,4 +82,27 @@
         Assert.Contains("{\"token\":\"__CSP_NONCE__\"}", html);
         Assert.Contains("<style nonce=\"realnonce\">", html);
     }
+
+    [Theory]
+    [InlineData("QuickConnectPage.html")]
+    [InlineData("CallbackPage.html")]
+    public void Render_LocalizedPagesHaveMatchingNonemptyEnglishAndPortugueseMessages(string page)
+    {
+        var html = EmbeddedPage.Render(page, CallbackValues);
+        var match = Regex.Match(html, "<script type=\"application/json\" id=\"oidc-messages\">(.*?)</script>", RegexOptions.Singleline);
+        Assert.True(match.Success);
+        using var document = JsonDocument.Parse(match.Groups[1].Value);
+        var english = document.RootElement.GetProperty("en");
+        var portuguese = document.RootElement.GetProperty("pt-BR");
+        foreach (var message in english.EnumerateObject())
+        {
+            Assert.False(string.IsNullOrWhiteSpace(message.Value.GetString()));
+            Assert.False(string.IsNullOrWhiteSpace(portuguese.GetProperty(message.Name).GetString()));
+        }
+        foreach (var message in portuguese.EnumerateObject())
+        {
+            Assert.True(english.TryGetProperty(message.Name, out _));
+        }
+    }
+
 }
