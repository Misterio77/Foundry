@@ -0,0 +1,252 @@ export function fixture() {
+import { MediaServerType } from '@server/constants/server';
+import { Settings } from '@server/lib/settings';
+import { loadDeclarativeConfig } from '@server/lib/settings/declarative';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, it } from 'node:test';
+
+export function fixture() {
+  return {
+    version: 1,
+    owner: {
+      provider: 'authentik',
+      subject: 'owner-sub',
+      email: 'owner@example.com',
+      username: 'owner',
+    },
+    settings: {
+      main: { applicationUrl: 'https://requests.example.com' },
+      notifications: {
+        agents: {
+          email: {
+            enabled: true,
+            options: { smtpHost: 'localhost', authPass: { file: 'smtp.key' } },
+          },
+        },
+      },
+      jobs: { 'radarr-scan': { schedule: '0 15 4 * * *' } },
+      jellyfin: {
+        name: 'Jellyfin',
+        ip: 'localhost',
+        port: 8096,
+        serverId: 'server',
+        apiKey: { file: 'jellyfin.key' },
+        libraries: [
+          { id: 'movies', name: 'Movies', enabled: true, type: 'movie' },
+        ],
+      },
+      oidc: {
+        providers: [
+          {
+            slug: 'authentik',
+            name: 'SSO',
+            issuerUrl: 'https://auth.example.com/application/o/seerr/',
+            clientId: 'seerr',
+            clientSecret: { file: 'oidc.key' },
+            permissionsClaim: 'seerr_permissions',
+          },
+        ],
+      },
+      radarr: [
+        {
+          id: 1,
+          name: 'Radarr',
+          hostname: 'localhost',
+          port: 7878,
+          apiKey: { file: 'radarr.key' },
+          activeProfileId: 1,
+          activeProfileName: 'HD',
+          activeDirectory: '/movies',
+          isDefault: true,
+        },
+      ],
+    },
+  };
+}
+
+describe('declarative configuration', () => {
+  let directory: string;
+  let filename: string;
+  let settings: Settings;
+  beforeEach(async () => {
+    directory = await fs.mkdtemp(path.join(os.tmpdir(), 'seerr-declarative-'));
+    filename = path.join(directory, 'config.json');
+    await fs.writeFile(filename, JSON.stringify(fixture()));
+    await Promise.all(
+      ['jellyfin', 'oidc', 'radarr', 'smtp'].map((name) =>
+        fs.writeFile(path.join(directory, `${name}.key`), `${name}-secret\n`)
+      )
+    );
+    settings = new Settings(undefined, path.join(directory, 'settings.json'));
+    process.env.SEERR_CONFIG_FILE = filename;
+  });
+  afterEach(async () => {
+    delete process.env.SEERR_CONFIG_FILE;
+    await fs.rm(directory, { recursive: true, force: true });
+  });
+
+  it('resolves file-backed secrets and applies connection defaults', async () => {
+    const config = await loadDeclarativeConfig(filename);
+    assert.equal(config.settings.jellyfin?.apiKey, 'jellyfin-secret');
+    assert.equal(
+      config.settings.oidc?.providers?.[0]?.clientSecret,
+      'oidc-secret'
+    );
+    assert.equal(config.settings.radarr?.[0]?.apiKey, 'radarr-secret');
+    assert.equal(config.settings.radarr?.[0]?.minimumAvailability, 'released');
+    assert.equal(
+      config.settings.main?.mediaServerType,
+      MediaServerType.JELLYFIN
+    );
+    assert.equal(config.settings.main?.localLogin, false);
+    assert.equal(config.settings.public?.initialized, true);
+    assert.equal(
+      config.settings.notifications?.agents?.email?.options?.authPass,
+      'smtp-secret'
+    );
+    assert.equal(
+      config.settings.jobs?.['radarr-scan']?.schedule,
+      '0 15 4 * * *'
+    );
+  });
+
+  for (const [name, mutate] of Object.entries<
+    (data: ReturnType<typeof fixture>) => void
+  >({
+    'unknown fields': (data) => {
+      Object.assign(data.settings, { typo: true });
+    },
+    'unknown nested fields': (data) => {
+      Object.assign(data.settings.main, { typo: true });
+    },
+    'wrong types': (data) => {
+      Object.assign(data.settings.jellyfin, { port: '8096' });
+    },
+    'missing permissions policy': (data) => {
+      Reflect.deleteProperty(
+        data.settings.oidc.providers[0],
+        'permissionsClaim'
+      );
+    },
+    'unconfigured owner provider': (data) => {
+      data.owner.provider = 'other';
+    },
+    'duplicate providers': (data) => {
+      data.settings.oidc.providers.push(data.settings.oidc.providers[0]);
+    },
+    'duplicate connection ids': (data) => {
+      data.settings.radarr.push(data.settings.radarr[0]);
+    },
+    'multiple defaults': (data) => {
+      data.settings.radarr.push({ ...data.settings.radarr[0], id: 2 });
+    },
+    'mutable login flags': (data) => {
+      Object.assign(data.settings.main, { localLogin: true });
+    },
+    'unsupported versions': (data) => {
+      data.version = 2;
+    },
+    'unknown notification options': (data) => {
+      Object.assign(data.settings.notifications.agents.email.options, {
+        typo: true,
+      });
+    },
+    'unknown jobs': (data) => {
+      Object.assign(data.settings.jobs, {
+        imaginary: { schedule: '0 * * * *' },
+      });
+    },
+    'invalid schedules': (data) => {
+      data.settings.jobs['radarr-scan'].schedule = 'never gonna give you up';
+    },
+  })) {
+    it(`rejects ${name} without leaking input values`, async () => {
+      const data = fixture();
+      mutate(data);
+      await fs.writeFile(filename, JSON.stringify(data));
+      await assert.rejects(
+        loadDeclarativeConfig(filename),
+        /^Error: Invalid declarative configuration;/
+      );
+    });
+  }
+
+  it('fails closed on missing or empty secrets', async () => {
+    await fs.rm(path.join(directory, 'oidc.key'));
+    await assert.rejects(
+      loadDeclarativeConfig(filename),
+      /Unable to read.*secret/
+    );
+    await fs.writeFile(path.join(directory, 'oidc.key'), '\n');
+    await assert.rejects(loadDeclarativeConfig(filename), /Empty.*secret/);
+  });
+
+  it('persists only generated identity, not configuration or connection secrets', async () => {
+    await settings.load();
+    assert.equal(settings.public.initialized, true);
+    assert.equal(settings.fullPublicSettings.declarative, true);
+    const statePath = path.join(directory, 'declarative-state.json');
+    const state = JSON.parse(await fs.readFile(statePath, 'utf8'));
+    assert.deepEqual(Object.keys(state).sort(), [
+      'clientId',
+      'main',
+      'sessionSecret',
+      'vapidPrivate',
+      'vapidPublic',
+    ]);
+    assert.deepEqual(Object.keys(state.main), ['apiKey']);
+    assert.equal((await fs.stat(statePath)).mode & 0o777, 0o600);
+    assert.equal(
+      await fs.readFile(statePath, 'utf8').then((s) => s.includes('-secret')),
+      false
+    );
+    const sessionSecret = settings.sessionSecret;
+    const clientId = settings.clientId;
+    settings.main.applicationTitle = 'mutable drift';
+    await settings.save();
+    await settings.load();
+    assert.equal(settings.main.applicationTitle, 'Seerr');
+    assert.equal(settings.sessionSecret, sessionSecret);
+    assert.equal(settings.clientId, clientId);
+  });
+
+  it('imports only identity from legacy settings, without changing the legacy file', async () => {
+    const legacy = {
+      clientId: 'stable-id',
+      sessionSecret: 'stable-session',
+      main: {
+        apiKey: 'stable-api',
+        applicationTitle: 'stale',
+        localLogin: true,
+      },
+      jellyfin: { apiKey: 'old-secret' },
+    };
+    await fs.writeFile(
+      path.join(directory, 'settings.json'),
+      JSON.stringify(legacy)
+    );
+    await settings.load();
+    assert.equal(settings.clientId, 'stable-id');
+    assert.equal(settings.sessionSecret, 'stable-session');
+    assert.equal(settings.main.apiKey, 'stable-api');
+    assert.equal(settings.main.applicationTitle, 'Seerr');
