@@ -0,0 +1,79 @@
+import dataSource, { getRepository } from '@server/datasource';
+import { LinkedAccount } from '@server/entity/LinkedAccount';
+import { User } from '@server/entity/User';
+import { Permission } from '@server/lib/permissions';
+import { bootstrapDeclarativeOwner } from '@server/lib/settings/bootstrap';
+import { setupTestDb } from '@server/test/db';
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+setupTestDb();
+const owner = {
+  provider: 'authentik',
+  subject: 'owner-sub',
+  email: 'owner@example.com',
+  username: 'owner',
+};
+
+describe('declarative owner bootstrap', () => {
+  it('creates owner 1 and a pinned identity on an empty database, idempotently', async () => {
+    await dataSource.dropDatabase();
+    await dataSource.synchronize();
+    await bootstrapDeclarativeOwner(owner);
+    await bootstrapDeclarativeOwner(owner);
+    const user = await getRepository(User).findOneOrFail({
+      where: { id: 1 },
+      relations: { linkedAccounts: true },
+    });
+    assert.equal(user.email, owner.email);
+    assert.equal(user.permissions, Permission.ADMIN);
+    assert.equal(user.linkedAccounts.length, 1);
+    assert.equal(user.linkedAccounts[0].sub, owner.subject);
+  });
+
+  it('explicitly provisions the existing owner rather than matching by email', async () => {
+    await bootstrapDeclarativeOwner(owner);
+    assert.equal(
+      (await getRepository(User).findOneOrFail({ where: { id: 1 } })).email,
+      owner.email
+    );
+    assert.equal(await getRepository(User).count(), 2);
+  });
+
+  it('rejects an identity already belonging to someone else', async () => {
+    const other = await getRepository(User).findOneOrFail({ where: { id: 2 } });
+    await getRepository(LinkedAccount).save(
+      new LinkedAccount({
+        user: other,
+        provider: owner.provider,
+        sub: owner.subject,
+        username: 'other',
+      })
+    );
+    await assert.rejects(bootstrapDeclarativeOwner(owner), /different user/);
+    assert.equal(
+      (await getRepository(User).findOneOrFail({ where: { id: 1 } })).email,
+      'admin@seerr.dev'
+    );
+  });
+
+  it('rejects replacing the pinned owner identity', async () => {
+    await bootstrapDeclarativeOwner(owner);
+    await assert.rejects(
+      bootstrapDeclarativeOwner({ ...owner, subject: 'replacement' }),
+      /different identity/
+    );
+    assert.equal(await getRepository(LinkedAccount).count(), 1);
+  });
+
+  it('rolls back when the configured email belongs to another user', async () => {
+    await assert.rejects(
+      bootstrapDeclarativeOwner({ ...owner, email: 'demo@seerr.dev' })
+    );
+    assert.equal(
+      (await getRepository(User).findOneOrFail({ where: { id: 1 } })).email,
+      'admin@seerr.dev'
+    );
+    assert.equal(await getRepository(LinkedAccount).count(), 0);
+  });
+});
diff --git a/server/lib/settings/bootstrap.ts b/server/lib/settings/bootstrap.ts
new file mode 100644
index 0000000000..6d9b857d0b
--- /dev/null
+++ b/server/lib/settings/bootstrap.ts
@@ -0,0 +1,63 @@ export async function bootstrapDeclarativeOwner(
+import { UserType } from '@server/constants/user';
+import dataSource from '@server/datasource';
+import { LinkedAccount } from '@server/entity/LinkedAccount';
+import { User } from '@server/entity/User';
+import { Permission } from '@server/lib/permissions';
+import type { DeclarativeOwner } from '@server/lib/settings/declarative';
+
+export async function bootstrapDeclarativeOwner(
+  owner: DeclarativeOwner
+): Promise<void> {
+  await dataSource.transaction(async (manager) => {
+    const users = manager.getRepository(User);
+    const links = manager.getRepository(LinkedAccount);
+    let user = await users.findOne({
+      where: { id: 1 },
+      relations: { linkedAccounts: true },
+    });
+    const identity = await links.findOne({
+      where: { provider: owner.provider, sub: owner.subject },
+      relations: { user: true },
+    });
+    if (identity && identity.user.id !== 1)
+      throw new Error('Configured owner identity belongs to a different user');
+    if (!user) {
+      if (await users.count())
+        throw new Error(
+          'Cannot bootstrap owner into a database without user 1 that contains other users'
+        );
+      user = new User({
+        id: 1,
+        email: owner.email,
+        username: owner.username,
+        userType: UserType.LOCAL,
+        permissions: Permission.ADMIN,
+        avatar: '',
+        plexToken: '',
+      });
+    }
+    const ownerLinks = user.linkedAccounts ?? [];
+    if (
+      ownerLinks.some(
+        (link) => link.provider === owner.provider && link.sub !== owner.subject
+      )
+    ) {
+      throw new Error(
+        'Existing owner has a different identity for the configured provider'
+      );
+    }
+    user.email = owner.email;
+    user.username = owner.username;
+    user.permissions = Permission.ADMIN;
+    await users.save(user);
+    if (!identity)
+      await links.save(
+        new LinkedAccount({
+          user,
+          provider: owner.provider,
+          sub: owner.subject,
+          username: owner.username,
+        })
+      );
+  });
+}
