+    const providers = config.settings.oidc.providers;
+    if (!providers.some((p) => p.slug === config.owner.provider))
+      ctx.addIssue({
+        code: 'custom',
+        message: 'Owner provider is not configured',
+        path: ['owner', 'provider'],
+      });
+    for (const [name, entries] of [
+      ['providers', providers],
+      ['radarr', config.settings.radarr],
+      ['sonarr', config.settings.sonarr],
+    ] as const) {
+      const ids = entries.map((entry) =>
+        'slug' in entry ? entry.slug : entry.id
+      );
+      if (new Set(ids).size !== ids.length)
+        ctx.addIssue({
+          code: 'custom',
+          message: `Duplicate ${name} identifiers`,
+          path: ['settings', name],
+        });
+    }
+    for (const name of ['radarr', 'sonarr'] as const) {
+      for (const is4k of [false, true]) {
+        if (
+          config.settings[name].filter((s) => s.isDefault && s.is4k === is4k)
+            .length > 1
+        )
+          ctx.addIssue({
+            code: 'custom',
+            message: 'Multiple default servers for the same resolution',
+            path: ['settings', name],
+          });
+      }
+    }
+  });
+
+type ResolvedSecrets<T> = T extends { file: string }
+  ? string
+  : T extends object
+    ? { [K in keyof T]: ResolvedSecrets<T[K]> }
+    : T;
+
+export type DeclarativeOwner = z.infer<typeof configSchema>['owner'];
+export interface DeclarativeConfig {
+  owner: DeclarativeOwner;
+  settings: DeepPartial<AllSettings>;
+}
+
+export async function loadDeclarativeConfig(
+  filename: string
+): Promise<DeclarativeConfig> {
+  // Never include parser errors or input values: configuration may contain secrets.
+  let parsed: z.infer<typeof configSchema>;
+  try {
+    parsed = configSchema.parse(
+      JSON.parse(await fs.readFile(filename, 'utf8'))
+    );
+  } catch (error) {
+    const fields =
+      error instanceof z.ZodError
+        ? error.issues
+            .map(
+              (issue) => `${issue.path.join('.') || '<root>'} (${issue.code})`
+            )
+            .join(', ')
+        : 'invalid JSON or unreadable file';
+    throw new Error(`Invalid declarative configuration; ${fields}`);
+  }
+  const readSecret = async (
+    value: z.infer<typeof secretValue>
+  ): Promise<string> => {
+    if (typeof value === 'string') return value;
+    let content: string;
+    try {
+      content = await fs.readFile(
+        path.resolve(path.dirname(filename), value.file),
+        'utf8'
+      );
+    } catch {
+      throw new Error('Unable to read a declarative configuration secret file');
+    }
+    content = content.replace(/\r?\n$/, '');
+    if (!content) throw new Error('Empty declarative configuration secret');
+    return content;
+  };
+  const resolveSecrets = async (value: unknown): Promise<unknown> => {
+    if (Array.isArray(value)) return Promise.all(value.map(resolveSecrets));
+    if (value !== null && typeof value === 'object') {
+      if ('file' in value && typeof value.file === 'string')
+        return readSecret({ file: value.file });
+      return Object.fromEntries(
+        await Promise.all(
+          Object.entries(value).map(async ([key, item]) => [
+            key,
+            await resolveSecrets(item),
+          ])
+        )
+      );
+    }
+    return value;
+  };
+  const owner = parsed.owner;
+  const settings = (await resolveSecrets(parsed.settings)) as ResolvedSecrets<
+    typeof parsed.settings
+  >;
+  return {
+    owner,
+    settings: {
+      ...settings,
+      main: {
+        ...settings.main,
+        oidcLogin: true,
+        localLogin: false,
+        mediaServerLogin: false,
+        newPlexLogin: false,
+        mediaServerType: MediaServerType.JELLYFIN,
+      },
+      public: { initialized: true },
+      metadataSettings: settings.metadataSettings as
+        | AllSettings['metadataSettings']
+        | undefined,
+    },
+  };
+}
