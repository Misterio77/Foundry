diff --git a/server/routes/declarative.test.ts b/server/routes/declarative.test.ts
new file mode 100644
index 0000000000..7fd0fa0f0e
--- /dev/null
+++ b/server/routes/declarative.test.ts
@@ -0,0 +1,68 @@
+import { User } from '@server/entity/User';
+import { getSettings } from '@server/lib/settings';
+import settingsRoutes from '@server/routes/settings';
+import userRoutes from '@server/routes/user';
+import express from 'express';
+import assert from 'node:assert/strict';
+import { afterEach, beforeEach, describe, it, mock } from 'node:test';
+import request from 'supertest';
+
+describe('declarative API policy', () => {
+  const app = express();
+  app.use(express.json());
+  app.use((req, _res, next) => {
+    req.user = new User({ id: 1, permissions: 2 });
+    next();
+  });
+  app.use('/settings', settingsRoutes);
+  app.use('/user', userRoutes);
+
+  beforeEach(() => {
+    mock.getter(getSettings(), 'declarative', () => ({
+      owner: {
+        provider: 'authentik',
+        subject: 'owner',
+        email: 'owner@example.com',
+        username: 'owner',
+      },
+      settings: {},
+    }));
+  });
+  afterEach(() => mock.restoreAll());
+
+  it('rejects configuration mutations before nested handlers execute', async () => {
+    for (const [method, endpoint] of [
+      ['post', '/settings/main'],
+      ['post', '/settings/network'],
+      ['post', '/settings/initialize'],
+      ['post', '/settings/main/regenerate'],
+      ['post', '/settings/radarr'],
+      ['put', '/settings/radarr/1'],
+      ['delete', '/settings/sonarr/1'],
+      ['post', '/settings/notifications/email'],
+      ['put', '/settings/jellyfin/library/movies'],
+    ] as const) {
+      const response = await request(app)[method](endpoint).send({});
+      assert.equal(response.status, 403, `${method} ${endpoint}`);
+    }
+  });
+
+  it('does not disable reading settings', async () => {
+    assert.equal((await request(app).get('/settings/main')).status, 200);
+  });
+
+  it('rejects alternate linking and unlinking identities', async () => {
+    for (const [method, endpoint] of [
+      ['post', '/linked-accounts/plex'],
+      ['post', '/linked-accounts/jellyfin'],
+      ['post', '/linked-accounts/jellyfin/quickconnect'],
+      ['delete', '/linked-accounts/1'],
+    ] as const) {
+      assert.equal(
+        (await request(app)[method](`/user/1/settings${endpoint}`).send({}))
+          .status,
+        403
+      );
+    }
+  });
+});
