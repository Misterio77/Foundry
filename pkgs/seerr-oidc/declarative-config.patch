@@ -0,0 +1,31 @@
+import { Permission, permissionsFromClaim } from '@server/lib/permissions';
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+describe('permissionsFromClaim', () => {
+  it('combines named permissions, tolerating duplicates', () => {
+    assert.equal(
+      permissionsFromClaim(['REQUEST', 'MANAGE_USERS', 'REQUEST']),
+      Permission.REQUEST | Permission.MANAGE_USERS
+    );
+    assert.equal(permissionsFromClaim(['ADMIN']), Permission.ADMIN);
+    assert.equal(permissionsFromClaim([]), Permission.NONE);
+  });
+  for (const value of [
+    undefined,
+    null,
+    'ADMIN',
+    2,
+    {},
+    ['unknown'],
+    [2],
+    ['2'],
+    ['__proto__'],
+    ['constructor'],
+    ['REQUEST', 'typo'],
+  ]) {
+    it(`rejects invalid claim ${JSON.stringify(value)}`, () => {
+      assert.throws(() => permissionsFromClaim(value));
+    });
+  }
+});
