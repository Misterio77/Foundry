+const dvr = z
+  .object({
+    id: z.number().int().positive(),
+    name: z.string().min(1),
+    hostname: z.string().min(1),
+    port,
+    apiKey: requiredSecret,
+    useSsl: z.boolean().default(false),
+    baseUrl: z.string().optional(),
+    activeProfileId: z.number().int().positive(),
+    activeProfileName: z.string().min(1),
+    activeDirectory: z.string().min(1),
+    tags: z.array(z.number().int()).default([]),
+    is4k: z.boolean().default(false),
+    isDefault: z.boolean().default(false),
+    externalUrl: z.string().optional(),
+    syncEnabled: z.boolean().default(true),
+    preventSearch: z.boolean().default(false),
+    tagRequests: z.boolean().default(false),
+    overrideRule: z.array(z.number().int()).default([]),
+  })
+  .strict();
+const settingsSchema = z
+  .object({
+    main: z
+      .object({
+        applicationTitle: z.string(),
+        applicationUrl: z.url().startsWith('https://'),
+        cacheImages: z.boolean(),
+        defaultPermissions: z.number().int().nonnegative(),
+        defaultQuotas: z.object({ movie: quota, tv: quota }).strict(),
+        hideAvailable: z.boolean(),
+        hideBlocklisted: z.boolean(),
+        hideRequested: z.boolean(),
+        discoverRegion: z.string(),
+        streamingRegion: z.string(),
+        originalLanguage: z.string(),
+        blocklistRegion: z.string(),
+        blocklistLanguage: z.string(),
+        blocklistedTags: z.string(),
+        blocklistedTagsLimit: z.number().int().nonnegative(),
+        partialRequestsEnabled: z.boolean(),
+        enableSpecialEpisodes: z.boolean(),
+        locale: localeSchema,
