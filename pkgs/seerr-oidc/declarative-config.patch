+        forceIpv4First: z.boolean(),
+        trustProxy: z.boolean(),
+        apiRequestTimeout: z.number().int().positive(),
+        dnsCache: z
+          .object({
+            enabled: z.boolean(),
+            forceMinTtl: z.number().nonnegative().optional(),
+            forceMaxTtl: z.number().min(-1).optional(),
+          })
+          .strict(),
+        proxy: z
+          .object({
+            enabled: z.boolean(),
+            hostname: z.string(),
+            port,
+            useSsl: z.boolean(),
+            user: z.string(),
+            password: secretValue,
+            bypassFilter: z.string(),
+            bypassLocalAddresses: z.boolean(),
+          })
+          .strict(),
+      })
+      .strict()
+      .partial()
+      .optional(),
+    notifications: notificationsSchema.optional(),
+    jobs: jobsSchema.optional(),
+    metadataSettings: z
+      .object({ tv: z.enum(['tmdb', 'tvdb']), anime: z.enum(['tmdb', 'tvdb']) })
+      .strict()
+      .optional(),
