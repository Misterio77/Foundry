+
+export const permissionsFromClaim = (claim: unknown): number => {
+  if (!Array.isArray(claim)) {
+    throw new Error('Permissions claim must be an array of permission names');
+  }
+
+  return claim.reduce((permissions: number, name: unknown) => {
+    if (
+      typeof name !== 'string' ||
+      !Object.prototype.hasOwnProperty.call(Permission, name) ||
+      typeof Permission[name as keyof typeof Permission] !== 'number'
+    ) {
+      throw new Error('Unknown permission in OIDC claim');
+    }
+    return permissions | Permission[name as keyof typeof Permission];
+  }, Permission.NONE);
+};
 
