diff --git a/server/entity/OidcSessionRevocation.test.ts b/server/entity/OidcSessionRevocation.test.ts
new file mode 100644
index 0000000000..bbab6615cc
--- /dev/null
+++ b/server/entity/OidcSessionRevocation.test.ts
@@ -0,0 +1,95 @@
+import globalSource from '@server/datasource';
+import { OidcSessionRevocation } from '@server/entity/OidcSessionRevocation';
+import {
+  isOidcSessionRevoked,
+  recordOidcLogout,
+} from '@server/lib/oidcBackchannel';
+import { AddOidcSessionRevocation1793904000000 as PostgresMigration } from '@server/migration/postgres/1793904000000-AddOidcSessionRevocation';
+import { AddOidcSessionRevocation1793904000000 } from '@server/migration/sqlite/1793904000000-AddOidcSessionRevocation';
+import assert from 'node:assert/strict';
+import { it, mock } from 'node:test';
+import { DataSource } from 'typeorm';
+
+it(
+  'migrates PostgreSQL revocation storage and keeps replays monotonic',
+  { skip: !process.env.TEST_POSTGRES_SOCKET },
+  async () => {
+    const connection = await new DataSource({
+      type: 'postgres',
+      host: process.env.TEST_POSTGRES_SOCKET,
+      port: 55439,
+      username: process.env.USER,
+      database: 'postgres',
+      entities: [OidcSessionRevocation],
+    }).initialize();
+    const runner = connection.createQueryRunner();
+    const migration = new PostgresMigration();
+    const repository = mock.method(
+      globalSource,
+      'getRepository',
+      connection.getRepository.bind(connection)
+    );
+    try {
+      await migration.up(runner);
+      const info = {
+        providerSlug: 'test',
+        issuer: 'https://issuer.example',
+        clientId: 'test',
+        subject: 'test',
+        sid: 'sid',
+        issuedAt: 100,
+      };
+      assert.equal(await isOidcSessionRevoked(info), false);
+      await recordOidcLogout({ ...info, issuedAt: 200 });
+      await recordOidcLogout({ ...info, issuedAt: 150 });
+      assert.equal(await isOidcSessionRevoked(info), true);
+      assert.equal(
+        (await connection.getRepository(OidcSessionRevocation).find())[0]
+          .issuedAt,
+        200
+      );
+      await migration.down(runner);
+      assert.equal(await runner.hasTable('oidc_session_revocation'), false);
+    } finally {
+      repository.mock.restore();
+      await runner.release();
+      await connection.destroy();
+    }
+  }
+);
+
+it('migrates SQLite revocation storage up/down without changing existing sessions', async () => {
+  const connection = await new DataSource({
+    type: 'sqlite',
+    database: ':memory:',
+    entities: [OidcSessionRevocation],
+  }).initialize();
+  const runner = connection.createQueryRunner();
+  const migration = new AddOidcSessionRevocation1793904000000();
+  try {
+    await runner.query(
+      'CREATE TABLE session (id varchar PRIMARY KEY, json text)'
+    );
+    await runner.query("INSERT INTO session VALUES ('existing', '{}')");
+    await migration.up(runner);
+    const repository = connection.getRepository(OidcSessionRevocation);
+    await repository.save({ id: 'a'.repeat(64), issuedAt: 1793904000 });
+    assert.equal(
+      (await repository.findOneByOrFail({ id: 'a'.repeat(64) })).issuedAt,
+      1793904000
+    );
+    assert.equal(
+      (await runner.query('SELECT count(*) AS count FROM session'))[0].count,
+      1
+    );
+    await migration.down(runner);
+    assert.equal(await runner.hasTable('oidc_session_revocation'), false);
+    assert.equal(
+      (await runner.query('SELECT count(*) AS count FROM session'))[0].count,
+      1
+    );
+  } finally {
+    await runner.release();
+    await connection.destroy();
+  }
+});
