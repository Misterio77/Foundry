+        name: 'oidc_session_revocation',
+        columns: [
+          { name: 'id', type: 'varchar', length: '64', isPrimary: true },
+          { name: 'issuedAt', type: 'bigint' },
+        ],
+      })
+    );
+  }
+
+  public async down(queryRunner: QueryRunner): Promise<void> {
+    await queryRunner.dropTable('oidc_session_revocation');
+  }
+}
