diff --git a/server/routes/oidcBackchannel.test.ts b/server/routes/oidcBackchannel.test.ts
new file mode 100644
index 0000000000..623386fa41
--- /dev/null
+++ b/server/routes/oidcBackchannel.test.ts
@@ -0,0 +1,371 @@ function createApp(info?: OidcSessionInfo) {
+import csurf from '@dr.pogodin/csurf';
+import { getRepository } from '@server/datasource';
+import { OidcSessionRevocation } from '@server/entity/OidcSessionRevocation';
+import { Session } from '@server/entity/Session';
+import {
+  isOidcSessionRevoked,
+  recordOidcLogout,
+  type OidcSessionInfo,
+} from '@server/lib/oidcBackchannel';
+import { getSettings } from '@server/lib/settings';
+import { checkUser, isAuthenticated } from '@server/middleware/auth';
+import oidcBackchannelRoutes from '@server/routes/oidcBackchannel';
+import { setupTestDb } from '@server/test/db';
+import { TypeormStore } from 'connect-typeorm/out';
+import cookieParser from 'cookie-parser';
+import express from 'express';
+import session from 'express-session';
+import fetchMock from 'fetch-mock';
+import { SignJWT, exportJWK, generateKeyPair } from 'jose';
+import assert from 'node:assert/strict';
+import { afterEach, before, beforeEach, describe, it, mock } from 'node:test';
+import request from 'supertest';
+
+const issuer = 'https://backchannel.example.com';
+const eventName = 'http://schemas.openid.net/event/backchannel-logout';
+const now = () => Math.floor(Date.now() / 1000);
+const identity = (
+  overrides: Partial<OidcSessionInfo> = {}
+): OidcSessionInfo => ({
+  providerSlug: 'test',
+  issuer,
+  clientId: 'seerr',
+  subject: 'friend-sub',
+  sid: 'sid-a',
+  issuedAt: now() - 60,
+  ...overrides,
+});
+
+function createApp(info?: OidcSessionInfo) {
+  const app = express();
+  app.use(cookieParser('secret'));
+  app.use('/backchannel', oidcBackchannelRoutes);
+  app.use(
+    session({
+      secret: 'secret',
+      resave: false,
+      saveUninitialized: false,
+      store: new TypeormStore().connect(getRepository(Session)),
+    })
+  );
+  app.get('/test/login', (req, res) => {
+    req.session.userId = 1;
+    req.session.oidcSession = info;
+    res.status(204).end();
+  });
+  app.use(csurf({ cookie: true }));
+  app.use(checkUser);
+  app.get('/me', isAuthenticated(), (_req, res) => res.status(200).end());
+  app.post('/protected', (_req, res) => res.status(200).end());
+  app.use(
+    (
+      error: { status?: number; statusCode?: number },
+      _req: express.Request,
+      res: express.Response,
+      // Express requires all four arguments to recognize an error handler.
+      // eslint-disable-next-line @typescript-eslint/no-unused-vars
+      _next: express.NextFunction
+    ) => {
+      res.status(error.status ?? error.statusCode ?? 500).end();
+    }
+  );
+  return app;
+}
+
+setupTestDb();
+
+describe('OIDC back-channel logout', () => {
+  let privateKey: Awaited<ReturnType<typeof generateKeyPair>>['privateKey'];
+  let jwk: object;
+  const sign = async (overrides: Record<string, unknown> = {}) =>
+    new SignJWT({
+      iss: issuer,
+      aud: 'seerr',
+      iat: now(),
+      exp: now() + 120,
+      jti: 'logout-event',
+      sub: 'friend-sub',
+      sid: 'sid-a',
+      events: { [eventName]: {} },
+      ...overrides,
+    })
+      .setProtectedHeader({
+        alg: 'RS256',
+        kid: 'logout-test',
+        typ: 'logout+jwt',
+      })
+      .sign(privateKey);
+
+  before(async () => {
+    const pair = await generateKeyPair('RS256');
+    privateKey = pair.privateKey;
+    jwk = {
+      ...(await exportJWK(pair.publicKey)),
+      kid: 'logout-test',
+      alg: 'RS256',
+    };
+  });
+
+  beforeEach(() => {
+    getSettings().load({
+      oidc: {
+        providers: [
+          {
+            slug: 'test',
+            name: 'Test',
+            issuerUrl: issuer,
+            clientId: 'seerr',
+            clientSecret: 'secret',
+            backchannelLogout: true,
+          },
+        ],
+      },
+    });
+    fetchMock.mockGlobal();
+    fetchMock.get(`${issuer}/.well-known/openid-configuration`, {
+      issuer,
+      jwks_uri: `${issuer}/jwks`,
+      authorization_endpoint: `${issuer}/authorize`,
+      token_endpoint: `${issuer}/token`,
+      response_types_supported: ['code'],
+      subject_types_supported: ['public'],
+      id_token_signing_alg_values_supported: ['RS256'],
+    });
+    fetchMock.get(`${issuer}/jwks`, { keys: [jwk] });
+  });
+
+  afterEach(() => {
+    fetchMock.hardReset();
+    getSettings().reset();
+  });
+
+  it('accepts signed form POSTs without cookies or CSRF and revokes only the matching sid', async () => {
+    const app = createApp(identity());
+    const target = request.agent(app);
+    await target.get('/test/login');
+    const other = request.agent(createApp(identity({ sid: 'sid-b' })));
+    await other.get('/test/login');
+    assert.equal((await target.get('/me')).status, 200);
+    assert.equal((await target.post('/protected')).status, 403);
+    const response = await request(app)
+      .post('/backchannel/test')
+      .type('form')
+      .send({ logout_token: await sign() });
+    assert.equal(response.status, 200);
+    assert.equal(response.get('Cache-Control'), 'no-store');
+    assert.equal(response.get('Set-Cookie'), undefined);
+    assert.equal((await target.get('/me')).status, 403);
+    assert.equal((await other.get('/me')).status, 200);
+  });
+
+  it('supports sid-only events and leaves local sessions alone', async () => {
+    const app = createApp(identity());
+    const target = request.agent(app);
+    await target.get('/test/login');
+    const local = request.agent(createApp());
+    await local.get('/test/login');
+    assert.equal(
+      (
+        await request(app)
+          .post('/backchannel/test')
+          .type('form')
+          .send({ logout_token: await sign({ sub: undefined }) })
+      ).status,
+      200
+    );
+    assert.equal((await target.get('/me')).status, 403);
+    assert.equal((await local.get('/me')).status, 200);
+  });
+
+  it('requires both subject and sid to match when both are supplied', async () => {
+    await recordOidcLogout({ ...identity(), subject: 'other-sub' });
+    assert.equal(await isOidcSessionRevoked(identity()), false);
+  });
+
+  it('subject logout revokes all older sessions but not future logins or other identities', async () => {
+    const event = { ...identity(), sid: undefined, issuedAt: now() - 10 };
+    await recordOidcLogout(event);
+    assert.equal(await isOidcSessionRevoked(identity()), true);
+    assert.equal(await isOidcSessionRevoked(identity({ sid: 'sid-b' })), true);
+    assert.equal(
+      await isOidcSessionRevoked(identity({ issuedAt: now() })),
+      false
+    );
+    assert.equal(
+      await isOidcSessionRevoked(identity({ subject: 'other' })),
+      false
+    );
+    assert.equal(
+      await isOidcSessionRevoked(identity({ providerSlug: 'other' })),
+      false
+    );
+    assert.equal(
+      await isOidcSessionRevoked(
+        identity({ issuer: 'https://other.example.com' })
+      ),
+      false
+    );
+    assert.equal(
+      await isOidcSessionRevoked(identity({ clientId: 'other' })),
+      false
+    );
+    await recordOidcLogout({ ...event, issuedAt: now() - 100 });
+    assert.equal(await isOidcSessionRevoked(identity()), true);
+  });
+
+  it('persists revocation across new app instances and a stale session write', async () => {
+    const app = createApp(identity());
+    const agent = request.agent(app);
+    const login = await agent.get('/test/login');
+    const cookie = login
+      .get('Set-Cookie')!
+      .map((value) => value.split(';')[0])
+      .join('; ');
+    const saved = await getRepository(Session).findOneByOrFail({});
+    const token = await sign();
+    for (let i = 0; i < 2; i++) {
+      assert.equal(
+        (
+          await request(app)
+            .post('/backchannel/test')
+            .type('form')
+            .send({ logout_token: token })
+        ).status,
+        200
+      );
+    }
+    assert.equal(await getRepository(OidcSessionRevocation).count(), 1);
+    assert.equal((await agent.get('/me')).status, 403);
+    await getRepository(Session).delete(saved.id);
+    await getRepository(Session).save(saved);
+    assert.equal(
+      (await request(createApp(identity())).get('/me').set('Cookie', cookie))
+        .status,
+      403
+    );
+    assert.equal(await isOidcSessionRevoked(identity()), true);
+  });
+
+  for (const [name, overrides] of Object.entries({
+    'wrong issuer': { iss: 'https://other.example.com' },
+    'wrong audience': { aud: 'other' },
+    'expired token': { exp: now() - 60 },
+    'stale event': { iat: now() - 600 },
+    'future event': { iat: now() + 60 },
+    'missing expiry': { exp: undefined },
+    'missing jti': { jti: undefined },
+    'missing event': { events: {} },
+    'invalid event': { events: { [eventName]: [] } },
+    nonce: { nonce: 'forbidden' },
+    'missing identity': { sid: undefined, sub: undefined },
+    'empty sid': { sid: '' },
+    'invalid subject': { sub: 123 },
+  })) {
+    it(`rejects ${name} without recording revocation`, async () => {
+      const response = await request(createApp())
+        .post('/backchannel/test')
+        .type('form')
+        .send({ logout_token: await sign(overrides) });
+      assert.equal(response.status, 400);
+      assert.equal(await getRepository(OidcSessionRevocation).count(), 0);
+    });
+  }
+
+  it('fails closed when revocation storage is unavailable', async () => {
+    const repository = getRepository(OidcSessionRevocation);
+    const storage = mock.method(repository, 'createQueryBuilder', () => {
+      throw new Error('Database unavailable');
+    });
+    try {
+      const response = await request(createApp())
+        .post('/backchannel/test')
+        .type('form')
+        .send({ logout_token: await sign() });
+      assert.equal(response.status, 503);
+    } finally {
+      storage.mock.restore();
+    }
+    assert.equal(await repository.count(), 0);
+  });
+
+  it('rejects unsupported signature algorithms', async () => {
+    const token = await new SignJWT({
+      iss: issuer,
+      aud: 'seerr',
+      iat: now(),
+      exp: now() + 120,
+      jti: 'event',
+      sub: 'friend-sub',
+      events: { [eventName]: {} },
+    })
+      .setProtectedHeader({ alg: 'HS256' })
+      .sign(
+        new TextEncoder().encode('client-secret-must-not-authenticate-logout')
+      );
+    assert.equal(
+      (
+        await request(createApp())
+          .post('/backchannel/test')
+          .type('form')
+          .send({ logout_token: token })
+      ).status,
+      400
+    );
+    assert.equal(await getRepository(OidcSessionRevocation).count(), 0);
+  });
+
+  it('rejects missing tokens and unknown providers', async () => {
+    const app = createApp();
+    assert.equal(
+      (await request(app).post('/backchannel/test').type('form').send({}))
+        .status,
+      400
+    );
+    assert.equal(
+      (
+        await request(app)
+          .post('/backchannel/unknown')
+          .type('form')
+          .send({ logout_token: await sign() })
+      ).status,
+      400
+    );
+    assert.equal(await getRepository(OidcSessionRevocation).count(), 0);
+  });
+
+  it('rejects invalid signatures, duplicate token fields, and disabled providers', async () => {
+    const app = createApp();
+    const token = await sign();
+    const parts = token.split('.');
+    parts[2] = (parts[2][0] === 'A' ? 'B' : 'A') + parts[2].slice(1);
+    assert.equal(
+      (
+        await request(app)
+          .post('/backchannel/test')
+          .type('form')
+          .send({ logout_token: parts.join('.') })
+      ).status,
+      400
+    );
+    assert.equal(
+      (
+        await request(app)
+          .post('/backchannel/test')
+          .type('form')
+          .send({ logout_token: [token, token] })
+      ).status,
+      400
+    );
+    getSettings().oidc.providers[0].backchannelLogout = false;
+    assert.equal(
+      (
+        await request(app)
+          .post('/backchannel/test')
+          .type('form')
+          .send({ logout_token: token })
+      ).status,
+      400
+    );
+    assert.equal(await getRepository(OidcSessionRevocation).count(), 0);
+  });
+});
diff --git a/server/routes/oidcBackchannel.ts b/server/routes/oidcBackchannel.ts
new file mode 100644
index 0000000000..8084b9aac8
--- /dev/null
+++ b/server/routes/oidcBackchannel.ts
@@ -0,0 +1,45 @@
+import {
+  recordOidcLogout,
+  validateLogoutToken,
+} from '@server/lib/oidcBackchannel';
+import { getSettings } from '@server/lib/settings';
+import logger from '@server/logger';
+import express, { Router } from 'express';
+
+const router = Router();
+router.use((_req, res, next) => {
+  res.setHeader('Cache-Control', 'no-store');
+  next();
+});
+router.use(express.urlencoded({ extended: false, limit: '16kb' }));
+router.post('/:slug', async (req, res) => {
+  const provider = getSettings().oidc.providers.find(
+    (p) => p.slug === req.params.slug
+  );
+  const token: unknown = req.body?.logout_token;
+  if (!provider?.backchannelLogout || typeof token !== 'string' || !token) {
+    return res.status(400).json({ error: 'invalid_request' });
+  }
+  let event;
+  try {
+    event = await validateLogoutToken(provider, token);
+  } catch {
+    logger.warn('Rejected OIDC back-channel logout token', {
+      label: 'Auth',
+      provider: provider.slug,
+    });
+    return res.status(400).json({ error: 'invalid_request' });
+  }
+  try {
+    await recordOidcLogout(event);
+    return res.status(200).end();
+  } catch {
+    logger.error('Failed to persist OIDC session revocation', {
+      label: 'Auth',
+      provider: provider.slug,
+    });
+    return res.status(503).json({ error: 'temporarily_unavailable' });
+  }
+});
+
+export default router;
