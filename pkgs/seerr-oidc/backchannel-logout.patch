diff --git a/server/lib/oidcBackchannel.ts b/server/lib/oidcBackchannel.ts
new file mode 100644
index 0000000000..b64dbaccd9
--- /dev/null
+++ b/server/lib/oidcBackchannel.ts
@@ -0,0 +1,164 @@ function key(
+import { getRepository } from '@server/datasource';
+import { OidcSessionRevocation } from '@server/entity/OidcSessionRevocation';
+import type { OidcProvider } from '@server/lib/settings';
+import { createRemoteJWKSet, jwtVerify } from 'jose';
+import { createHash } from 'node:crypto';
+import * as openIdClient from 'openid-client';
+import { In } from 'typeorm';
+
+export interface OidcSessionInfo {
+  providerSlug: string;
+  issuer: string;
+  clientId: string;
+  subject: string;
+  sid?: string;
+  issuedAt: number;
+}
+
+interface LogoutEvent extends Omit<OidcSessionInfo, 'subject'> {
+  subject?: string;
+}
+
+const eventName = 'http://schemas.openid.net/event/backchannel-logout';
+const keySets = new Map<string, ReturnType<typeof createRemoteJWKSet>>();
+const algorithms = [
+  'RS256',
+  'RS384',
+  'RS512',
+  'PS256',
+  'PS384',
+  'PS512',
+  'ES256',
+  'ES384',
+  'ES512',
+  'EdDSA',
+];
+
+function key(
+  context: Pick<OidcSessionInfo, 'providerSlug' | 'issuer' | 'clientId'>,
+  kind: string,
+  ...values: string[]
+): string {
+  return createHash('sha256')
+    .update(
+      JSON.stringify([
+        context.providerSlug,
+        context.issuer,
+        context.clientId,
+        kind,
+        ...values,
+      ])
+    )
+    .digest('hex');
+}
+
+export async function validateLogoutToken(
+  provider: OidcProvider,
+  token: string
+): Promise<LogoutEvent> {
+  const allowInsecure = process.env.OIDC_ALLOW_INSECURE === 'true';
+  const config = await openIdClient.discovery(
+    new URL(provider.issuerUrl),
+    provider.clientId,
+    provider.clientSecret,
+    undefined,
+    {
+      timeout: 3,
+      execute: allowInsecure ? [openIdClient.allowInsecureRequests] : [],
+    }
+  );
+  const metadata = config.serverMetadata();
+  const jwksUrl = new URL(metadata.jwks_uri!);
+  if (
+    (jwksUrl.protocol !== 'https:' &&
+      !(allowInsecure && jwksUrl.protocol === 'http:')) ||
+    jwksUrl.username ||
+    jwksUrl.password
+  ) {
+    throw new Error('Invalid JWKS endpoint');
+  }
+  let keys = keySets.get(jwksUrl.href);
+  if (!keys) {
+    keys = createRemoteJWKSet(jwksUrl, {
+      timeoutDuration: 3000,
+      cacheMaxAge: 300000,
+    });
+    keySets.set(jwksUrl.href, keys);
+  }
+  const { payload } = await jwtVerify(token, keys, {
+    issuer: metadata.issuer,
+    audience: provider.clientId,
+    algorithms: algorithms.filter((alg) =>
+      metadata.id_token_signing_alg_values_supported?.includes(alg)
+    ),
+    requiredClaims: ['iss', 'aud', 'iat', 'exp', 'jti', 'events'],
+    maxTokenAge: 300,
+    clockTolerance: 5,
+  });
+  const events = payload.events;
+  const logout =
+    events && typeof events === 'object' && !Array.isArray(events)
+      ? (events as Record<string, unknown>)[eventName]
+      : undefined;
+  const nonempty = (value: unknown): value is string =>
+    typeof value === 'string' && value.length > 0;
+  if (
+    !logout ||
+    typeof logout !== 'object' ||
+    Array.isArray(logout) ||
+    'nonce' in payload ||
+    !nonempty(payload.jti) ||
+    !Number.isSafeInteger(payload.iat) ||
+    payload.iat! < 0 ||
+    (payload.sub !== undefined && !nonempty(payload.sub)) ||
+    (payload.sid !== undefined && !nonempty(payload.sid)) ||
+    (!nonempty(payload.sub) && !nonempty(payload.sid))
+  ) {
+    throw new Error('Invalid logout claims');
+  }
+  return {
+    providerSlug: provider.slug,
+    issuer: metadata.issuer,
+    clientId: provider.clientId,
+    subject: payload.sub,
+    sid: payload.sid as string | undefined,
+    issuedAt: payload.iat!,
+  };
+}
+
+export async function recordOidcLogout(event: LogoutEvent): Promise<void> {
+  const id = event.sid
+    ? event.subject
+      ? key(event, 'sid-sub', event.sid, event.subject)
+      : key(event, 'sid', event.sid)
+    : key(event, 'sub', event.subject!);
+  // Monotonic, idempotent markers make replay harmless and survive session-save races.
+  await getRepository(OidcSessionRevocation)
+    .createQueryBuilder('oidc_session_revocation')
+    .insert()
+    .values({ id, issuedAt: event.issuedAt })
+    .onConflict(
+      `("id") DO UPDATE SET "issuedAt" = CASE WHEN "oidc_session_revocation"."issuedAt" < EXCLUDED."issuedAt" THEN EXCLUDED."issuedAt" ELSE "oidc_session_revocation"."issuedAt" END`
+    )
+    .execute();
+}
+
+export async function isOidcSessionRevoked(
+  info?: OidcSessionInfo
+): Promise<boolean> {
+  if (!info) return false;
+  const subjectKey = key(info, 'sub', info.subject);
+  const ids = [subjectKey];
+  if (info.sid) {
+    ids.push(
+      key(info, 'sid', info.sid),
+      key(info, 'sid-sub', info.sid, info.subject)
+    );
+  }
+  const records = await getRepository(OidcSessionRevocation).findBy({
+    id: In(ids),
+  });
+  return records.some(
+    (record) => record.id !== subjectKey || info.issuedAt <= record.issuedAt
+  );
+}
