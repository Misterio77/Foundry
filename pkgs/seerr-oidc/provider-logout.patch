@@ -0,0 +1,111 @@
+import { getOidcLogoutUrl } from '@server/lib/oidcLogout';
+import { getSettings } from '@server/lib/settings';
+import fetchMock from 'fetch-mock';
+import assert from 'node:assert/strict';
+import { afterEach, beforeEach, describe, it } from 'node:test';
+
+const discoveryUrl = 'https://example.com/.well-known/openid-configuration';
+const metadata = {
+  issuer: 'https://example.com',
+  authorization_endpoint: 'https://example.com/authorize',
+  token_endpoint: 'https://example.com/token',
+  jwks_uri: 'https://example.com/jwks',
+  response_types_supported: ['code'],
+  subject_types_supported: ['public'],
+  id_token_signing_alg_values_supported: ['RS256'],
+};
+
+describe('OIDC logout discovery', () => {
+  let previousAllowInsecure: string | undefined;
+
+  beforeEach(() => {
+    previousAllowInsecure = process.env.OIDC_ALLOW_INSECURE;
+    delete process.env.OIDC_ALLOW_INSECURE;
+    getSettings().load({
+      oidc: {
+        providers: [
+          {
+            slug: 'test',
+            name: 'Test',
+            issuerUrl: 'https://example.com',
+            clientId: 'seerr',
+            clientSecret: 'secret',
+            logoutMode: 'provider',
+          },
+        ],
+      },
+    });
+    fetchMock.mockGlobal();
+  });
+
+  afterEach(() => {
+    fetchMock.hardReset();
+    getSettings().reset();
+    if (previousAllowInsecure === undefined) {
+      delete process.env.OIDC_ALLOW_INSECURE;
+    } else {
+      process.env.OIDC_ALLOW_INSECURE = previousAllowInsecure;
+    }
+  });
+
+  it('returns the bare endpoint without tokens or redirect parameters', async () => {
+    fetchMock.get(discoveryUrl, {
+      ...metadata,
+      end_session_endpoint: 'https://example.com/end-session/',
+    });
+    assert.equal(
+      await getOidcLogoutUrl('test'),
+      'https://example.com/end-session/'
+    );
+  });
+
+  it('does not discover providers for sessions without provenance', async () => {
+    assert.equal(await getOidcLogoutUrl(), undefined);
+    assert.equal(fetchMock.callHistory.calls().length, 0);
+  });
+
+  it('does not discover providers when provider logout is disabled', async () => {
+    getSettings().oidc.providers[0].logoutMode = 'local';
+    assert.equal(await getOidcLogoutUrl('test'), undefined);
+    assert.equal(fetchMock.callHistory.calls().length, 0);
+  });
+
+  it('falls back when discovery has no end-session endpoint', async () => {
+    fetchMock.get(discoveryUrl, metadata);
+    assert.equal(await getOidcLogoutUrl('test'), undefined);
+  });
+
+  it('falls back when discovery fails', async () => {
+    fetchMock.get(discoveryUrl, 503);
+    assert.equal(await getOidcLogoutUrl('test'), undefined);
+  });
+
+  it('bounds discovery even when the provider is slow', async () => {
+    fetchMock.get(discoveryUrl, metadata, { delay: 5000 });
+    assert.equal(await getOidcLogoutUrl('test'), undefined);
+  });
+
+  for (const endpoint of [
+    '/relative/logout',
+    'http://example.com/logout',
+    'javascript:alert(1)',
+    'https://user:password@example.com/logout',
+  ]) {
+    it(`rejects unsafe endpoint ${endpoint}`, async () => {
+      fetchMock.get(discoveryUrl, {
+        ...metadata,
+        end_session_endpoint: endpoint,
+      });
+      assert.equal(await getOidcLogoutUrl('test'), undefined);
+    });
+  }
+
+  it('supports HTTP endpoints only with the explicit insecure-development flag', async () => {
+    process.env.OIDC_ALLOW_INSECURE = 'true';
+    fetchMock.get(discoveryUrl, {
+      ...metadata,
+      end_session_endpoint: 'http://example.com/logout',
+    });
+    assert.equal(await getOidcLogoutUrl('test'), 'http://example.com/logout');
+  });
+});
diff --git a/server/lib/oidcLogout.ts b/server/lib/oidcLogout.ts
new file mode 100644
index 0000000000..83341b0101
--- /dev/null
+++ b/server/lib/oidcLogout.ts
@@ -0,0 +1,49 @@ export async function getOidcLogoutUrl(
+import { getSettings } from '@server/lib/settings';
+import logger from '@server/logger';
+import * as openIdClient from 'openid-client';
+
+export async function getOidcLogoutUrl(
+  providerSlug?: string
+): Promise<string | undefined> {
+  const provider = getSettings().oidc.providers.find(
+    (provider) => provider.slug === providerSlug
+  );
+  if (!provider || provider.logoutMode !== 'provider') {
+    return undefined;
+  }
+
+  try {
+    const allowInsecure = process.env.OIDC_ALLOW_INSECURE === 'true';
+    const config = await openIdClient.discovery(
+      new URL(provider.issuerUrl),
+      provider.clientId,
+      provider.clientSecret,
+      undefined,
+      {
+        timeout: 3,
+        execute: allowInsecure ? [openIdClient.allowInsecureRequests] : [],
+      }
+    );
+    const endpoint = config.serverMetadata().end_session_endpoint;
+    if (!endpoint) {
+      return undefined;
+    }
+    const url = new URL(endpoint);
+    if (
+      (url.protocol !== 'https:' &&
+        !(allowInsecure && url.protocol === 'http:')) ||
+      url.username ||
+      url.password
+    ) {
+      throw new Error('Invalid end-session endpoint');
+    }
+    // Leave the provider's logout choices visible; do not force global logout.
+    return url.href;
+  } catch {
+    logger.warn('OIDC provider logout unavailable; local logout completed', {
+      label: 'Auth',
+      provider: provider.slug,
+    });
+    return undefined;
+  }
+}
