+from hashlib import sha512
+from io import BytesIO
+from math import hypot, tau
+
+import pytest
+from PIL import Image
+
+from robohash import Robohash
+from robohash.background import CHROMA, LIGHTNESS, background_color, oklch_to_linear_srgb
+
+
+def test_palette_stays_in_srgb_gamut():
+    for step in range(3600):
+        channels = oklch_to_linear_srgb(LIGHTNESS, CHROMA, step / 3600 * tau)
+        assert all(0 <= channel <= 1 for channel in channels)
+
+
+def test_quantized_palette_keeps_lightness_and_chroma():
+    for seed in range(256):
+        rgb = background_color(sha512(str(seed).encode()).hexdigest())
+        channels = [channel / 255 for channel in rgb]
+        r, g, b = [
+            c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
+            for c in channels
+        ]
+        l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
+        m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
+        s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
+        lightness = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
+        a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
+        b = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
+        assert abs(lightness - LIGHTNESS) < 0.002
+        assert abs(hypot(a, b) - CHROMA) < 0.002
+
+
+def test_background_is_seeded_and_varies():
+    hashes = [sha512(seed.encode()).hexdigest() for seed in ("lucky", "gabriel", "kitten")]
+    colors = [background_color(seed_hash) for seed_hash in hashes]
+    assert len(set(colors)) == 3
+    assert colors == [background_color(seed_hash) for seed_hash in hashes]
+
+
+@pytest.mark.parametrize("format", ["png", "jpeg", "bmp", "webp"])
+def test_kitten_has_opaque_background(format):
+    avatar = Robohash("lucky")
+    avatar.assemble(roboset="set4", format=format, sizex=200, sizey=200)
+    assert avatar.img.mode == "RGB"
+    assert avatar.img.size == (200, 200)
+    assert avatar.img.getpixel((0, 0)) == background_color(avatar.hexdigest)
+    output = BytesIO()
+    avatar.img.save(output, format=format)
+    output.seek(0)
+    assert Image.open(output).convert("RGBA").getchannel("A").getextrema() == (255, 255)
+
+
+def test_extensions_keep_the_same_background():
+    assert background_color(Robohash("lucky.png").hexdigest) == background_color(
+        Robohash("lucky.jpg").hexdigest
+    )
