+from hashlib import sha256
+from math import cos, sin, tau
+
+
+LIGHTNESS = 0.90
+CHROMA = 0.045
+
+
+def oklch_to_linear_srgb(lightness, chroma, hue):
+    a = chroma * cos(hue)
+    b = chroma * sin(hue)
+    l = (lightness + 0.3963377774 * a + 0.2158037573 * b) ** 3
+    m = (lightness - 0.1055613458 * a - 0.0638541728 * b) ** 3
+    s = (lightness - 0.0894841775 * a - 1.2914855480 * b) ** 3
+    return (
+        4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
+    )
+
+
+def background_color(seed_hash):
+    # A separate digest domain leaves Robohash's part-selection slots untouched.
+    digest = sha256(f"background:{seed_hash}".encode("utf-8")).digest()
+    hue = int.from_bytes(digest[:8], "big") / 2**64 * tau
+    channels = oklch_to_linear_srgb(LIGHTNESS, CHROMA, hue)
+
+    def encode(channel):
+        channel = min(1.0, max(0.0, channel))
+        encoded = 12.92 * channel if channel <= 0.0031308 else 1.055 * channel ** (1 / 2.4) - 0.055
+        return round(encoded * 255)
+
+    return tuple(encode(channel) for channel in channels)
