+import { renderHook } from '@testing-library/react'
+import { useProfile } from '../use-profile'
+
+const mockProfileQuery = jest.fn()
+jest.mock('../../store/profile-api', () => ({
+  useGetUserProfileQuery: () => mockProfileQuery(),
+}))
+jest.mock('@/lib/redux/hooks', () => ({ useAppSelector: () => null }))
+
+describe('DAV collection management capability', () => {
+  it.each([undefined, false, true])(
+    'requires explicit permission (%s)',
+    (allowed) => {
+      mockProfileQuery.mockReturnValue({
+        data: {
+          mailboxes: [],
+          ui: {
+            SOGO_D_DAV_COLLECTION_MANAGEMENT: allowed,
+            SOGO_D_CONTACT_LIST_MANAGEMENT: allowed,
+          },
+        },
+      })
+      const { result } = renderHook(() => useProfile())
+      expect(result.current.davCollectionsReadOnly).toBe(allowed !== true)
+      expect(result.current.contactListsReadOnly).toBe(allowed !== true)
+    }
+  )
+
+  it.each([[], ['contact'], ['mail']].map((disabled) => ({ disabled })))(
+    'honors contact export restrictions $disabled',
+    ({ disabled }) => {
+      mockProfileQuery.mockReturnValue({
+        data: { mailboxes: [], ui: { SOGO_D_FOLDER_DISABLE_EXPORT: disabled } },
+      })
+      const { result } = renderHook(() => useProfile())
+      expect(result.current.canExportContacts).toBe(
+        !disabled.includes('contact')
+      )
+    }
+  )
+
+  it('fails closed while the profile is unavailable', () => {
+    mockProfileQuery.mockReturnValue({ data: undefined, isLoading: true })
+    const { result } = renderHook(() => useProfile())
+    expect(result.current.davCollectionsReadOnly).toBe(true)
+    expect(result.current.contactListsReadOnly).toBe(true)
+    expect(result.current.canExportContacts).toBe(false)
+  })
+})
