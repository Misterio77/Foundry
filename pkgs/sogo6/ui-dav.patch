+import { tasksApiEndpoints } from '../tasks-api'
+import { calendarsApiEndpoints } from '@/features/calendars/store/calendars-api'
+import { addressBooksApiEndpoints } from '@/features/address_books/store/address-books-api'
+
+jest.mock('@/lib/env-service', () => ({ isUsingFakeApi: () => false }))
+jest.mock('@/lib/redux/api/api-slice', () => {
+  const actual = jest.requireActual('@/lib/redux/api/api-slice')
+  const identity = (definition: unknown) => definition
+  return {
+    ...actual,
+    apiSlice: {
+      ...actual.apiSlice,
+      injectEndpoints: ({
+        endpoints,
+      }: {
+        endpoints: (builder: unknown) => unknown
+      }) => ({
+        endpoints: endpoints({ query: identity, mutation: identity }),
+      }),
+    },
+  }
+})
+
+type Query = {
+  query: (args: Record<string, unknown>) => {
+    headers?: Record<string, string>
+    body?: Record<string, unknown>
+  }
+}
+type QueryFn = { queryFn: (...args: unknown[]) => Promise<unknown> }
+
+it('carries the task snapshot version in the header, not the JSON body', () => {
+  const endpoint = tasksApiEndpoints.endpoints.updateTask as unknown as Query
+  const request = endpoint.query({
+    taskKey: 'task',
+    body: { title: 'Edited', etag: '"old"' },
+  })
+  expect(request.headers).toEqual({ 'If-Match': '"old"' })
+  expect(request.body).toEqual({ title: 'Edited' })
+  expect(
+    endpoint.query({ taskKey: 'task', body: { title: 'No version' } }).headers
+  ).toBeUndefined()
+})
+
+it('carries the event snapshot version without changing recurrence fields', () => {
+  const endpoint = calendarsApiEndpoints.endpoints
+    .updateCalendarEvent as unknown as Query
+  const request = endpoint.query({
+    eventKey: 'event',
+    body: { title: 'Edited', etag: '"old"', recurrence_range: 'ALL' },
+  })
+  expect(request.headers).toEqual({ 'If-Match': '"old"' })
+  expect(request.body).toEqual({ title: 'Edited', recurrence_range: 'ALL' })
+})
+
+it('carries task and event delete-dialog versions', () => {
+  const task = tasksApiEndpoints.endpoints.deleteTask as unknown as Query
+  const event = calendarsApiEndpoints.endpoints
+    .deleteCalendarEvent as unknown as Query
+  expect(task.query({ taskKey: 'task', etag: '"old"' }).headers).toEqual({
+    'If-Match': '"old"',
+  })
+  expect(event.query({ eventKey: 'event', etag: '"old"' }).headers).toEqual({
+    'If-Match': '"old"',
+  })
+})
+
+it('does not fetch a newer contact version before submitting an old form', async () => {
+  const endpoint = addressBooksApiEndpoints.endpoints
+    .updateVCard as unknown as QueryFn
+  const baseQuery = jest
+    .fn()
+    .mockResolvedValue({
+      data: { key: 'contact', display_name: 'Fixture', etag: '"new"' },
+    })
+  await endpoint.queryFn(
+    {
+      book_id: 'book',
+      id: 'contact',
+      etag: '"old"',
+      patchBody: { note: 'Edited' },
+    },
+    {},
+    {},
+    baseQuery
+  )
+  expect(baseQuery).toHaveBeenCalledTimes(1)
+  expect(baseQuery).toHaveBeenCalledWith({
+    url: 'addressbooks/book/contacts/contact',
+    method: 'PATCH',
+    headers: { 'If-Match': '"old"' },
+    body: { note: 'Edited' },
+  })
+})
+
+it('carries the contact delete-dialog version', async () => {
+  const endpoint = addressBooksApiEndpoints.endpoints
+    .deleteVCardFromAddressBook as unknown as QueryFn
+  const baseQuery = jest.fn().mockResolvedValue({ data: undefined })
+  await endpoint.queryFn(
+    { id: 'book', vCardId: 'contact', etag: '"old"' },
+    {},
+    {},
+    baseQuery
+  )
+  expect(baseQuery).toHaveBeenCalledWith({
+    url: 'addressbooks/book/contacts/contact',
+    method: 'DELETE',
+    headers: { 'If-Match': '"old"' },
+  })
+})
