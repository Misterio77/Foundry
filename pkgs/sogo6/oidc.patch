+"""Encrypted, session-scoped refresh rotation with fail-closed crash recovery."""
+import json
+import time
+from http import HTTPStatus
+
+from redis.exceptions import RedisError, LockError
+from app.auth.User import User
+from app.service import sogo_cache
+from app.utils import constants as cs
+from app.utils.errors import E
+from app.utils.exceptions import RequestException
+
+UNAVAILABLE = E('S999503', 'Session refresh temporarily unavailable', HTTPStatus.SERVICE_UNAVAILABLE)
+PENDING = 'oidc_refresh_pending'
+MARK = '''
+if redis.call('HGET', KEYS[1], ARGV[1]) ~= ARGV[2] or redis.call('TTL', KEYS[1]) <= 0 then return 0 end
+if redis.call('HEXISTS', KEYS[1], ARGV[3]) == 1 then return 0 end
+redis.call('HSET', KEYS[1], ARGV[3], '1')
+return 1
+'''
+COMMIT = '''
+if redis.call('HGET', KEYS[1], ARGV[1]) ~= ARGV[2] or redis.call('TTL', KEYS[1]) <= 0 then return 0 end
+if redis.call('HGET', KEYS[1], ARGV[3]) ~= '1' then return 0 end
+redis.call('HSET', KEYS[1], ARGV[1], ARGV[4])
+redis.call('HDEL', KEYS[1], ARGV[3])
+redis.call('HINCRBY', KEYS[1], 'oidc_refresh_count', 1)
+redis.call('HSET', KEYS[1], 'oidc_refreshed_at', ARGV[5])
+return 1
+'''
+READ = "return {redis.call('HGET', KEYS[1], ARGV[1]), redis.call('HGET', KEYS[1], ARGV[2])}"
+
+
+def ensure_access(user, provider):
+    key = getattr(user, '_session_redis_key', None)
+    fernet = getattr(user, '_session_fernet', None)
+    if not key or fernet is None:
+        return False
+    cache = sogo_cache()
+    lock = None
+    locked = False
+
+    def load():
+        raw, pending = cache.redis.eval(READ, 1, key, cs.SESSION_SENSITIVE, PENDING)
+        if not raw:
+            return None, None, None
+        data = json.loads(fernet.decrypt(raw))
+        canonical = User.init_from_user_session(data)
+        if canonical.uid != user.uid or canonical.auth_kind != 'openid':
+            return None, None, None
+        if pending:
+            # An abandoned attempt may have spent the rotating token. Never retry it.
+            invalidate(canonical)
+            return None, None, None
+        return canonical, data, raw
+
+    def invalidate(canonical):
+        cache.revoke_user_sessions_by_key([key])
+        provider.revoke_session_tokens(canonical.password, canonical.oidc)
+
+    def check(canonical):
+        try:
+            return provider.check_access_token(canonical.password)
+        except RequestException as exc:
+            raise RequestException(error=UNAVAILABLE) from exc
+
+    def adopt(canonical):
+        user.password = canonical.password
+        user.oidc = canonical.oidc
+
+    try:
+        # Only read pending under the lock: another worker may still be completing its attempt.
+        lock = cache.redis.lock('oidc_refresh_lock:' + key, timeout=120, blocking_timeout=10)
+        locked = lock.acquire(blocking=True)
+        if not locked:
+            raise RequestException(error=UNAVAILABLE)
+        canonical, data, raw = load()
+        if canonical is None:
+            return False
+        now = time.time()
+        expires = canonical.oidc.get('access_expires_at', 0)
+        valid = check(canonical)
+        if not valid and now < expires:
+            # Revocation is not expiration. Do not use refresh to resurrect an early-revoked token.
+            invalidate(canonical)
+            return False
+        if expires > now + 45 or not canonical.oidc.get('refresh_token'):
+            if valid:
+                adopt(canonical)
+            return valid
+        if not cache.redis.eval(MARK, 1, key, cs.SESSION_SENSITIVE, raw, PENDING):
+            return False
+        new_access = None
+        new_oidc = None
+        try:
+            new_access, new_oidc = provider.refresh_session_tokens(canonical)
+            data[cs.USER_PWD] = new_access
+            data['oidc'] = new_oidc
+            encrypted = fernet.encrypt(json.dumps(data).encode())
+            committed = cache.redis.eval(COMMIT, 1, key, cs.SESSION_SENSITIVE, raw,
+                                         PENDING, encrypted, int(time.time()))
+            if not committed:
+                # Logout/expiry won the race. Revoke the newly issued credentials too.
+                provider.revoke_session_tokens(new_access, new_oidc)
+                return False
+        except Exception:
+            if new_access is not None:
+                provider.revoke_session_tokens(new_access, new_oidc)
+            # Unknown HTTP outcome, worker interruption marker, or failed persistence means re-login.
+            # If Redis is down, the marker remains and the next request fails closed.
+            invalidate(canonical)
+            return False
+        user.password = new_access
+        user.oidc = new_oidc
+        return True
+    except RedisError as exc:
+        raise RequestException(error=UNAVAILABLE) from exc
+    finally:
+        if locked:
+            try:
+                lock.release()
+            except (RedisError, LockError):
+                pass
+        cache.close()
