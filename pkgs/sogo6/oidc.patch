+"""Short-lived, browser-bound exchange; never put a usable session voucher in a URL."""
+from hashlib import sha256
+from secrets import token_urlsafe, compare_digest
+
+from flask import session
+from app.service import sogo_cache
+from app.utils import errors as err
+from app.utils.exceptions import RequestException
+
+
+def issue(voucher):
+    binding = session.get('sogo_oidc_binding')
+    if not binding:
+        raise RequestException(error=err.ERROR_SSO_INVALID_STATE)
+    ticket = token_urlsafe(32)
+    cache = sogo_cache()
+    try:
+        cache.set('pilot_sso_ticket:' + ticket, {
+            'binding': sha256(binding.encode()).hexdigest(), 'voucher': voucher,
+        }, 60)
+    finally:
+        cache.close()
+    return ticket
+
+
+def redeem(ticket):
+    if not isinstance(ticket, str) or len(ticket) > 128:
+        raise RequestException(error=err.ERROR_SSO_INVALID_STATE)
+    binding = session.get('sogo_oidc_binding', '')
+    cache = sogo_cache()
+    try:
+        key = 'pilot_sso_ticket:' + ticket
+        value = cache.get(key, dict)
+        if not binding or not isinstance(value, dict) or not compare_digest(
+            value.get('binding', ''), sha256(binding.encode()).hexdigest()
+        ):
+            raise RequestException(error=err.ERROR_SSO_INVALID_STATE)
+        value = cache.pop(key, dict)
+        if not value:
+            raise RequestException(error=err.ERROR_SSO_INVALID_STATE)
+        return value['voucher']
+    finally:
+        cache.close()
