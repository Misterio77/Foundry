+from urllib.parse import urlsplit
+
+
+def oidc_picture(value):
+    """The pilot only renders public Foundry avatar URLs; it never proxies arbitrary URLs."""
+    if not isinstance(value, str) or len(value) > 2048 or any(ord(c) <= 32 or ord(c) == 127 for c in value):
+        return None
+    try:
+        url = urlsplit(value)
+    except ValueError:
+        return None
+    if (url.scheme != 'https' or url.netloc != 'avatars.m7.rs'
+            or not url.path.startswith('/') or url.query or url.fragment):
+        return None
+    return value
