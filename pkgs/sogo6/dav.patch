+    'nickname':'NICKNAME','organization':'ORG','department':'ORG','job_title':'TITLE','role':'ROLE',
+    'emails':'EMAIL','phones':'TEL','addresses':'ADR','urls':'URL','impp':'IMPP','photos':'PHOTO',
+    'categories':'CATEGORIES','birthday':'BDAY','birthday_yearless':'BDAY',
+    'anniversary':'ANNIVERSARY','anniversary_yearless':'ANNIVERSARY','geo':'GEO','note':'NOTE',
+    'public_key':'KEY','sound':'SOUND','timezone':'TZ',
+}
+MULTI={'EMAIL','TEL','ADR','URL','IMPP','PHOTO'}
+
+def discover(uid):
+    if not active(uid): return None
+    if hasattr(g,'pilot_carddav_sources'): return g.pilot_carddav_sources
+    response=request('PROPFIND',HOME,headers={'Depth':'1','Content-Type':'application/xml'},
+        data='<d:propfind xmlns:d="DAV:"><d:prop><d:resourcetype/><d:displayname/></d:prop></d:propfind>')
