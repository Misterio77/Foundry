+class CalendarSourceLiveTasks(CalendarSourceDavPilot):
+    collection = COLLECTIONS['tasks']
+    def request(self, method, url, **kwargs):
+        return request(method, url, **kwargs)
+
+class CalendarSourceLiveEvents(CalendarSourceDavEventsPilot):
+    collection = COLLECTIONS['events']
+    def request(self, method, url, **kwargs):
+        return request(method, url, **kwargs)
+
+    @staticmethod
+    def _simple(event):
+        if (event.component_type != ComponentType.EVENT or event.recurrence_rule or event.recurrence_id
+                or event.attendees or event.all_day or event.require_date_end <= event.require_date_start):
+            raise RequestException(error=ERROR_CALENDAR_NOT_SUPPORTED)
+
+    def get_event(self, key):
+        event = super().get_event(key)
+        if event: self._seen[event.require_uid] = event
+        return event
+
+    def get_master_event_by_uid(self, uid):
+        event = super().get_master_event_by_uid(uid)
+        if event: self._seen[event.require_uid] = event
+        return event
+
+    def insert_event(self, event):
+        if event.recurrence_id is not None:
+            return super().insert_event(event)
+        self._simple(event)
+        event.uid = event.uid or str(uuid4())
+        event.dtstamp = datetime.now(timezone.utc)
+        data = CalEventSerializerIcal().serialize(event).encode()
+        href = self.collection + str(uuid4()) + '.ics'
+        self.request('PUT', href, data=data, headers={'If-None-Match':'*','Content-Type':'text/calendar'})
+        saved = self.request('GET', href)
+        return self._decode_events(saved.content, href, saved.headers.get('ETag'))[0]
+
+    def update_event(self, event):
+        if event.recurrence_id is not None:
+            return super().update_event(event)
+        self._simple(event)
+        if not isinstance(event, DavEvent):
+            raise RequestException(error=ERROR_CALENDAR_NOT_SUPPORTED)
+        originals = self._decode_events(event.dav_document,event.dav_href,event.dav_etag)
+        if len(originals)!=1:
+            raise RequestException(error=ERROR_CALENDAR_NOT_SUPPORTED)
+        self._simple(originals[0])
+        changed = {f.name for f in fields(CalEvent) if getattr(event,f.name)!=getattr(originals[0],f.name)}
+        if changed - EVENT_PROPERTIES.keys() - {'sequence'}:
+            raise RequestException(error=ERROR_CALENDAR_NOT_SUPPORTED)
+        if not changed: return
+        document=Calendar.from_ical(event.dav_document)
+        component=document.walk('VEVENT')[0]
+        generated=CalEventSerializerIcal().to_vevent(event)
+        for field in changed & EVENT_PROPERTIES.keys():
+            prop=EVENT_PROPERTIES[field];component.pop(prop,None)
+            if prop in generated: component[prop]=deepcopy(generated[prop])
+        if 'date_end' in changed: component.pop('DURATION',None)
+        self._touch(component)
+        data=document.to_ical()
+        response=self.request('PUT',event.dav_href,data=data,headers={'If-Match':event.dav_etag,'Content-Type':'text/calendar'})
+        event.dav_document=data;event.dav_etag=response.headers.get('ETag','')
+
+    def delete_event(self, uid):
+        event=self._seen.get(uid)
+        if event is None:
+            raise RequestException(error=ERROR_CALENDAR_NOT_SUPPORTED)
+        self._simple(event)
+        self.request('DELETE',event.dav_href,headers={'If-Match':event.dav_etag})
+
+    def process_scoped_update(self, original, event_update):
+        if not original.recurrence_rule and original.recurrence_id is None:
+            return None
+        return super().process_scoped_update(original,event_update)
