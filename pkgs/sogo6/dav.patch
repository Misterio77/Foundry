+"""Read-only single-user pilot against production DAV using the current OIDC token."""
+from datetime import datetime
+from urllib.parse import urljoin, urlsplit
+from uuid import uuid5, NAMESPACE_URL
+import xml.etree.ElementTree as ET
+
+from flask import g, has_request_context
+import requests
+from icalendar import Calendar
+
+from app.module.calendar.model.CalCalendar import CalCalendar
+from app.module.calendar.model.enums.CalendarSourceType import CalendarSourceType
+from app.module.calendar.model.enums.ComponentType import ComponentType
+from app.module.calendar.serializer.CalEventDeserializerIcal import CalEventDeserializerIcal
+from app.module.calendar.source.CalendarSource import CalendarSource
+from app.utils import errors as err
+from app.utils.exceptions import RequestException
+
+ROOT = 'https://dav.m7.rs/'
+D = '{DAV:}'
+C = '{urn:ietf:params:xml:ns:caldav}'
+
+
+def active(uid):
+    return (has_request_context() and getattr(g, 'user', None) is not None
+            and g.user.uid == uid == 'hi@m7.rs' and g.user.auth_kind == 'openid')
+
+
+def request(method, url, body, depth):
+    if method not in {'PROPFIND', 'REPORT'} or urlsplit(url).netloc != 'dav.m7.rs' or urlsplit(url).scheme != 'https':
+        raise RequestException(error=err.ERROR_CALENDAR_NOT_SUPPORTED)
+    try:
+        with requests.request(method, url, data=body, headers={
+            'Authorization':'Bearer '+g.user.password, 'Depth':str(depth), 'Content-Type':'application/xml',
+        }, timeout=20, allow_redirects=False, stream=True) as response:
+            if response.status_code != 207:
+                raise RequestException(error=err.ERROR_CALENDAR_NOT_SUPPORTED)
+            chunks = []
+            size = 0
+            for chunk in response.iter_content(65536):
+                size += len(chunk)
+                if size > 16 * 1024 * 1024:
+                    raise RequestException(error=err.ERROR_CALENDAR_NOT_SUPPORTED)
+                chunks.append(chunk)
+            return ET.fromstring(b''.join(chunks))
+    except requests.RequestException as exc:
+        raise RequestException(error=err.ERROR_CALENDAR_NOT_SUPPORTED) from exc
+
+
+def discover(uid):
+    if not active(uid):
+        return None
+    if hasattr(g, 'pilot_dav_sources'):
+        return g.pilot_dav_sources
+    root = request('PROPFIND', ROOT, b'<d:propfind xmlns:d="DAV:"><d:prop><d:current-user-principal/></d:prop></d:propfind>', 0)
+    href = root.find('.//'+D+'current-user-principal/'+D+'href')
+    if href is None or not href.text:
+        raise RequestException(error=err.ERROR_CALENDAR_NOT_SUPPORTED)
+    home = urljoin(ROOT, href.text)
+    root = request('PROPFIND', home, b'<d:propfind xmlns:d="DAV:"><d:prop><d:resourcetype/><d:displayname/></d:prop></d:propfind>', 1)
+    sources = []
+    for item in root.findall(D+'response'):
+        prop = item.find('.//'+D+'prop')
+        if prop is None or prop.find('.//'+C+'calendar') is None:
+            continue
+        url = urljoin(ROOT, item.findtext(D+'href'))
+        name = prop.findtext(D+'displayname') or urlsplit(url).path.rstrip('/').split('/')[-1]
+        cal = CalCalendar(user_uid=uid, name=name, key=str(uuid5(NAMESPACE_URL, url)),
+                          source_type=CalendarSourceType.ICS, timezone='America/Sao_Paulo')
+        from app.module.auth.PilotDavAccess import writable
+        if writable(url, 'tasks'):
+            from app.module.calendar.source.CalendarSourceLiveWritable import CalendarSourceLiveTasks
+            cal.source_type = CalendarSourceType.LOCAL
+            sources.append(CalendarSourceLiveTasks(cal))
+        elif writable(url, 'events'):
+            from app.module.calendar.source.CalendarSourceLiveWritable import CalendarSourceLiveEvents
+            cal.source_type = CalendarSourceType.LOCAL
+            sources.append(CalendarSourceLiveEvents(cal))
+        else:
+            sources.append(CalendarSourceLiveDav(cal, url))
+    g.pilot_dav_sources = sources
+    return sources
+
+
+class CalendarSourceLiveDav(CalendarSource):
+    def __init__(self, calendar, url):
+        super().__init__(calendar)
+        self.url = url
+        self._loaded = None
+
+    def _resources(self):
+        if self._loaded is not None:
+            return self._loaded
+        body = b'<c:calendar-query xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav"><d:prop><c:calendar-data/></d:prop><c:filter><c:comp-filter name="VCALENDAR"/></c:filter></c:calendar-query>'
+        root = request('REPORT', self.url, body, 1)
+        result = []
+        parser = CalEventDeserializerIcal()
+        for item in root.findall(D+'response'):
+            data = item.findtext('.//'+C+'calendar-data')
+            if not data:
+                continue
+            href = urljoin(ROOT, item.findtext(D+'href'))
+            document = Calendar.from_ical(data)
+            for component in document.walk():
+                if component.name not in {'VEVENT', 'VTODO'}:
+                    continue
+                event = parser.deserialize_vevent(component) if component.name == 'VEVENT' else parser.deserialize_vtodo(component)
+                start = component.get('DTSTART')
+                if start is not None and isinstance(start.dt, datetime) and start.dt.tzinfo is not None:
+                    event.date_start = start.dt
+                    if event.date_end is not None:
+                        event.date_end = event.date_end.astimezone(start.dt.tzinfo)
+                if component.name == 'VTODO' and 'DUE' not in component and 'DURATION' not in component:
+                    event.date_end = None
+                rid = event.recurrence_id.isoformat() if event.recurrence_id else 'master'
+                event.key = str(uuid5(NAMESPACE_URL, href+'#'+event.require_uid+'#'+rid))
+                event.calendar_key = self.calendar.key
+                event.calendar_timezone = self.calendar.timezone
+                result.append(event)
+        self._loaded = result
+        return result
+
+    def _fetch_events(self, start, end, search=None):
+        return [e for e in self._resources() if e.component_type == ComponentType.EVENT]
+
+    def _fetch_tasks(self, start, end, search=None):
+        return [e for e in self._resources() if e.component_type == ComponentType.TASK]
+
+    def get_event(self, event_key):
+        return next((e for e in self._resources() if e.key == event_key), None)
+
+    def get_master_event_by_uid(self, uid):
+        return next((e for e in self._resources() if e.uid == uid and e.recurrence_id is None), None)
