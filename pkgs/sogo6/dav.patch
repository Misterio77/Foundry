+"""Production DAV transport; writes are fenced to three disposable validation collections."""
+from types import SimpleNamespace
+from urllib.parse import urlsplit, unquote
+from http import HTTPStatus
+from flask import g, has_request_context
+import requests
+from app.utils.errors import E
+from app.utils.exceptions import RequestException
+
+ROOT = 'https://dav.m7.rs/'
+HOME = ROOT + 'hi%40m7.rs/'
+COLLECTIONS = {kind: HOME + 'sogo6-validation-0ec52f81e1eb-' + kind + '/' for kind in ('events','tasks','contacts')}
+DENIED = E('S999403','DAV operation outside the validation scope',HTTPStatus.FORBIDDEN)
+CONFLICT = E('S999409','DAV resource changed; reload before retrying',HTTPStatus.CONFLICT)
+UNAVAILABLE = E('S999502','DAV request failed',HTTPStatus.BAD_GATEWAY)
+
+def active(uid):
+    return (has_request_context() and getattr(g,'user',None) is not None
+            and g.user.uid == uid == 'hi@m7.rs' and g.user.auth_kind == 'openid')
+
+def path(url):
+    p=urlsplit(url)
+    decoded=unquote(p.path)
+    if (p.scheme!='https' or p.netloc!='dav.m7.rs' or p.query or p.fragment
+            or not decoded.startswith('/') or '%' in decoded or '\\' in decoded
+            or any(ord(c)<32 for c in decoded) or any(c in ('.','..') for c in decoded.split('/'))):
+        raise RequestException(error=DENIED)
+    return decoded
+
+def writable(url, kind=None):
+    target=path(url)
+    return any(target==path(collection) for name,collection in COLLECTIONS.items() if kind is None or name==kind)
+
+def validate(method,url,headers):
+    target=path(url)
+    if method in ('GET','REPORT','PROPFIND'):
+        return
+    for kind,collection in COLLECTIONS.items():
+        root=path(collection)
+        suffix=target[len(root):] if target.startswith(root) else ''
+        if (suffix and '/' not in suffix and suffix.endswith('.vcf' if kind=='contacts' else '.ics')
+                and method in ('PUT','DELETE')):
+            etag=headers.get('If-Match')
+            if etag and etag!='*' and not etag.startswith('W/'):
+                return
+            if method=='PUT' and headers.get('If-None-Match')=='*':
+                return
+    raise RequestException(error=DENIED)
+
+def request(method,url,*,headers=None,data=None):
+    if not active(getattr(getattr(g,'user',None),'uid',None)):
+        raise RequestException(error=DENIED)
+    headers=dict(headers or {})
+    validate(method,url,headers)
+    headers['Authorization']='Bearer '+g.user.password
+    try:
+        with requests.request(method,url,headers=headers,data=data,timeout=20,allow_redirects=False,stream=True) as r:
+            if r.status_code==412:
+                raise RequestException(error=CONFLICT)
+            if r.status_code not in (200,201,204,207):
+                raise RequestException(error=UNAVAILABLE)
+            chunks=[]; size=0
+            for chunk in r.iter_content(65536):
+                size+=len(chunk)
+                if size>16*1024*1024:
+                    raise RequestException(error=UNAVAILABLE)
+                chunks.append(chunk)
+            return SimpleNamespace(status_code=r.status_code,content=b''.join(chunks),headers=r.headers)
+    except requests.RequestException as exc:
+        raise RequestException(error=UNAVAILABLE) from exc
