+        url=urljoin(ROOT,item.findtext(D+'href'))
+        book=CardAddressBook(user_uid=uid,name=prop.findtext(D+'displayname') or 'CardDAV',
+            key=str(uuid5(NAMESPACE_URL,url)),source_type=CardSourceType.CARDDAV,
+            is_default=writable(url,'contacts'))
