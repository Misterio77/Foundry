+def test_native_ui_serves_runtime_configuration_and_login():
+    executable = os.environ.get('SOGO_TEST_NATIVE_UI')
+    if not executable:
+        pytest.skip('Requires the built native UI')
+    with tempfile.TemporaryDirectory(prefix='sogo-ui-') as directory:
+        with socket.socket() as listener:
+            listener.bind(('127.0.0.1', 0))
+            port = listener.getsockname()[1]
+        env = {**os.environ, 'HOSTNAME': '127.0.0.1', 'PORT': str(port), 'REACT_APP_API_BASE_URL': '/api/user/v1', 'SSE_ENABLED': 'false'}
+        with open(Path(directory)/'ui.log', 'wb') as log:
+            process = subprocess.Popen([executable], cwd=directory, env=env, stdout=log, stderr=log)
+            try:
+                for _ in range(100):
+                    assert process.poll() is None, 'Native UI exited during startup'
+                    try:
+                        response = requests.get(f'http://127.0.0.1:{port}/env', timeout=2)
+                        if response.status_code == 200:
+                            break
+                    except requests.ConnectionError:
+                        pass
+                    time.sleep(.1)
+                else:
+                    pytest.fail('Native UI never became ready')
+                assert response.json()['REACT_APP_API_BASE_URL'] == '/api/user/v1'
+                assert response.json()['SSE_ENABLED'] is False
+                login = requests.get(f'http://127.0.0.1:{port}/en/auth/login', timeout=10)
+                assert login.status_code == 200 and 'text/html' in login.headers['Content-Type']
+            finally:
+                process.terminate()
+                process.wait(timeout=15)
+
