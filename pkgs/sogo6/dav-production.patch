+def test_native_api_start_restart_and_database_restore(deployment):
+    executable = os.environ.get('SOGO_TEST_NATIVE_API')
+    if not executable:
+        pytest.skip('Requires the built native API and isolated PostgreSQL/Redis binaries')
+    for command in ('initdb', 'pg_ctl', 'psql', 'createdb', 'dropdb', 'pg_dump', 'pg_restore', 'redis-server'):
+        assert shutil.which(command), command
+    with tempfile.TemporaryDirectory(prefix='sogo-runtime-') as directory:
+        root = Path(directory)
+        socket_dir = root/'socket'
+        socket_dir.mkdir()
+        pg = root/'postgres'
+        log = open(root/'process.log', 'wb')
+        redis = api = None
+        running_pg = False
+        def run(*args):
+            return subprocess.run(args, check=True, stdout=log, stderr=log)
+        def database(command, *args):
+            return run(command, '-h', str(socket_dir), '-U', 'postgres', *args)
+        try:
+            run('initdb', '-D', str(pg), '-U', 'postgres', '--auth=trust', '--no-locale')
+            run('pg_ctl', '-D', str(pg), '-l', str(root/'postgres.log'), '-o', f"-k {socket_dir} -c listen_addresses=''", '-w', 'start')
+            running_pg = True
+            database('psql', '-d', 'postgres', '-c', 'CREATE ROLE sogo6 LOGIN')
+            database('createdb', '-O', 'sogo6', 'sogo6')
+            redis = subprocess.Popen(['redis-server', '--port', '0', '--unixsocket', str(root/'redis.sock'), '--save', '', '--appendonly', 'no'], stdout=log, stderr=log)
+            for _ in range(100):
+                if (root/'redis.sock').exists():
+                    break
+                assert redis.poll() is None
+                time.sleep(.05)
+            domain = deployment['domainSettings']
+            domain['AUTH_SETTINGS']['SOGO_D_OPENID_CLIENT_SECRET'] = 'isolated-test-placeholder'
+            (root/'system.json').write_text(json.dumps({'settings': deployment['systemSettings']}))
+            (root/'domain.json').write_text(json.dumps({'settings': domain}))
+            with socket.socket() as listener:
+                listener.bind(('127.0.0.1', 0))
+                port = listener.getsockname()[1]
+            env = {**os.environ,
+                'SOGO_P_DB_HOST': str(socket_dir), 'SOGO_P_DB_USER': 'sogo6', 'SOGO_P_DB_PASS': '', 'SOGO_P_DB_NAME': 'sogo6',
+                'SOGO_P_REDIS_URL': f'unix://{root}/redis.sock?db=0',
+                'SOGO_P_VOUCHER_SECRET': 'v'*32,
+                'SOGO_AES_ENC_KEY': base64.b64encode(b'e'*32).decode(),
+                'SOGO_P_PUBLIC_BASE_URL': 'https://mail.m7.rs',
+                'SOGO_OIDC_LOGOUT_URL': 'https://auth.m7.rs/application/o/sogo/end-session/',
+                'SOGO_INIT_SYSTEM_SETTINGS_PATH': str(root/'system.json'),
+                'SOGO_INIT_DOMAIN_SETTINGS_PATH': str(root/'domain.json'),
+                'SOGO_FOUNDRY_AUTHORITATIVE_CONFIG': '1', 'SOGO_LOG_PATH': str(root/'api.log'),
+            }
+            env.pop('PYTHONPATH', None)
+            def start():
+                process = subprocess.Popen([executable, '--bind', f'127.0.0.1:{port}', '--workers', '1', '--access-logfile', '/dev/null', '--no-control-socket'], cwd=root, env=env, stdout=log, stderr=log)
+                try:
+                    for _ in range(200):
+                        assert process.poll() is None, 'Native API exited during startup'
+                        try:
+                            response = requests.get(f'http://127.0.0.1:{port}/api/user/v1/system', headers={'Host': 'mail.m7.rs'}, timeout=1)
+                            if response.status_code == 200:
+                                assert response.json()['error_code'] == 'S000000'
+                                return process
+                        except requests.ConnectionError:
+                            pass
+                        time.sleep(.1)
+                    pytest.fail('Native API never became healthy')
+                except BaseException:
+                    process.terminate()
+                    process.wait(timeout=15)
+                    raise
+            api = start()
+            api.terminate()
+            api.wait(timeout=15)
+            api = start()
+            api.terminate()
+            api.wait(timeout=15)
+            database('pg_dump', '-Fc', '-f', str(root/'backup.dump'), 'sogo6')
+            database('dropdb', 'sogo6')
+            database('createdb', '-O', 'sogo6', 'sogo6')
+            database('pg_restore', '-d', 'sogo6', str(root/'backup.dump'))
+            api = start()
+        finally:
+            if api is not None and api.poll() is None:
+                api.terminate()
+                api.wait(timeout=15)
+            if redis is not None:
+                redis.terminate()
+                redis.wait(timeout=10)
+            if running_pg:
+                run('pg_ctl', '-D', str(pg), '-m', 'immediate', '-w', 'stop')
+            log.close()
+            evidence = os.environ.get('SOGO_TEST_DIAGNOSTIC_DIR')
+            if evidence:
+                Path(evidence).mkdir(parents=True, exist_ok=True)
+                for file in root.glob('*.log'):
+                    shutil.copy2(file, Path(evidence)/file.name)
