+import os
+import sys
+from textwrap import indent
+from types import SimpleNamespace
+
+import pytest
+import yaml
+
+
+class Loader(yaml.SafeLoader):
+    pass
+
+
+def tagged(loader, tag, node):
+    if isinstance(node, yaml.ScalarNode):
+        return loader.construct_scalar(node)
+    return loader.construct_sequence(node)
+
+
+Loader.add_multi_constructor('!', tagged)
+with open(os.environ['SOGO_TEST_BLUEPRINT']) as source:
+    ENTRIES = yaml.load(source, Loader=Loader)['entries']
+
+
+def policy(name, request):
+    expression = next(e['attrs']['expression'] for e in ENTRIES if e.get('id') == name)
+    scope = {'request': request}
+    exec('def run():\n'+indent(expression, '    '), scope)
+    return scope['run']()
+
+
+@pytest.mark.parametrize('path,method,allowed', [
+    ('/application/o/sogo/end-session/', 'GET', True),
+    ('/application/o/sogo/end-session/', 'POST', True),
+    ('/application/o/sogo/end-session/', 'DELETE', False),
+    ('/application/o/sogo/end-session', 'GET', False),
+    ('/application/o/other/end-session/', 'GET', False),
+    ('/application/o/authorize/', 'GET', False),
+])
+def test_logout_exception_is_exact(path, method, allowed):
+    request = SimpleNamespace(http_request=SimpleNamespace(path=path, method=method), context={})
+    assert policy('pkce', request) is allowed
+
+
+@pytest.mark.parametrize('challenge,method,grant,allowed', [
+    ('a'*43, 'S256', 'authorization_code', True),
+    ('a'*43, 'plain', 'authorization_code', False),
+    ('a'*42, 'S256', 'authorization_code', False),
+    ('a'*43, 'S256', 'password', False),
+    (None, 'S256', 'authorization_code', False),
+])
+def test_authorization_requires_s256(challenge, method, grant, allowed):
+    request = SimpleNamespace(http_request=SimpleNamespace(path='/application/o/authorize/', method='GET'), context={
+        'oauth_code_challenge': challenge, 'oauth_code_challenge_method': method, 'oauth_grant_type': grant,
+    })
+    assert policy('pkce', request) is allowed
+
+
+@pytest.mark.parametrize('active,grants,allowed', [(True, {'mail', 'radicale'}, True), (True, {'mail'}, False), (True, {'radicale'}, False), (False, {'mail', 'radicale'}, False)])
+def test_access_requires_both_entitlements(active, grants, allowed, monkeypatch):
+    class Applications(list):
+        def count(self):
+            return len(self)
+    model = SimpleNamespace(objects=SimpleNamespace(filter=lambda **_: Applications(['mail', 'radicale'])))
+    monkeypatch.setitem(sys.modules, 'authentik.core.models', SimpleNamespace(Application=model))
+    user = SimpleNamespace(is_active=active, app_entitlements=lambda app: SimpleNamespace(
+        filter=lambda **_: SimpleNamespace(exists=lambda: app in grants)))
+    request = SimpleNamespace(user=user, http_request=SimpleNamespace(path='/application/o/authorize/', method='GET'))
+    assert policy('access', request) is allowed
+
+
+def test_provider_is_distinct_and_callback_is_exact():
+    provider = next(e['attrs'] for e in ENTRIES if e.get('id') == 'provider')
+    assert provider['client_id'] == 'sogo'
+    assert provider['client_type'] == 'confidential'
+    assert provider['client_secret'] == 'AUTHENTIK_SOGO_CLIENT_SECRET'
+    assert provider['grant_types'] == ['authorization_code', 'refresh_token']
+    assert provider['redirect_uris'] == [{'matching_mode': 'strict', 'url': 'https://mail.m7.rs/api/user/v1/auth/callback/openid/m7.rs', 'redirect_uri_type': 'authorization'}]
