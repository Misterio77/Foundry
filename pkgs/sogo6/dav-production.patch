+    assert checked['AUTH_SETTINGS']['SOGO_D_OPENID_EMAIL'] == 'mail_account'
+    assert checked['USER_SOURCE'] == {}
+    assert checked['MAIL_SETTINGS']['SOGO_D_IMAP_AUTH_MECH'] == 'xoauth2'
