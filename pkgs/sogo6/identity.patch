+"""Bind SOGo identity to validated OIDC claims, without a second user directory."""
+import os
+from urllib.parse import urlsplit
+
+from app.utils import errors as err
+from app.utils.exceptions import RequestException
+
+
+def public_origin():
+    value = os.environ["SOGO_P_PUBLIC_BASE_URL"]
+    url = urlsplit(value)
+    if (url.scheme != "https" or not url.hostname or url.username or url.password
+            or url.path not in ("", "/") or url.query or url.fragment):
+        raise ValueError("SOGO_P_PUBLIC_BASE_URL must be an HTTPS origin")
+    return value.rstrip("/")
+
+
+def logout_url():
+    value = os.environ["SOGO_OIDC_LOGOUT_URL"]
+    url = urlsplit(value)
+    if (url.scheme != "https" or not url.hostname or url.username or url.password
+            or url.query or url.fragment or not url.path.endswith("/end-session/")):
+        raise ValueError("SOGO_OIDC_LOGOUT_URL must be a fixed HTTPS end-session URL")
+    return value
+
+
+def display_name(claims, mailbox):
+    value = claims.get("name") or claims.get("preferred_username") or mailbox
+    if not isinstance(value, str) or not value.strip():
+        return mailbox
+    return "".join(c for c in value if ord(c) >= 32 and ord(c) != 127)[:256]
+
+
+def restore_identity(user):
+    mailbox = user.mail
+    if (user.auth_kind != "openid" or user.source_id != "oidc" or user.uid != mailbox
+            or not isinstance(mailbox, str) or mailbox.count("@") != 1
+            or not all(32 < ord(c) < 127 for c in mailbox)
+            or not all(mailbox.split("@"))
+            or mailbox.rsplit("@", 1)[1] != user.domain
+            or not isinstance(user.oidc.get("subject"), str) or not user.oidc["subject"]
+            or not user.oidc.get("issuer") or not user.oidc.get("client_id")):
+        return False
+    user.cn = display_name({"name": user.oidc.get("display_name")}, mailbox)
+    user.login_mail_server = mailbox
+    user.login_mail_outgoing = mailbox
+    user.login_mail_filtering = mailbox
+    user.authenticated = True
+    return True
+
+
+def bind_identity(user, identity):
+    if (identity.claims.get("mail_account") != identity.mail
+            or identity.claims.get("sub") != identity.oidc.get("subject")):
+        raise RequestException(error=err.ERROR_SSO_LOGIN_FAILED)
+    user.source_id = "oidc"
+    user.oidc = dict(identity.oidc)
+    user.oidc["display_name"] = display_name(identity.claims, identity.mail)
+    if not restore_identity(user):
+        raise RequestException(error=err.ERROR_SSO_LOGIN_FAILED)
